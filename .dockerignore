# What the image's build doesn't need. Git's history among it, so the build
# has no checkout to read as modified; the Dockerfile is given the commit.
.git/
.github/
.run/
.idea/
.claude/
tmp/
.air.toml
.gitignore
.release-please-manifest.json
release-please-config.json
renovate.json
*.db
*.db.bak-*
*.exe
*.md
web/node_modules
_artifacts
