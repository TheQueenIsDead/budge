{{ define "layout" }}

    <!doctype html>

    <head lang="en">
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
        <meta name="description" content="Budge, a personal finance dashboard">
        <meta name="theme-color" content="">
        <link rel="icon" href="{{ asset "/static/favicon.ico" }}">

        <title>Budge</title>

        <!-- Libraries are installed with pnpm and served by budge itself, from
             /static/vendor; see web/package.json. Nothing on the page comes
             from another site. -->

        <!-- Bootstrap -->
        <link rel="stylesheet" href="{{ asset "/static/vendor/bootstrap/bootstrap.min.css" }}">
        <script src="{{ asset "/static/vendor/bootstrap/bootstrap.bundle.min.js" }}"></script>
        <link rel="stylesheet" href="{{ asset "/static/vendor/bootstrap-icons/bootstrap-icons.min.css" }}">

        <!-- Inter, with a system stack behind it if the font does not load -->
        <link rel="stylesheet" href="{{ asset "/static/vendor/inter/inter.css" }}">

        <!-- Chart JS -->
        <script src="{{ asset "/static/vendor/chart.js/chart.umd.min.js" }}"></script>

        <!-- Budge -->
        <!-- Each asset URL carries a hash of the file, so a deploy is never
             rendered with a stylesheet cached from before it. -->
        <script defer src="{{ asset "/static/toast.js" }}"></script>
        <script defer src="{{ asset "/static/budget.js" }}"></script>
        <link rel="stylesheet" href="{{ asset "/static/colours.css" }}">
        <link rel="stylesheet" href="{{ asset "/static/styles.css" }}">
        <!-- Not deferred: inline chart code in the page body runs during parsing,
             which is before a deferred script would execute. -->
        <script src="{{ asset "/static/charts.js" }}"></script>
        <!-- The browser chrome takes the page ground. A meta tag cannot read a
             CSS variable, so it is copied across once the stylesheet is in. -->
        <script nonce="{{ nonce }}">
            document.querySelector('meta[name="theme-color"]').content =
                getComputedStyle(document.documentElement).getPropertyValue('--b-bg').trim();
        </script>

        <!-- HTMX -->
        <script src="{{ asset "/static/vendor/htmx/htmx.min.js" }}"></script>
        <script nonce="{{ nonce }}">
            // A swap marked "morph" updates what is on the page in place rather
            // than replacing it, with Alpine's own morph so Alpine components on
            // it carry on: only what changed is touched, so the page stays put
            // and the button pressed keeps its focus. Anything opened by hand
            // stays open, as the server only knows which one it opened.
            htmx.defineExtension('alpine-morph', {
                isInlineSwap: function (swapStyle) {
                    return swapStyle === 'morph';
                },
                handleSwap: function (swapStyle, target, fragment) {
                    if (swapStyle !== 'morph') {
                        return;
                    }
                    const next = fragment.nodeType === Node.DOCUMENT_FRAGMENT_NODE ? fragment.firstElementChild : fragment.outerHTML;
                    Alpine.morph(target, next, {
                        updating: function (el, toEl) {
                            if (el.tagName === 'DETAILS' && el.open) {
                                toEl.setAttribute('open', '');
                            }
                        },
                    });
                    return [target];
                },
            });
        </script>

        <!-- Alpine, for what a page shows changing as it is edited, before htmx
             saves it. -->
        <!-- The morph plugin goes first: Alpine's plugins register before it starts. -->
        <script defer src="{{ asset "/static/vendor/alpinejs/morph.min.js" }}"></script>
        <script defer src="{{ asset "/static/vendor/alpinejs/alpine.min.js" }}"></script>

        <script nonce="{{ nonce }}">
            htmx.config.useTemplateFragments = true
            htmx.config.scrollIntoViewOnBoost = false
            // Scripts that arrive in a swap are run with the page's nonce, which
            // the Content Security Policy allows, not the one in the response.
            htmx.config.inlineScriptNonce = {{ nonce }}
        </script>
    </head>

    <body hx-ext="alpine-morph">

        <!-- Top bar. Brand and settings on mobile, full navigation from md up. -->
        <nav class="b-navbar sticky-top">
            <div class="container d-flex align-items-center justify-content-between py-2">
                <a class="navbar-brand mb-0 me-0" href="/" hx-boost="true" hx-target="#main">Budge 🐦</a>

                <div class="d-none d-md-flex align-items-center gap-1" hx-boost="true" hx-target="#main">
                    <a class="b-nav-link" data-nav href="/">Dashboard</a>
                    <a class="b-nav-link" data-nav href="/insights">Insights</a>
                    <a class="b-nav-link" data-nav href="/transactions">Transactions</a>
                    <a class="b-nav-link" data-nav href="/timeline">Timeline</a>
                    <a class="b-nav-link" data-nav href="/portfolio">Portfolio</a>
                    <a class="b-nav-link" data-nav href="/budget">Budget</a>
                </div>

                <div class="d-flex align-items-center">
                    <!-- The bell sits over every page but opens a list rather than
                         a popover: a failure worth reporting is worth a page. -->
                    <a class="b-nav-link b-bell px-2" data-nav href="/notifications"
                       aria-label="Notifications" hx-boost="true" hx-target="#main">
                        <i class="bi bi-bell fs-5"></i>
                        <!-- hx-target is inherited, and this sits inside a link
                             targeting #main. Without pinning it to itself the
                             badge swaps its own response over the page body,
                             which blanks every page a moment after it loads. -->
                        <span id="notification-badge"
                              hx-get="/notifications/badge"
                              hx-trigger="load, notifications from:body"
                              hx-target="this"
                              hx-swap="innerHTML"></span>
                    </a>

                    <!-- The timeline does not earn a tab slot, so on mobile it
                         lives up here. -->
                    <a class="b-nav-link d-md-none px-2" data-nav href="/timeline"
                       aria-label="Timeline" hx-boost="true" hx-target="#main">
                        <i class="bi bi-clock-history fs-5"></i>
                    </a>

                    <!-- How budge itself is running, and how it is set up, sit
                         beside the bell at every size: they are about budge,
                         not about the money. -->
                    {{ if .admin }}
                        <a class="b-nav-link px-2" data-nav href="/admin"
                           aria-label="Admin" title="Admin" hx-boost="true" hx-target="#main">
                            <i class="bi bi-activity fs-5"></i>
                        </a>
                    {{ end }}

                    <a class="b-nav-link px-2" data-nav href="/settings"
                       aria-label="Settings" title="Settings" hx-boost="true" hx-target="#main">
                        <i class="bi bi-gear fs-5"></i>
                    </a>
                </div>
            </div>
        </nav>

        <!-- Toast Notifications -->
        <div aria-live="polite" aria-atomic="true" class="position-relative">
            <div class="toast-container p-3" id="toastPlacement">
                <div id="toast" class="toast">
                    <div id="toast-header" class="toast-header" style="text-transform: capitalize;">
                        <strong class="me-auto">Error</strong>
                    </div>
                    <div id="toast-body" class="toast-body">
                        {{/* Message Here*/}}
                    </div>
                </div>
            </div>
        </div>

        <!-- Main -->
        <main id="main" class="container">
            {{ .content }}
        </main>

        <!-- Mobile tab bar. Five destinations, within thumb reach. -->
        <nav class="b-tabbar d-md-none" hx-boost="true" hx-target="#main">
            <a data-nav href="/"><i class="bi bi-house-door"></i>Home</a>
            <a data-nav href="/insights"><i class="bi bi-graph-up-arrow"></i>Insights</a>
            <a data-nav href="/transactions"><i class="bi bi-arrow-left-right"></i>Activity</a>
            <a data-nav href="/portfolio"><i class="bi bi-wallet2"></i>Portfolio</a>
            <a data-nav href="/budget"><i class="bi bi-pie-chart"></i>Budget</a>
        </nav>

        <script nonce="{{ nonce }}">
            // Mark the current destination from the URL rather than from a click,
            // so a reload or a shared link still highlights the right tab.
            function markActiveNav() {
                const path = window.location.pathname;
                document.querySelectorAll('[data-nav]').forEach(function (link) {
                    const href = link.getAttribute('href');
                    const active = href === '/' ? path === '/' : path.startsWith(href);
                    link.classList.toggle('active', active);
                    if (active) {
                        link.setAttribute('aria-current', 'page');
                    } else {
                        link.removeAttribute('aria-current');
                    }
                });
            }

            markActiveNav();
            // hx-boost swaps the page without a load event, so re-run afterwards.
            document.body.addEventListener('htmx:pushedIntoHistory', markActiveNav);
            document.body.addEventListener('htmx:afterSettle', markActiveNav);

            // A swap that changes the path is a navigation and starts at the top,
            // the way a browser would. A swap that only changes the query string is
            // a filter, a page of results or a chart switching category, so the
            // reader stays exactly where they were.
            let lastPath = window.location.pathname;
            document.body.addEventListener('htmx:afterSettle', function () {
                const path = window.location.pathname;
                if (path === lastPath) {
                    return;
                }
                lastPath = path;
                window.scrollTo({top: 0, behavior: 'auto'});
            });

            // Tapping the destination you are already on scrolls back to the top,
            // the way a tab bar is expected to behave. If you are already at the
            // top the navigation goes ahead, so the tap is never dead: on a
            // filtered page that resets it to the default view.
            document.body.addEventListener('htmx:beforeRequest', function (evt) {
                const link = evt.detail.elt;
                if (!link || !link.hasAttribute || !link.hasAttribute('data-nav')) {
                    return;
                }
                if (link.getAttribute('href') !== window.location.pathname) {
                    return;
                }
                if (window.scrollY > 0) {
                    evt.preventDefault();
                    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
                    window.scrollTo({top: 0, behavior: reduced ? 'auto' : 'smooth'});
                }
            });

            // A swap that replaces the element with focus, such as the Add button
            // that sent it, threw the page down to the bottom: the new content goes
            // in above the old before the old is taken out, and the browser follows
            // the focused element down as it moves. Focus is taken off it first,
            // and given back after the swap, without scrolling, to the element with
            // the same id, as htmx would, so a search box keeps its cursor. A morph
            // keeps the focused element where it is, so is left alone.
            //
            // swapStyle is how a response will be swapped: as the server asked, or
            // as the element that sent the request says.
            function swapStyle(evt) {
                return (evt.detail.xhr && evt.detail.xhr.getResponseHeader('HX-Reswap')) ||
                    (evt.detail.elt.closest && evt.detail.elt.closest('[hx-swap]')?.getAttribute('hx-swap')) || '';
            }

            let refocus = null;
            document.body.addEventListener('htmx:beforeSwap', function (evt) {
                const active = document.activeElement;
                const swap = swapStyle(evt);
                if (!evt.detail.shouldSwap || swap.startsWith('none') || swap.startsWith('morph') || !active ||
                    active === document.body || !evt.detail.target.contains(active)) {
                    return;
                }
                refocus = {id: active.id, start: active.selectionStart, end: active.selectionEnd};
                active.blur();
            });
            document.body.addEventListener('htmx:afterSwap', function () {
                const field = refocus && refocus.id && document.getElementById(refocus.id);
                if (field) {
                    field.focus({preventScroll: true});
                    try {
                        field.setSelectionRange(refocus.start, refocus.end);
                    } catch (e) {
                        // Only text fields have a cursor to put back.
                    }
                }
                refocus = null;
            });

            // A morph keeps each Alpine component's state as it was, but once a
            // change is sent the state the server answers with is the truth: a
            // name it refused is put back in it. The component the change was
            // made from takes it on. Only that one, so a field half typed into
            // elsewhere is left as it is.
            document.body.addEventListener('htmx:afterSwap', function (evt) {
                const component = evt.detail.elt.closest && evt.detail.elt.closest('[x-data]');
                if (!swapStyle(evt).startsWith('morph') || !component || !component.isConnected || !window.Alpine) {
                    return;
                }
                try {
                    Object.assign(Alpine.$data(component), JSON.parse(component.getAttribute('x-data')));
                } catch (e) {
                    // x-data that is not plain JSON is a page's own, not the server's.
                }
            });

            // Bootstrap tooltips have to be rebuilt after each swap too, since the
            // elements carrying them are replaced.
            function initTooltips() {
                document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (el) {
                    bootstrap.Tooltip.getOrCreateInstance(el);
                });
            }

            initTooltips();
            document.body.addEventListener('htmx:afterSettle', initTooltips);
        </script>
    </body>

{{ end }}
