{{ define "layout" }}

    <!doctype html>

    <head lang="en">
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
        <meta name="description" content="Budge, a personal finance dashboard">
        <meta name="theme-color" content="#f3f5f7">
        <link rel="icon" href="/static/favicon.ico">

        <title>Budge</title>

        <!-- Bootstrap -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-4Q6Gf2aSP4eDXB8Miphtr37CMZZQ5oXLH2yaXMJ2w8e2ZtHTl7GptT4jmndRuHDT" crossorigin="anonymous">
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.bundle.min.js" integrity="sha384-j1CDi7MgGQ12Z7Qab0qlWQ/Qqz24Gc6BM0thvEMVjHnfYGF0rmFCozFSxQBxwHKO" crossorigin="anonymous"></script>
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

        <!-- Inter, with a system stack behind it if the font does not load -->
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

        <!-- Chart JS -->
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>

        <!-- Budge -->
        <script defer src="/static/toast.js"></script>
        <script defer src="/static/budget.js"></script>
        <link rel="stylesheet" href="/static/styles.css">
        <!-- Not deferred: inline chart code in the page body runs during parsing,
             which is before a deferred script would execute. -->
        <script src="/static/charts.js"></script>

        <!-- HTMX -->
        <script src="https://unpkg.com/htmx.org@2.0.0"></script>

        <!-- Hyperscript -->
        <script src="https://unpkg.com/hyperscript.org@0.9.12"></script>

        <script>
            htmx.config.useTemplateFragments = true
            htmx.config.scrollIntoViewOnBoost = false
        </script>
    </head>

    <body>

        <!-- Top bar. Brand and settings on mobile, full navigation from md up. -->
        <nav class="b-navbar sticky-top">
            <div class="container d-flex align-items-center justify-content-between py-2">
                <a class="navbar-brand mb-0 me-0" href="/" hx-boost="true" hx-target="#main">Budge 🐦</a>

                <div class="d-none d-md-flex align-items-center gap-1" hx-boost="true" hx-target="#main">
                    <a class="b-nav-link" data-nav href="/">Dashboard</a>
                    <a class="b-nav-link" data-nav href="/insights">Insights</a>
                    <a class="b-nav-link" data-nav href="/transactions">Transactions</a>
                    <a class="b-nav-link" data-nav href="/accounts">Portfolio</a>
                    <a class="b-nav-link" data-nav href="/budget">Budget</a>
                    <a class="b-nav-link" data-nav href="/settings">Settings</a>
                </div>

                <!-- Settings does not earn a tab slot, so on mobile it lives here. -->
                <a class="b-nav-link d-md-none px-2" data-nav href="/settings"
                   aria-label="Settings" hx-boost="true" hx-target="#main">
                    <i class="bi bi-gear fs-5"></i>
                </a>
            </div>
        </nav>

        <!-- Toast Notifications -->
        <div aria-live="polite" aria-atomic="true" class="position-relative">
            <div class="toast-container p-3" id="toastPlacement">
                <div id="toast" class="toast">
                    <div id="toast-header" class="toast-header" style="text-transform: capitalize;">
                        <strong class="me-auto">Error</strong>
                    </div>
                    <div id="toast-body" class="toast-body">
                        {{/* Message Here*/}}
                    </div>
                </div>
            </div>
        </div>

        <!-- Main -->
        <main id="main" class="container">
            {{ .content }}
        </main>

        <!-- Mobile tab bar. Five destinations, within thumb reach. -->
        <nav class="b-tabbar d-md-none" hx-boost="true" hx-target="#main">
            <a data-nav href="/"><i class="bi bi-house-door"></i>Home</a>
            <a data-nav href="/insights"><i class="bi bi-graph-up-arrow"></i>Insights</a>
            <a data-nav href="/transactions"><i class="bi bi-arrow-left-right"></i>Activity</a>
            <a data-nav href="/accounts"><i class="bi bi-wallet2"></i>Portfolio</a>
            <a data-nav href="/budget"><i class="bi bi-pie-chart"></i>Budget</a>
        </nav>

        <script>
            // Mark the current destination from the URL rather than from a click,
            // so a reload or a shared link still highlights the right tab.
            function markActiveNav() {
                const path = window.location.pathname;
                document.querySelectorAll('[data-nav]').forEach(function (link) {
                    const href = link.getAttribute('href');
                    const active = href === '/' ? path === '/' : path.startsWith(href);
                    link.classList.toggle('active', active);
                    if (active) {
                        link.setAttribute('aria-current', 'page');
                    } else {
                        link.removeAttribute('aria-current');
                    }
                });
            }

            markActiveNav();
            // hx-boost swaps the page without a load event, so re-run afterwards.
            document.body.addEventListener('htmx:pushedIntoHistory', markActiveNav);
            document.body.addEventListener('htmx:afterSettle', markActiveNav);

            // A swap that changes the path is a navigation and starts at the top,
            // the way a browser would. A swap that only changes the query string is
            // a filter, a page of results or a chart switching category, so the
            // reader stays exactly where they were.
            let lastPath = window.location.pathname;
            document.body.addEventListener('htmx:afterSettle', function () {
                const path = window.location.pathname;
                if (path === lastPath) {
                    return;
                }
                lastPath = path;
                window.scrollTo({top: 0, behavior: 'auto'});
            });

            // Tapping the destination you are already on scrolls back to the top,
            // the way a tab bar is expected to behave. If you are already at the
            // top the navigation goes ahead, so the tap is never dead: on a
            // filtered page that resets it to the default view.
            document.body.addEventListener('htmx:beforeRequest', function (evt) {
                const link = evt.detail.elt;
                if (!link || !link.hasAttribute || !link.hasAttribute('data-nav')) {
                    return;
                }
                if (link.getAttribute('href') !== window.location.pathname) {
                    return;
                }
                if (window.scrollY > 0) {
                    evt.preventDefault();
                    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
                    window.scrollTo({top: 0, behavior: reduced ? 'auto' : 'smooth'});
                }
            });

            // Bootstrap tooltips have to be rebuilt after each swap too, since the
            // elements carrying them are replaced.
            function initTooltips() {
                document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (el) {
                    bootstrap.Tooltip.getOrCreateInstance(el);
                });
            }

            initTooltips();
            document.body.addEventListener('htmx:afterSettle', initTooltips);
        </script>
    </body>

{{ end }}
