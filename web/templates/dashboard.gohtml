{{define "dashboard"}}

    <div class="b-page-head">
        <h2>Dashboard</h2>
        <p class="b-page-sub">Where your money went, and how that compares.</p>
    </div>

    <!-- Spend highlights. The questions asked most often, answered before any
         tapping: what the shop cost, what petrol cost, what power cost. -->
    {{ if .SpendHighlights }}
        <div class="row g-2 g-md-3 mb-3">
            {{ range .SpendHighlights }}
                <div class="col-4">
                    <a class="b-highlight b-accent-{{ .Group.Accent }}"
                       href="/insights?group={{ .Group.Key }}"
                       hx-boost="true" hx-target="#main">

                        <div class="b-highlight-head">
                            <span class="b-chip b-chip-sm"><i class="bi {{ .Group.Icon }}"></i></span>
                            <div class="min-width-0 d-none d-sm-block">
                                <div class="b-highlight-name text-truncate">{{ .Group.Label }}</div>
                                <div class="b-highlight-period">{{ .HeadlineLabel }}</div>
                            </div>
                        </div>

                        <div class="b-highlight-name d-sm-none text-truncate mb-1">{{ .Group.Label }}</div>
                        <div class="b-highlight-value">{{ .Headline | fmtCurrency }}</div>
                        <div class="b-highlight-period d-sm-none">{{ .HeadlineLabel }}</div>

                        <div class="mt-1">
                            {{ if .HasHeadlineDelta }}
                                {{ if gt .HeadlineDelta 0.0 }}
                                    <span class="b-delta b-delta-bad">
                                        <i class="bi bi-arrow-up-short"></i>{{ .HeadlineDelta | fmtPercent }}
                                    </span>
                                {{ else if lt .HeadlineDelta 0.0 }}
                                    <span class="b-delta b-delta-good">
                                        <i class="bi bi-arrow-down-short"></i>{{ .HeadlineDelta | fmtPercent }}
                                    </span>
                                {{ else }}
                                    <span class="b-delta b-delta-flat">
                                        <i class="bi bi-dash"></i>Level
                                    </span>
                                {{ end }}
                                <div class="b-delta-note mt-1 d-none d-sm-block">
                                    vs {{ .HeadlinePrevious | fmtCurrency }} {{ .HeadlineNote }}
                                </div>
                            {{ else }}
                                <span class="b-delta b-delta-flat">No history</span>
                            {{ end }}
                        </div>

                        <div class="b-spark d-none d-sm-flex">
                            {{ range .Bars }}
                                <span class="b-spark-bar{{ if .Partial }} b-spark-bar-partial{{ else if .Headline }} b-spark-bar-headline{{ end }}"
                                      style="height: {{ printf "%.1f" .Pct }}%"
                                      title="{{ .Label }}: {{ .Total | fmtCurrency }}{{ if .Partial }} so far{{ end }}"></span>
                            {{ end }}
                        </div>
                    </a>
                </div>
            {{ end }}
        </div>
    {{ end }}

    <!-- Headline metrics -->
    <div class="row g-2 g-md-3 mb-3">
        <div class="col-6 col-lg-3">
            <div class="b-stat b-accent-slate">
                <div class="b-stat-label"><span>Total Balance</span><i class="bi bi-bank2"></i></div>
                <div class="b-stat-value">{{ .BalanceCard.Total | fmtCurrency }}</div>
                <div>
                    <span class="b-delta {{ if gt .BalanceCard.Delta 0.0 }}b-delta-good{{ else if lt .BalanceCard.Delta 0.0 }}b-delta-bad{{ else }}b-delta-flat{{ end }}"
                          data-bs-toggle="tooltip" data-bs-placement="top"
                          title="Previously {{ .BalanceCard.PreviousTotal | fmtCurrency }}">
                        <i class="bi {{ if gt .BalanceCard.Delta 0.0 }}bi-arrow-up-short{{ else if lt .BalanceCard.Delta 0.0 }}bi-arrow-down-short{{ else }}bi-dash{{ end }}"></i>{{ .BalanceCard.Delta | fmtPercent }}
                    </span>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="b-stat b-accent-brick">
                <div class="b-stat-label"><span>Spending</span><i class="bi bi-graph-down"></i></div>
                <div class="b-stat-value">{{ .SpendCard.Total | fmtCurrencyAbs }}</div>
                <div>
                    <span class="b-delta {{ if gt .SpendCard.Delta 0.0 }}b-delta-bad{{ else if lt .SpendCard.Delta 0.0 }}b-delta-good{{ else }}b-delta-flat{{ end }}"
                          data-bs-toggle="tooltip" data-bs-placement="top"
                          title="Previously {{ .SpendCard.PreviousTotal | fmtCurrencyAbs }}">
                        <i class="bi {{ if gt .SpendCard.Delta 0.0 }}bi-arrow-up-short{{ else if lt .SpendCard.Delta 0.0 }}bi-arrow-down-short{{ else }}bi-dash{{ end }}"></i>{{ .SpendCard.Delta | fmtPercent }}
                    </span>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="b-stat b-accent-sage">
                <div class="b-stat-label"><span>Income</span><i class="bi bi-graph-up"></i></div>
                <div class="b-stat-value">{{ .IncomeCard.Total | fmtCurrency }}</div>
                <div>
                    <span class="b-delta {{ if gt .IncomeCard.Delta 0.0 }}b-delta-good{{ else if lt .IncomeCard.Delta 0.0 }}b-delta-bad{{ else }}b-delta-flat{{ end }}"
                          data-bs-toggle="tooltip" data-bs-placement="top"
                          title="Previously {{ .IncomeCard.PreviousTotal | fmtCurrency }}">
                        <i class="bi {{ if gt .IncomeCard.Delta 0.0 }}bi-arrow-up-short{{ else if lt .IncomeCard.Delta 0.0 }}bi-arrow-down-short{{ else }}bi-dash{{ end }}"></i>{{ .IncomeCard.Delta | fmtPercent }}
                    </span>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="b-stat b-accent-slate">
                <div class="b-stat-label"><span>Savings</span><i class="bi bi-piggy-bank"></i></div>
                <div class="b-stat-value {{ if lt .SavingsCard.Total 0.0 }}text-danger{{ end }}">{{ .SavingsCard.Total | fmtCurrency }}</div>
                <div>
                    <span class="b-delta {{ if gt .SavingsCard.Delta 0.0 }}b-delta-good{{ else if lt .SavingsCard.Delta 0.0 }}b-delta-bad{{ else }}b-delta-flat{{ end }}"
                          data-bs-toggle="tooltip" data-bs-placement="top"
                          title="Previously {{ .SavingsCard.PreviousTotal | fmtCurrency }}">
                        <i class="bi {{ if gt .SavingsCard.Delta 0.0 }}bi-arrow-up-short{{ else if lt .SavingsCard.Delta 0.0 }}bi-arrow-down-short{{ else }}bi-dash{{ end }}"></i>{{ .SavingsCard.Delta | fmtPercent }}
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts -->
    <div class="row g-2 g-md-3 mb-3">
        <div class="col-12 col-lg-6">
            <div class="b-card b-card-pad h-100">
                <div class="b-card-head">
                    <div>
                        <h3 class="b-card-title">Monthly Spending</h3>
                        <p class="b-card-sub">Your spending over the past 6 months</p>
                    </div>
                </div>
                <canvas id="barChart" style="max-height: 220px"></canvas>
            </div>
        </div>

        <div class="col-12 col-lg-6">
            <div class="b-card b-card-pad h-100">
                <div class="b-card-head">
                    <div>
                        <h3 class="b-card-title">Spending by Category</h3>
                        <p class="b-card-sub">Where it goes, as a share of the total</p>
                    </div>
                </div>
                <canvas id="doughnutChart" style="max-height: 220px"></canvas>
            </div>
        </div>
    </div>

    <!-- Merchants and biggest transactions -->
    <div class="row g-2 g-md-3 mb-3">
        <div class="col-12 col-lg-6">
            <div class="b-card b-card-pad h-100 b-accent-slate">
                <div class="b-card-head">
                    <div>
                        <h3 class="b-card-title">Top Merchants</h3>
                        <p class="b-card-sub">Most paid over the last 30 days</p>
                    </div>

                </div>

                {{ if .TopMerchants }}
                    {{ $top := (index .TopMerchants 0).Total }}
                    <ul class="b-rank">
                        {{ range .TopMerchants }}
                            <li>
                                <a class="b-rank-item b-rank-link" href="/transactions?search={{ .Merchant }}"
                                   hx-boost="true" hx-target="#main">
                                <span class="b-chip b-chip-sm fw-bold">{{ slice .Merchant 0 1 }}</span>
                                <div class="b-rank-body">
                                    <div class="d-flex align-items-baseline justify-content-between gap-2">
                                        <span class="b-rank-name">{{ .Merchant }}</span>
                                        <span class="b-rank-value">{{ .Total | fmtCurrency }}</span>
                                    </div>
                                    <div class="b-rank-track">
                                        <span class="b-rank-fill" style="width: {{ printf "%.1f" (pctOf .Total $top) }}%"></span>
                                    </div>
                                    <div class="b-rank-meta mt-1">
                                        {{ if eq .PreviousTotal 0.0 }}
                                            <i class="bi bi-stars"></i> New this period
                                        {{ else if gt .Delta 0.0 }}
                                            <span class="text-danger fw-semibold">
                                                <i class="bi bi-arrow-up-short"></i>{{ .Delta | fmtPercent }}
                                            </span>
                                            from {{ .PreviousTotal | fmtCurrency }}
                                        {{ else if lt .Delta 0.0 }}
                                            <span class="text-success fw-semibold">
                                                <i class="bi bi-arrow-down-short"></i>{{ .Delta | fmtPercent }}
                                            </span>
                                            from {{ .PreviousTotal | fmtCurrency }}
                                        {{ else }}
                                            Unchanged from {{ .PreviousTotal | fmtCurrency }}
                                        {{ end }}
                                    </div>
                                </div>
                                <i class="bi bi-chevron-right b-rank-go"></i>
                                </a>
                            </li>
                        {{ end }}
                    </ul>
                {{ else }}
                    <div class="b-empty">
                        <i class="bi bi-shop"></i>
                        <h4>No merchant activity</h4>
                        <p>Nothing was spent with a named merchant in the last 30 days.</p>
                    </div>
                {{ end }}
            </div>
        </div>

        <div class="col-12 col-lg-6">
            <div class="b-card b-card-pad h-100 b-accent-brick">
                <div class="b-card-head">
                    <div>
                        <h3 class="b-card-title">Biggest Transactions</h3>
                        <p class="b-card-sub">Largest single payments in the last 30 days</p>
                    </div>
                    <a class="b-pill" href="/transactions" hx-boost="true" hx-target="#main">
                        All <i class="bi bi-arrow-right"></i>
                    </a>
                </div>

                {{ if .HighestOutgoingTransactions }}
                    {{ $largest := (index .HighestOutgoingTransactions 0).Amount }}
                    <ul class="b-rank">
                        {{ range .HighestOutgoingTransactions }}
                            <li>
                                <a class="b-rank-item b-rank-link" href="/transactions?search={{ .Description }}"
                                   hx-boost="true" hx-target="#main">
                                <span class="b-chip b-chip-sm"><i class="bi bi-arrow-down-left"></i></span>
                                <div class="b-rank-body">
                                    <div class="d-flex align-items-baseline justify-content-between gap-2">
                                        <span class="b-rank-name">{{ .Description }}</span>
                                        <span class="b-rank-value">{{ .Amount | fmtCurrencyAbs }}</span>
                                    </div>
                                    <div class="b-rank-track">
                                        <span class="b-rank-fill" style="width: {{ printf "%.1f" (pctOf .Amount $largest) }}%"></span>
                                    </div>
                                    <div class="b-rank-meta mt-1">{{ .Date.Format "Mon 2 Jan" }}</div>
                                </div>
                                <i class="bi bi-chevron-right b-rank-go"></i>
                                </a>
                            </li>
                        {{ end }}
                    </ul>
                {{ else }}
                    <div class="b-empty">
                        <i class="bi bi-receipt"></i>
                        <h4>Nothing to show</h4>
                        <p>No outgoing transactions in the last 30 days.</p>
                    </div>
                {{ end }}
            </div>
        </div>
    </div>

    <script>
        (function () {
            // Charts are rebuilt on every swap, so tear down any instance still
            // attached to these canvases before drawing over them.
            const ink = window.budge ? window.budge.ink : '#78858f';
            const grid = window.budge ? window.budge.grid : '#e6ecf0';

            const barCanvas = document.getElementById("barChart");
            if (barCanvas) {
                Chart.getChart(barCanvas)?.destroy();
                new Chart(barCanvas, {
                    type: "bar",
                    data: {
                        labels: {{ .SpendTimeseries.Labels }},
                        datasets: [{
                            label: "Spending",
                            data: {{ .SpendTimeseries.Data }},
                            backgroundColor: window.budge ? window.budge.primary : "#3d6b8f",
                            hoverBackgroundColor: window.budge ? window.budge.primaryInk : "#315774",
                            borderRadius: 6,
                            maxBarThickness: 48
                        }]
                    },
                    options: {
                        maintainAspectRatio: false,
                        scales: {
                            y: {
                                beginAtZero: true,
                                border: {display: false},
                                grid: {color: grid},
                                ticks: {color: ink, callback: v => "$" + v.toLocaleString()}
                            },
                            x: {
                                border: {display: false},
                                grid: {display: false},
                                ticks: {color: ink}
                            }
                        },
                        plugins: {legend: {display: false}}
                    }
                });
            }

            const doughnutCanvas = document.getElementById("doughnutChart");
            if (doughnutCanvas) {
                Chart.getChart(doughnutCanvas)?.destroy();
                new Chart(doughnutCanvas, {
                    type: "doughnut",
                    data: {
                        labels: {{ .SpendDoughnut.Labels }},
                        datasets: [{
                            data: {{ .SpendDoughnut.Data }},
                            backgroundColor: window.budge ? window.budge.series : undefined,
                            borderWidth: 2,
                            borderColor: window.budge ? window.budge.surface : "#ffffff"
                        }]
                    },
                    options: {
                        maintainAspectRatio: false,
                        cutout: "62%",
                        plugins: {
                            legend: {
                                position: "right",
                                labels: {color: ink, boxWidth: 10, boxHeight: 10, usePointStyle: true, pointStyle: "circle"}
                            }
                        }
                    }
                });
            }
        })();
    </script>

{{ end }}
