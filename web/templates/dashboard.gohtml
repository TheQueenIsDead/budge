{{define "dashboard"}}

    {{ template "pageHead" (dict "Title" "Dashboard" "Sub" "Where your money went, and how that compares.") }}

    <!-- Spend highlights. The questions asked most often, answered before any
         tapping: what the shop cost, what petrol cost, what power cost. -->
    {{ if .SpendHighlights }}
        <div class="row g-2 g-md-3 mb-3">
            {{ range .SpendHighlights }}
                <div class="col-4">
                    <a class="b-highlight b-accent-{{ .Group.Accent }}"
                       href="/insights?group={{ .Group.Key }}"
                       hx-boost="true" hx-target="#main">

                        <div class="b-highlight-head">
                            <span class="b-chip b-chip-sm"><i class="bi {{ .Group.Icon }}"></i></span>
                            <div class="min-width-0 d-none d-sm-block">
                                <div class="b-highlight-name text-truncate">{{ .Group.Label }}</div>
                                <div class="b-highlight-period">{{ .HeadlineLabel }}</div>
                            </div>
                        </div>

                        <div class="b-highlight-name d-sm-none text-truncate mb-1">{{ .Group.Label }}</div>
                        <div class="b-highlight-value">{{ .Headline | fmtCurrency }}</div>
                        <div class="b-highlight-period d-sm-none">{{ .HeadlineLabel }}</div>

                        <div class="mt-1">
                            {{ if .HasHeadlineDelta }}
                                {{ template "delta" (dict "Value" .HeadlineDelta "Title" (printf "Previously %s" (fmtCurrency .HeadlinePrevious))) }}
                                <div class="b-delta-note mt-1 d-none d-sm-block">
                                    vs {{ .HeadlinePrevious | fmtCurrency }} {{ .HeadlineNote }}
                                </div>
                            {{ else }}
                                {{ template "delta" (dict "Note" "No history") }}
                            {{ end }}
                        </div>

                        <div class="b-spark d-none d-sm-flex">
                            {{ range .Bars }}
                                <span class="b-spark-bar{{ if .Partial }} b-spark-bar-partial{{ else if .Headline }} b-spark-bar-headline{{ end }}"
                                      style="height: {{ printf "%.1f" .Pct }}%"
                                      title="{{ .Label }}: {{ .Total | fmtCurrency }}{{ if .Partial }} so far{{ end }}"></span>
                            {{ end }}
                        </div>
                    </a>
                </div>
            {{ end }}
        </div>
    {{ end }}

    <!-- Headline metrics -->
    <div class="row g-2 g-md-3 mb-3">
        <div class="col-6 col-lg-3">
            {{ template "stat" (dict "Label" "Total Balance" "Icon" "bi-bank2" "Accent" "slate"
                "Value" (fmtCurrency .BalanceCard.Total)
                "Delta" (dict "Value" .BalanceCard.Delta "UpIsGood" true "Title" (printf "Previously %s" (fmtCurrency .BalanceCard.PreviousTotal)))) }}
        </div>
        <div class="col-6 col-lg-3">
            {{ template "stat" (dict "Label" "Spending" "Icon" "bi-graph-down" "Accent" "brick"
                "Value" (fmtCurrencyAbs .SpendCard.Total)
                "Delta" (dict "Value" .SpendCard.Delta "Title" (printf "Previously %s" (fmtCurrencyAbs .SpendCard.PreviousTotal)))) }}
        </div>
        <div class="col-6 col-lg-3">
            {{ template "stat" (dict "Label" "Income" "Icon" "bi-graph-up" "Accent" "sage"
                "Value" (fmtCurrency .IncomeCard.Total)
                "Delta" (dict "Value" .IncomeCard.Delta "UpIsGood" true "Title" (printf "Previously %s" (fmtCurrency .IncomeCard.PreviousTotal)))) }}
        </div>
        <div class="col-6 col-lg-3">
            {{ template "stat" (dict "Label" "Savings" "Icon" "bi-piggy-bank" "Accent" "slate"
                "Value" (fmtCurrency .SavingsCard.Total) "Tone" (and (lt .SavingsCard.Total 0.0) "text-danger")
                "Delta" (dict "Value" .SavingsCard.Delta "UpIsGood" true "Title" (printf "Previously %s" (fmtCurrency .SavingsCard.PreviousTotal)))) }}
        </div>
    </div>

    <!-- Charts -->
    <div class="row g-2 g-md-3 mb-3">
        <div class="col-12 col-lg-6">
            <div class="b-card b-card-pad h-100">
                {{ template "cardHead" (dict "Title" "Monthly Spending" "Sub" "Your spending over the past 6 months") }}
                <div class="b-chart b-chart-short">
                    <canvas id="barChart"></canvas>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-6">
            <div class="b-card b-card-pad h-100">
                {{ template "cardHead" (dict "Title" "Spending by Category" "Sub" "Where it goes, as a share of the total") }}
                <div class="b-chart b-chart-short">
                    <canvas id="doughnutChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Merchants and biggest transactions -->
    <div class="row g-2 g-md-3 mb-3">
        <div class="col-12 col-lg-6">
            <div class="b-card b-card-pad h-100 b-accent-slate">
                {{ template "cardHead" (dict "Title" "Top Merchants" "Sub" "Most paid over the last 30 days") }}

                {{ if .TopMerchants }}
                    {{ $top := (index .TopMerchants 0).Total }}
                    <ul class="b-rank">
                        {{ range .TopMerchants }}
                            <li>
                                <a class="b-rank-item b-rank-link" href="{{ $.MerchantLink .Merchant }}"
                                   hx-boost="true" hx-target="#main">
                                <span class="b-chip b-chip-sm fw-bold">{{ slice .Merchant 0 1 }}</span>
                                <div class="b-rank-body">
                                    <div class="d-flex align-items-baseline justify-content-between gap-2">
                                        <span class="b-rank-name">{{ .Merchant }}</span>
                                        <span class="b-rank-value">{{ .Total | fmtCurrency }}</span>
                                    </div>
                                    <div class="b-rank-track">
                                        <span class="b-rank-fill" style="width: {{ printf "%.1f" (pctOf .Total $top) }}%"></span>
                                    </div>
                                    <div class="b-rank-meta mt-1">
                                        {{ if eq .PreviousTotal 0.0 }}
                                            <i class="bi bi-stars"></i> New this period
                                        {{ else if gt .Delta 0.0 }}
                                            <span class="text-danger fw-semibold">
                                                <i class="bi bi-arrow-up-short"></i>{{ .Delta | fmtPercent }}
                                            </span>
                                            from {{ .PreviousTotal | fmtCurrency }}
                                        {{ else if lt .Delta 0.0 }}
                                            <span class="text-success fw-semibold">
                                                <i class="bi bi-arrow-down-short"></i>{{ .Delta | fmtPercent }}
                                            </span>
                                            from {{ .PreviousTotal | fmtCurrency }}
                                        {{ else }}
                                            Unchanged from {{ .PreviousTotal | fmtCurrency }}
                                        {{ end }}
                                    </div>
                                </div>
                                <i class="bi bi-chevron-right b-rank-go"></i>
                                </a>
                            </li>
                        {{ end }}
                    </ul>
                {{ else }}
                    {{ template "empty" (dict "Icon" "bi-shop" "Title" "No merchant activity" "Text" "Nothing was spent with a named merchant in the last 30 days.") }}
                {{ end }}
            </div>
        </div>

        <div class="col-12 col-lg-6">
            <div class="b-card b-card-pad h-100 b-accent-brick">
                <div class="b-card-head">
                    {{ template "cardTitle" (dict "Title" "Biggest Transactions" "Sub" "Largest single payments in the last 30 days") }}
                    <a class="b-pill flex-shrink-0" href="/transactions" hx-boost="true" hx-target="#main">
                        All <i class="bi bi-arrow-right" aria-hidden="true"></i>
                    </a>
                </div>

                {{ if .HighestOutgoingTransactions }}
                    {{ $largest := (index .HighestOutgoingTransactions 0).Amount }}
                    <ul class="b-rank">
                        {{ range .HighestOutgoingTransactions }}
                            <li>
                                <a class="b-rank-item b-rank-link" href="{{ .Link }}"
                                   hx-boost="true" hx-target="#main">
                                <span class="b-chip b-chip-sm"><i class="bi bi-arrow-down-left"></i></span>
                                <div class="b-rank-body">
                                    <div class="d-flex align-items-baseline justify-content-between gap-2">
                                        <span class="b-rank-name">{{ .Description }}</span>
                                        <span class="b-rank-value">{{ .Amount | fmtCurrencyAbs }}</span>
                                    </div>
                                    <div class="b-rank-track">
                                        <span class="b-rank-fill" style="width: {{ printf "%.1f" (pctOf .Amount $largest) }}%"></span>
                                    </div>
                                    <div class="b-rank-meta mt-1">{{ .Date.Format "Mon 2 Jan" }}</div>
                                </div>
                                <i class="bi bi-chevron-right b-rank-go"></i>
                                </a>
                            </li>
                        {{ end }}
                    </ul>
                {{ else }}
                    {{ template "empty" (dict "Icon" "bi-receipt" "Title" "Nothing to show" "Text" "No outgoing transactions in the last 30 days.") }}
                {{ end }}
            </div>
        </div>
    </div>

    <script nonce="{{ nonce }}">
        (function () {
            // Charts are rebuilt on every swap, so tear down any instance still
            // attached to these canvases before drawing over them.
            const ink = window.budge.ink;
            const grid = window.budge.grid;

            const barCanvas = document.getElementById("barChart");
            if (barCanvas) {
                Chart.getChart(barCanvas)?.destroy();
                new Chart(barCanvas, {
                    type: "bar",
                    data: {
                        labels: {{ .SpendTimeseries.Labels }},
                        datasets: [{
                            label: "Spending",
                            data: {{ .SpendTimeseries.Data }},
                            backgroundColor: window.budge.primary,
                            hoverBackgroundColor: window.budge.primaryInk,
                            borderRadius: 6,
                            maxBarThickness: 48
                        }]
                    },
                    options: {
                        maintainAspectRatio: false,
                        scales: {
                            y: {
                                beginAtZero: true,
                                border: {display: false},
                                grid: {color: grid},
                                ticks: {color: ink, callback: v => "$" + v.toLocaleString()}
                            },
                            x: {
                                border: {display: false},
                                grid: {display: false},
                                ticks: {color: ink}
                            }
                        },
                        plugins: {legend: {display: false}}
                    }
                });
            }

            const doughnutCanvas = document.getElementById("doughnutChart");
            if (doughnutCanvas) {
                Chart.getChart(doughnutCanvas)?.destroy();
                new Chart(doughnutCanvas, {
                    type: "doughnut",
                    data: {
                        labels: {{ .SpendDoughnut.Labels }},
                        datasets: [{
                            data: {{ .SpendDoughnut.Data }},
                            backgroundColor: window.budge ? window.budge.series : undefined,
                            borderWidth: 2,
                            borderColor: window.budge.surface
                        }]
                    },
                    options: {
                        maintainAspectRatio: false,
                        cutout: "62%",
                        plugins: {
                            legend: {
                                position: "right",
                                labels: {color: ink, boxWidth: 10, boxHeight: 10, usePointStyle: true, pointStyle: "circle"}
                            }
                        }
                    }
                });
            }
        })();
    </script>

{{ end }}
