{{/* A memory on a page of its own, to make one or change one. Its header is
     the timeline's memory card, named and dressed in place, and its purchases
     are the transactions list's rows, each icon a tick box. They are all in
     the one form, so the memory holds what is ticked when it is saved: untick
     one to take it out, tick one bought around then to add it. Saving goes
     back to wherever the page was opened from. */}}
{{ define "memory" }}

    {{ if .New }}
        {{ template "pageHead" (dict "Title" "New memory" "Sub" "What these were for, and anything else that went with them.") }}
    {{ else }}
        {{ template "pageHead" (dict "Title" "Edit memory" "Sub" "Its name, and the purchases that went into it.") }}
    {{ end }}

    <form class="b-tx-feed b-memory" hx-swap="none"
          {{ if .New }}hx-post="/memories"{{ else }}hx-post="/memories/{{ .Memory.Id }}"{{ end }}
          x-data='{{ dict "kind" .Kind.Key "looks" .Looks "start" "" "changed" false | toJSON }}'
          x-init="start = new URLSearchParams(new FormData($el)).toString()"
          @input="changed = new URLSearchParams(new FormData($el)).toString() !== start"
          @change="changed = new URLSearchParams(new FormData($el)).toString() !== start">
        {{/* changed is whether anything differs from how the page opened, by
             the form's own values, so ticking a purchase and unticking it
             again leaves nothing to save. */}}
        <input type="hidden" name="return" value="{{ .Return }}">

        {{/* The colour and icon follow the kind as it is picked, as a
             category's do in settings. */}}
        <div class="b-card b-memory-card mb-4 b-accent-{{ .Kind.Accent }}"
             x-effect="[...$el.classList].filter(c => c.startsWith('b-accent-')).forEach(c => $el.classList.remove(c)); $el.classList.add('b-accent-' + looks[kind].accent)">
            <div class="b-tl-row mb-3">
                <span class="b-chip"><i class="bi {{ .Kind.Icon }}" x-effect="$el.className = 'bi ' + looks[kind].icon"></i></span>
                <div class="b-tx-body">
                    <input class="form-control b-memory-title" id="memory-title" name="title" value="{{ .Memory.Title }}"
                           placeholder="Name this memory" aria-label="Name" {{ if not .New }}required{{ end }}>
                    <div class="b-tx-meta">{{ .Span }}</div>
                </div>
                <div class="b-tx-amount">{{ .Total | fmtCurrency }}</div>
            </div>

            <span class="b-field-label">Kind</span>
            <div class="mb-3">
                {{ template "chipPicker" (dict "Type" "kind" "Name" "kind" "Label" "What kind of memory"
                    "Options" .Kinds "Selected" .Kind.Key "Model" "kind") }}
            </div>

            {{ template "field" (dict "ID" "memory-note" "Label" "Note" "Name" "note" "Size" "sm"
                "Value" .Memory.Note "Placeholder" "A note, if you like") }}
        </div>

        <div class="b-tx-day">
            <span>In this memory</span>
            <span class="b-num">{{ len .Rows }} purchase{{ if ne (len .Rows) 1 }}s{{ end }}</span>
        </div>
        <div class="b-tx-list mb-4">
            {{ range .Rows }}{{ template "memory.row" (dict "Row" . "Tags" .CategoryTags "Ticked" true) }}{{ end }}
        </div>

        {{ if .Nearby }}
            <div class="b-tx-day">
                <span>Bought around then</span>
            </div>
            <div class="b-tx-list mb-4">
                {{ range .Nearby }}{{ template "memory.row" (dict "Row" .TransactionRow "Tags" .TransactionRow.CategoryTags "Claimed" .Claimed) }}{{ end }}
            </div>
        {{ end }}

        {{/* Saving last, at the bottom right where the eye ends up; deleting
             apart from it, on the left. */}}
        <div class="b-actions">
            {{ if not .New }}
                <button type="button" class="btn btn-link text-muted px-0 b-actions-status"
                        hx-delete="/memories/{{ .Memory.Id }}" hx-vals='{{ dict "return" .Return | toJSON }}'
                        hx-confirm="Delete “{{ .Memory.Title }}”? Its purchases go back on the timeline.">
                    <i class="bi bi-trash"></i>Delete
                </button>
            {{ end }}
            <a class="btn btn-outline-secondary" href="{{ .Return }}" hx-boost="true" hx-target="#main">Cancel</a>
            {{ if .New }}
                <button class="btn btn-primary">Make memory</button>
            {{ else }}
                {{/* Greyed out until something is changed: disabled as drawn, so
                     it doesn't show ready for the moment before Alpine starts. */}}
                <button class="btn btn-primary" disabled :disabled="!changed">Save</button>
            {{ end }}
        </div>
    </form>

{{ end }}

{{/* A purchase on a memory's page: the transactions list's row, its icon the
     tick box. One already in another memory says so, and is left alone. Its
     tags are worked out by the caller, where the row can be pointed at. */}}
{{ define "memory.row" }}
{{ $row := .Row }}
<div class="b-tx{{ if $row.Accent }} b-accent-{{ $row.Accent }}{{ end }}{{ if .Claimed }} b-tx-claimed{{ end }}">
    {{ if .Claimed }}
        <span class="b-chip" title="Already in another memory"><i class="bi bi-bookmark-check"></i></span>
    {{ else }}
        {{ if .Ticked }}
            {{ template "transactions.pick" (dict "Row" $row "Checked" true "Title" "In this memory" "Label" (printf "Keep %s" $row.Title)) }}
        {{ else }}
            {{ template "transactions.pick" (dict "Row" $row "Title" "Add to this memory" "Label" (printf "Add %s" $row.Title)) }}
        {{ end }}
    {{ end }}
    <div class="b-tx-body">
        <div class="b-tx-name">{{ $row.Title }}</div>
        <div class="b-tx-meta">
            <span>{{ $row.Date.Format "Mon 2 Jan" }}</span>
            {{ if .Claimed }}<span>in another memory</span>{{ else }}{{ template "transactions.tags" (dict "Tags" .Tags) }}{{ end }}
        </div>
    </div>
    <div class="b-tx-amount {{ if gt $row.Amount 0.0 }}text-success{{ end }}">{{ $row.Amount | fmtCurrencyAbs }}</div>
</div>
{{ end }}
