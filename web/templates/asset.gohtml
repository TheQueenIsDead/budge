{{ define "asset" }}

    <div class="b-page-head d-flex align-items-start justify-content-between gap-3">
        <div class="min-width-0 d-flex align-items-center gap-2">
            <span class="b-chip {{ if or .Summary.Type.Liability (lt .Summary.Change 0.0) }}b-accent-brick{{ else }}b-accent-sage{{ end }}">
                <i class="bi {{ .Summary.Icon }}"></i>
            </span>
            <div class="min-width-0">
                <h2 class="text-truncate">{{ .Summary.Asset.Name }}</h2>
                <p class="b-page-sub">
                    {{ .Summary.TypeLabel }}{{ if .Summary.Asset.Description }} &middot; {{ .Summary.Asset.Description }}{{ end }}
                </p>
            </div>
        </div>
        <a href="/portfolio" class="btn btn-sm btn-outline-secondary flex-shrink-0"
           hx-boost="true" hx-target="#main" aria-label="Back to accounts">
            <i class="bi bi-arrow-left"></i>
        </a>
    </div>

    <div class="row g-2 g-md-3 mb-3">
        <div class="col-12 col-md-4">
            <div class="b-stat b-accent-slate">
                <div class="b-stat-label"><span>{{ .Summary.Type.ValueLabel }}</span><i class="bi bi-cash-stack"></i></div>
                <div class="b-stat-value {{ if .Summary.Type.Liability }}text-danger{{ end }}">
                    {{ if .Summary.Type.Liability }}{{ .Summary.Owed | fmtCurrency }}{{ else }}{{ .Summary.Current | fmtCurrency }}{{ end }}
                </div>
                <div class="b-delta-note">
                    {{ if .Summary.Estimated }}
                        Estimated: {{ .Summary.Estimate.Repayments }} repayment{{ if ne .Summary.Estimate.Repayments 1 }}s{{ end }}
                        since {{ .Summary.Estimate.From.Format "2 Jan 2006" }}
                    {{ else if .Summary.Valued }}
                        Updated {{ .Summary.LastDate.Format "2 Jan 2006" }}
                    {{ else }}
                        No {{ .Summary.Type.ValueNoun }} recorded since it was added
                    {{ end }}
                </div>
            </div>
        </div>

        <div class="col-6 col-md-4">
            <div class="b-stat b-accent-clay">
                <div class="b-stat-label"><span>{{ .Summary.Type.PriceLabel }}</span><i class="bi bi-receipt"></i></div>
                <div class="b-stat-value">{{ .Summary.Asset.PurchasePrice | fmtCurrency }}</div>
                <div class="b-delta-note">
                    {{ if not .Summary.Asset.PurchaseDate.IsZero }}
                        {{ .Summary.Asset.PurchaseDate.Format "Jan 2006" }}
                    {{ end }}
                </div>
            </div>
        </div>

        <div class="col-6 col-md-4">
            <div class="b-stat {{ if lt .Summary.Change 0.0 }}b-accent-brick{{ else }}b-accent-sage{{ end }}">
                <div class="b-stat-label">
                    <span>{{ if .Summary.Type.Liability }}{{ if lt .Summary.Change 0.0 }}Grown by{{ else }}Paid off{{ end }}{{ else if lt .Summary.Change 0.0 }}Loss{{ else }}Gain{{ end }}</span>
                    <i class="bi bi-graph-up-arrow"></i>
                </div>
                <div class="b-stat-value {{ if lt .Summary.Change 0.0 }}text-danger{{ else if gt .Summary.Change 0.0 }}text-success{{ end }}">
                    {{ .Summary.Change | fmtCurrencyAbs }}
                </div>
                <div>
                    {{ if .Summary.Valued }}
                        <span class="b-delta {{ if gt .Summary.Change 0.0 }}b-delta-good{{ else if lt .Summary.Change 0.0 }}b-delta-bad{{ else }}b-delta-flat{{ end }}">
                            <i class="bi {{ if gt .Summary.Change 0.0 }}bi-arrow-up-short{{ else if lt .Summary.Change 0.0 }}bi-arrow-down-short{{ else }}bi-dash{{ end }}"></i>{{ .Summary.Delta | fmtPercent }}
                        </span>
                    {{ else }}
                        <span class="b-delta b-delta-flat">No {{ .Summary.Type.ValueNoun }} yet</span>
                    {{ end }}
                </div>
            </div>
        </div>
    </div>

    {{ if .Summary.Type.Liability }}
    <!-- Repayments: the terms, and where they lead -->
    <div class="b-card b-card-pad mb-3 b-accent-clay">
        <div class="b-card-head">
            <div>
                <h3 class="b-card-title">Repayments</h3>
                <p class="b-card-sub">
                    {{ with .Summary.Outlook }}
                        {{ if not .Known }}
                            Add the interest rate and what you repay to see when it will be paid off.
                        {{ else if .Never }}
                            At this rate the repayment does not cover the interest
                            ({{ .InterestFirst | fmtCurrency }} a repayment), so the debt is not shrinking.
                        {{ else }}
                            Paid off in <strong>{{ .Repayments }} repayment{{ if ne .Repayments 1 }}s{{ end }}</strong>,
                            around <strong>{{ .PaidOffBy.Format "Jan 2006" }}</strong>,
                            with about <strong>{{ .InterestLeft | fmtCurrency }}</strong> of interest still to pay.
                        {{ end }}
                    {{ end }}
                </p>
            </div>
        </div>
        <form hx-post="/portfolio/assets/{{ .Summary.Asset.Id }}/terms" hx-target="#main" hx-swap="innerHTML">
            <div class="row g-2">
                <div class="col-12 col-md-3">
                    <label class="b-field-label" for="terms-rate">Interest rate</label>
                    <div class="input-group">
                        <input id="terms-rate" name="interest_rate" type="number" class="form-control"
                               min="0" step="0.01" placeholder="0.00"
                               value="{{ if gt .Summary.Asset.InterestRate 0.0 }}{{ .Summary.Asset.InterestRate }}{{ end }}">
                        <span class="input-group-text">% p.a.</span>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <label class="b-field-label" for="terms-repayment">Repayment</label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input id="terms-repayment" name="repayment" type="number" class="form-control"
                               min="0" step="0.01" placeholder="0.00"
                               value="{{ if gt .Summary.Asset.Repayment 0.0 }}{{ .Summary.Asset.Repayment }}{{ end }}">
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <label class="b-field-label" for="terms-frequency">How often</label>
                    {{ $freq := .Summary.Asset.RepaymentFrequency }}
                    <select id="terms-frequency" name="repayment_frequency" class="form-select">
                        <option value="weekly" {{ if eq $freq "weekly" }}selected{{ end }}>Weekly</option>
                        <option value="fortnightly" {{ if eq $freq "fortnightly" }}selected{{ end }}>Fortnightly</option>
                        <option value="monthly" {{ if or (eq $freq "monthly") (eq $freq "") }}selected{{ end }}>Monthly</option>
                    </select>
                </div>
                <div class="col-12 col-md-3 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">Save</button>
                </div>
            </div>
        </form>
    </div>
    {{ end }}

    <!-- Value over time -->
    <div class="b-card b-card-pad mb-3 b-accent-slate">
        <div class="b-card-head">
            <div>
                <h3 class="b-card-title">{{ if eq .Summary.Type.ValueNoun "balance" }}Balance{{ else }}Value{{ end }} over time</h3>
                <p class="b-card-sub">{{ .Summary.Type.PriceLabel }}, then every {{ .Summary.Type.ValueNoun }} you have recorded</p>
            </div>
        </div>

        {{ if gt (len .Series.Data) 1 }}
            <div class="b-chart b-chart-tall">
                <canvas id="assetChart" hx-preserve="true"></canvas>
            </div>
        {{ else }}
            <div class="b-empty">
                <i class="bi bi-graph-up"></i>
                <h4>Not enough to chart</h4>
                <p>Record a valuation below and the curve will start from what you paid.</p>
            </div>
        {{ end }}
    </div>

    <!-- Record a valuation -->
    <div class="b-card b-card-pad mb-3">
        <div class="b-card-head">
            <div>
                <h3 class="b-card-title">Record a {{ .Summary.Type.ValueNoun }}</h3>
                <p class="b-card-sub">
                    {{ if .Summary.Type.Liability }}
                        What is still owed, as of the date, from a statement or the lender's app.
                        {{ if gt .Summary.Asset.Repayment 0.0 }}The balance is worked forward from here by the repayments, so this is only needed to correct it.{{ end }}
                    {{ else if eq .Summary.Asset.Type "investment" }}
                        The balance from your provider's app or statement.
                    {{ else }}
                        A rateable value, an agent's appraisal or your own estimate.
                    {{ end }}
                </p>
            </div>
            {{ if .Summary.Asset.Trackable }}
                <!-- The refresh icon is the indicator. A separate spinner element
                     hides with opacity, so it holds its space and leaves a gap in
                     the button whether or not anything is loading. -->
                <button class="btn btn-sm btn-primary flex-shrink-0"
                        hx-post="/portfolio/assets/{{ .Summary.Asset.Id }}/estimate"
                        hx-target="#main" hx-swap="innerHTML"
                        hx-disabled-elt="this">
                    <i class="bi bi-arrow-repeat"></i> Fetch estimate
                </button>
            {{ end }}
        </div>

        {{ if .Summary.Asset.Trackable }}
            <p class="b-card-sub mb-3">
                Fetching reads the current homes.co.nz estimate, which is rounded to
                the nearest ten thousand.
            </p>
        {{ end }}

        <form hx-post="/portfolio/assets/{{ .Summary.Asset.Id }}/valuations"
              hx-target="#main" hx-swap="innerHTML">
            <div class="row g-2">
                <div class="col-6 col-md-3">
                    <label class="b-field-label" for="valuation-value">{{ .Summary.Type.ValueLabel }}</label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input id="valuation-value" name="value" type="number" class="form-control"
                               min="0" step="0.01" placeholder="0.00" required>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <label class="b-field-label" for="valuation-date">Date</label>
                    <input id="valuation-date" name="date" type="date" class="form-control"
                           value="{{ .Today }}">
                </div>
                <div class="col-12 col-md-4">
                    <label class="b-field-label" for="valuation-note">Source</label>
                    <input id="valuation-note" name="note" type="text" class="form-control"
                           placeholder="{{ if eq .Summary.Type.ValueNoun "balance" }}e.g. Statement, app{{ else }}e.g. Council RV, agent appraisal{{ end }}">
                </div>
                <div class="col-12 col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-plus-lg"></i> Add
                    </button>
                </div>
            </div>
        </form>
    </div>

    <!-- Valuation history -->
    {{ if .History }}
        <div class="b-card mb-3">
            <div class="b-conn">
                <h3 class="b-conn-name">{{ if eq .Summary.Type.ValueNoun "balance" }}Balance{{ else }}Valuation{{ end }} history</h3>
                <div class="b-conn-total">{{ len .History }}</div>
            </div>
            <ul class="b-acct-list">
                {{ range .History }}
                    <li>
                        <div class="b-acct b-acct-static">
                            <span class="b-chip b-chip-sm b-accent-slate"><i class="bi bi-tag"></i></span>
                            <div class="b-acct-body">
                                <div class="b-acct-name">{{ .Value | fmtCurrency }}</div>
                                <div class="b-acct-meta">
                                    <span>{{ .Date.Format "2 Jan 2006" }}</span>
                                    {{ if .Note }}<span class="badge-category">{{ .Note }}</span>{{ end }}
                                </div>
                            </div>
                            <button class="btn btn-sm btn-link text-danger p-0"
                                    hx-delete="/portfolio/assets/{{ $.Summary.Asset.Id }}/valuations/{{ .ID }}"
                                    hx-target="#main" hx-swap="innerHTML"
                                    hx-confirm="Remove this valuation?"
                                    title="Remove valuation" aria-label="Remove this valuation">
                                <i class="bi bi-x-circle"></i>
                            </button>
                        </div>
                    </li>
                {{ end }}
            </ul>
        </div>
    {{ end }}

    <div class="text-end mb-3">
        <button class="btn btn-sm btn-outline-secondary"
                hx-delete="/portfolio/assets/{{ .Summary.Asset.Id }}"
                hx-target="#main" hx-swap="innerHTML"
                hx-confirm="Remove {{ .Summary.Asset.Name }} and all its valuations?">
            <i class="bi bi-trash"></i> Remove asset
        </button>
    </div>

    <script>
        (function () {
            const canvas = document.getElementById("assetChart");
            if (!canvas || typeof Chart === "undefined") {
                return;
            }

            const labels = {{ .Series.Labels }};
            const data = {{ .Series.Data }};

            const existing = Chart.getChart(canvas);
            if (existing) {
                existing.data.labels = labels;
                existing.data.datasets[0].data = data;
                existing.update("none");
                return;
            }

            const ink = window.budge ? window.budge.ink : '#78858f';

            new Chart(canvas, {
                type: "line",
                data: {
                    labels: labels,
                    datasets: [{
                        label: "Value",
                        data: data,
                        borderColor: window.budge ? window.budge.primary : "#3d6b8f",
                        backgroundColor: "rgba(61, 107, 143, 0.10)",
                        pointBackgroundColor: window.budge ? window.budge.primary : "#3d6b8f",
                        pointRadius: 3,
                        borderWidth: 2,
                        fill: true,
                        tension: 0.25
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    animation: false,
                    scales: {
                        y: {
                            // A valuation curve is read for its shape, so the axis
                            // frames the range rather than starting at zero.
                            beginAtZero: false,
                            border: {display: false},
                            grid: {color: window.budge ? window.budge.grid : "#e6ecf0"},
                            ticks: {color: ink, callback: v => "$" + v.toLocaleString()}
                        },
                        x: {
                            border: {display: false},
                            grid: {display: false},
                            ticks: {color: ink, maxRotation: 0, autoSkipPadding: 8}
                        }
                    },
                    plugins: {
                        legend: {display: false},
                        tooltip: {
                            callbacks: {
                                label: ctx => "$" + ctx.parsed.y.toLocaleString(undefined, {minimumFractionDigits: 2})
                            }
                        }
                    }
                }
            });
        })();
    </script>

{{ end }}
