{{ define "asset" }}

    {{ $kind := .Summary.TypeLabel }}
    {{ with .Summary.Asset.Description }}{{ $kind = printf "%s · %s" $kind . }}{{ end }}
    {{ template "pageHead" (dict "Title" .Summary.Asset.Name "Sub" $kind "Chip" .Summary.Icon
        "Accent" (or (and (lt .Summary.Change 0.0) "brick") "sage")
        "Back" "/portfolio" "BackLabel" "Back to portfolio") }}

    <div class="row g-2 g-md-3 mb-3">
        <div class="col-12 col-md-4">
            {{ $valued := "Still at the purchase price" }}
            {{ if .Summary.Valued }}{{ $valued = printf "Valued %s" (.Summary.LastDate.Format "2 Jan 2006") }}{{ end }}
            {{ template "stat" (dict "Label" "Current Value" "Icon" "bi-cash-stack" "Accent" "slate"
                "Value" (fmtCurrency .Summary.Current) "Note" $valued) }}
        </div>

        {{/* What was paid stays written out: its edit popover is a form, which
             a stat's dict cannot carry. */}}

        <div class="col-6 col-md-4">
            <div class="b-stat b-accent-clay">
                <div class="b-stat-label"><span>Paid</span><i class="bi bi-receipt"></i></div>
                <div class="b-stat-value">{{ .Summary.Asset.PurchasePrice | fmtCurrency }}</div>
                <div class="d-flex align-items-center justify-content-between gap-2">
                    <div class="b-delta-note">
                        {{ if not .Summary.Asset.PurchaseDate.IsZero }}
                            {{ .Summary.Asset.PurchaseDate.Format "Jan 2006" }}
                        {{ end }}
                    </div>
                    <details class="b-txmem">
                        <summary class="b-txmem-toggle" title="Edit what was paid" aria-label="Edit the purchase price and date">
                            <i class="bi bi-pencil"></i>
                        </summary>
                        <form class="b-tl-form b-txmem-form"
                              hx-post="/portfolio/assets/{{ .Summary.Asset.Id }}/purchase"
                              hx-target="#main" hx-swap="innerHTML">
                            <div class="b-txmem-head">What you paid</div>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text">$</span>
                                <input name="purchase_price" type="number" class="form-control" min="0" step="0.01"
                                       aria-label="Purchase price" required
                                       value="{{ printf "%.2f" .Summary.Asset.PurchasePrice }}">
                            </div>
                            <input name="purchase_date" type="date" class="form-control form-control-sm"
                                   aria-label="Purchase date" required
                                   {{ if not .Summary.Asset.PurchaseDate.IsZero }}value="{{ .Summary.Asset.PurchaseDate.Format "2006-01-02" }}"{{ end }}>
                            <button class="btn btn-sm btn-primary">Save</button>
                        </form>
                    </details>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-4">
            {{ $lost := lt .Summary.Change 0.0 }}
            {{ $tone := "" }}
            {{ if $lost }}{{ $tone = "text-danger" }}{{ else if gt .Summary.Change 0.0 }}{{ $tone = "text-success" }}{{ end }}
            {{ $change := dict "Note" "No valuation yet" }}
            {{ if .Summary.Valued }}
                {{ $change = dict "Value" .Summary.Change "Text" (fmtPercent .Summary.Delta) "UpIsGood" true
                    "Title" (printf "%s against the %s paid" (fmtCurrency .Summary.Change) (fmtCurrency .Summary.Asset.PurchasePrice)) }}
            {{ end }}
            {{ template "stat" (dict "Label" (or (and $lost "Loss") "Gain") "Icon" "bi-graph-up-arrow"
                "Accent" (or (and $lost "brick") "sage")
                "Value" (fmtCurrencyAbs .Summary.Change) "Tone" $tone "Delta" $change) }}
        </div>
    </div>

    <!-- Value over time -->
    <div class="b-card b-card-pad mb-3 b-accent-slate">
        {{ template "cardHead" (dict "Title" "Value over time" "Sub" "Purchase price, then every valuation you have recorded") }}

        {{ if gt (len .Series.Data) 1 }}
            <div class="b-chart b-chart-tall">
                <canvas id="assetChart" hx-preserve="true"></canvas>
            </div>
        {{ else }}
            {{ template "empty" (dict "Icon" "bi-graph-up" "Title" "Not enough to chart" "Text" "Record a valuation below and the curve will start from what you paid.") }}
        {{ end }}
    </div>

    <!-- Record a valuation -->
    <div class="b-card b-card-pad mb-3">
        <div class="b-card-head">
            {{ template "cardTitle" (dict "Title" "Record a valuation" "Sub" "A rateable value, an agent's appraisal or your own estimate.") }}
            {{ if .Summary.Asset.Trackable }}
                <!-- The refresh icon is the indicator. A separate spinner element
                     hides with opacity, so it holds its space and leaves a gap in
                     the button whether or not anything is loading. -->
                <button class="btn btn-sm btn-primary flex-shrink-0"
                        hx-post="/portfolio/assets/{{ .Summary.Asset.Id }}/estimate"
                        hx-target="#main" hx-swap="innerHTML"
                        hx-disabled-elt="this">
                    <i class="bi bi-arrow-repeat"></i> Fetch estimate
                </button>
            {{ end }}
        </div>

        {{ if .Summary.Asset.Trackable }}
            <p class="b-card-sub mb-3">
                Fetching reads the current homes.co.nz estimate, which is rounded to
                the nearest ten thousand.
            </p>
        {{ end }}

        <form hx-post="/portfolio/assets/{{ .Summary.Asset.Id }}/valuations"
              hx-target="#main" hx-swap="innerHTML">
            <div class="row g-2">
                <div class="col-6 col-md-3">
                    <label class="b-field-label" for="valuation-value">Value</label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input id="valuation-value" name="value" type="number" class="form-control"
                               min="0" step="0.01" placeholder="0.00" required>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <label class="b-field-label" for="valuation-date">Date</label>
                    <input id="valuation-date" name="date" type="date" class="form-control"
                           value="{{ .Today }}">
                </div>
                <div class="col-12 col-md-6">
                    <label class="b-field-label" for="valuation-note">Source</label>
                    <input id="valuation-note" name="note" type="text" class="form-control"
                           placeholder="e.g. Council RV, agent appraisal">
                </div>
                <div class="col-12 b-actions">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-plus-lg"></i> Add
                    </button>
                </div>
            </div>
        </form>
    </div>

    <!-- Valuation history -->
    {{ if .History }}
        <div class="b-card mb-3">
            {{ template "listHead" (dict "Title" "Valuation history" "Total" (printf "%d" (len .History))) }}
            <ul class="b-acct-list">
                {{ range .History }}
                    <li>
                        {{ template "listRow" (dict "Chip" "bi-tag" "ChipSm" true "ChipAccent" "slate"
                            "Title" (fmtCurrency .Value) "Badge" .Note "Meta" (.Date.Format "2 Jan 2006")
                            "Remove" (dict "URL" (printf "/portfolio/assets/%s/valuations/%s" $.Summary.Asset.Id .ID)
                                "Title" "Remove valuation" "Label" "Remove this valuation" "Confirm" "Remove this valuation?")) }}
                    </li>
                {{ end }}
            </ul>
        </div>
    {{ end }}

    <div class="b-actions mb-3">
        <button class="btn btn-sm btn-outline-danger"
                hx-delete="/portfolio/assets/{{ .Summary.Asset.Id }}"
                hx-target="#main" hx-swap="innerHTML"
                hx-confirm="Remove {{ .Summary.Asset.Name }} and all its valuations?">
            <i class="bi bi-trash"></i> Remove asset
        </button>
    </div>

    <script nonce="{{ nonce }}">
        window.budge.afterSwap(function () {
            const canvas = document.getElementById("assetChart");
            if (!canvas || typeof Chart === "undefined") {
                return;
            }

            const labels = {{ .Series.Labels }};
            const data = {{ .Series.Data }};

            const existing = Chart.getChart(canvas);
            if (existing) {
                existing.data.labels = labels;
                existing.data.datasets[0].data = data;
                existing.update("none");
                return;
            }

            const ink = window.budge.ink;

            new Chart(canvas, {
                type: "line",
                data: {
                    labels: labels,
                    datasets: [{
                        label: "Value",
                        data: data,
                        borderColor: window.budge.primary,
                        backgroundColor: window.budge.primarySoft,
                        pointBackgroundColor: window.budge.primary,
                        pointRadius: 3,
                        borderWidth: 2,
                        fill: true,
                        tension: 0.25
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    animation: false,
                    scales: {
                        y: {
                            // A valuation curve is read for its shape, so the axis
                            // frames the range rather than starting at zero.
                            beginAtZero: false,
                            border: {display: false},
                            grid: {color: window.budge.grid},
                            ticks: {color: ink, callback: v => "$" + v.toLocaleString()}
                        },
                        x: {
                            border: {display: false},
                            grid: {display: false},
                            ticks: {color: ink, maxRotation: 0, autoSkipPadding: 8}
                        }
                    },
                    plugins: {
                        legend: {display: false},
                        tooltip: {
                            callbacks: {
                                label: ctx => "$" + ctx.parsed.y.toLocaleString(undefined, {minimumFractionDigits: 2})
                            }
                        }
                    }
                }
            });
        });
    </script>

{{ end }}
