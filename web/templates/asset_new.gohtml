{{ define "asset_new" }}

    {{ if not .Chosen }}

        {{ template "pageHead" (dict "Title" "Add an asset" "Sub" "What are you tracking?"
            "Back" "/portfolio" "BackLabel" "Back to portfolio") }}

        <!-- Choosing the type first is what lets the next step ask only the
             questions that apply to it. -->
        <div class="row g-2 g-md-3">
            {{ range .Types }}
                <div class="col-12 col-md-4">
                    <a class="b-choice b-accent-{{ if eq .Key "house" }}sage{{ else if eq .Key "vehicle" }}clay{{ else }}slate{{ end }}"
                       href="/portfolio/new?type={{ .Key }}"
                       hx-boost="true" hx-target="#main">
                        <span class="b-chip"><i class="bi {{ .Icon }}"></i></span>
                        <span class="b-choice-body">
                            <span class="b-choice-name">{{ .Label }}</span>
                            <span class="b-choice-blurb">{{ .Blurb }}</span>
                        </span>
                        <i class="bi bi-chevron-right b-rank-go"></i>
                    </a>
                </div>
            {{ end }}
        </div>

    {{ else }}

        {{ with .Selected }}
            {{ $accent := "slate" }}
            {{ if eq .Key "house" }}{{ $accent = "sage" }}{{ else if eq .Key "vehicle" }}{{ $accent = "clay" }}{{ end }}
            {{ template "pageHead" (dict "Title" (printf "New %s" .Label) "Sub" .Blurb "Chip" .Icon "Accent" $accent
                "Back" "/portfolio/new" "BackLabel" "Choose a different type") }}

            <div class="b-card b-card-pad mb-3">
                <!-- The response is the portfolio, so the address bar should say
                     so: without this a refresh after saving reopens the wizard. -->
                <form hx-post="/portfolio/assets" hx-target="#main" hx-swap="innerHTML"
                      hx-push-url="/portfolio">
                    <input type="hidden" name="type" value="{{ .Key }}">

                    <div class="row g-2">
                        <div class="col-12">
                            <label class="b-field-label" for="asset-name">{{ .NameLabel }}</label>
                            <input id="asset-name" name="name" type="text" class="form-control"
                                   placeholder="{{ .NamePlaceholder }}" required
                                   {{ if .AddressLookup }}autocomplete="off" aria-describedby="asset-name-help"{{ end }}>
                            {{ if .AddressLookup }}
                                <input type="hidden" id="asset-homes-id" name="homes_property_id" value="">
                                <div id="asset-suggestions" class="b-suggest" hidden></div>
                                <div id="asset-name-help" class="b-delta-note mt-1">
                                    Pick a suggestion and estimates can be fetched for it.
                                </div>
                            {{ end }}
                        </div>

                        <div class="col-12 col-md-6">
                            {{ template "moneyInput" (dict "ID" "asset-price" "Label" "Purchase price" "Name" "purchase_price"
                                "Min" "0.01" "Required" true) }}
                        </div>

                        <div class="col-12 col-md-6">
                            {{ template "field" (dict "ID" "asset-date" "Label" "Purchase date" "Name" "purchase_date" "Type" "date"
                                "Value" $.Today "Required" true) }}
                        </div>

                        <div class="col-12">
                            {{ template "field" (dict "ID" "asset-description" "Label" .DetailLabel "Optional" true
                                "Name" "description" "Placeholder" .DetailPlaceholder) }}
                        </div>

                        <div class="col-12 b-actions mt-2">
                            <a href="/portfolio" class="btn btn-outline-secondary"
                               hx-boost="true" hx-target="#main">Cancel</a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-plus-lg"></i> Add {{ .Label | fmtLower }}
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        {{ end }}

        {{ if .Selected.AddressLookup }}
            <script nonce="{{ nonce }}">
                (function () {
                    const input = document.getElementById("asset-name");
                    const list = document.getElementById("asset-suggestions");
                    const hidden = document.getElementById("asset-homes-id");
                    if (!input || !list) {
                        return;
                    }

                    let timer = null;
                    let controller = null;

                    function hide() {
                        list.hidden = true;
                        list.innerHTML = "";
                    }

                    function render(suggestions) {
                        if (!suggestions || !suggestions.length) {
                            hide();
                            return;
                        }
                        list.innerHTML = "";
                        suggestions.forEach(function (suggestion) {
                            const option = document.createElement("button");
                            option.type = "button";
                            option.className = "b-suggest-item";
                            option.textContent = suggestion.address;
                            option.addEventListener("click", function () {
                                input.value = suggestion.address;
                                // Carry the property id through, so fetching an
                                // estimate later needs no second search.
                                if (hidden) {
                                    hidden.value = suggestion.propertyId || "";
                                }
                                hide();
                                input.focus();
                            });
                            list.appendChild(option);
                        });
                        list.hidden = false;
                    }

                    async function lookup(query) {
                        // Only one lookup is ever in flight: the earlier one is
                        // stale the moment another character is typed.
                        if (controller) {
                            controller.abort();
                        }
                        controller = new AbortController();
                        try {
                            const response = await fetch(
                                "/portfolio/address-suggest?q=" + encodeURIComponent(query),
                                {signal: controller.signal}
                            );
                            if (!response.ok) {
                                hide();
                                return;
                            }
                            render(await response.json());
                        } catch (err) {
                            // Aborting is the expected case while typing.
                            if (err.name !== "AbortError") {
                                hide();
                            }
                        }
                    }

                    input.addEventListener("input", function () {
                        const query = input.value.trim();
                        clearTimeout(timer);
                        // Typing a new address invalidates whichever one was picked.
                        if (hidden) {
                            hidden.value = "";
                        }
                        if (query.length < 3) {
                            hide();
                            return;
                        }
                        timer = setTimeout(function () { lookup(query); }, 250);
                    });

                    // Let a click on a suggestion land before the list disappears.
                    input.addEventListener("blur", function () { setTimeout(hide, 150); });
                    input.addEventListener("keydown", function (event) {
                        if (event.key === "Escape") { hide(); }
                    });
                })();
            </script>
        {{ end }}

    {{ end }}

{{ end }}
