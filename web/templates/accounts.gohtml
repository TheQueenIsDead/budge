{{ define "accounts" }}

    <div class="b-page-head">
        <h2>Portfolio</h2>
        {{ if .HasRefreshed }}
            <p class="b-page-sub"  data-bs-toggle="tooltip" data-bs-placement="bottom"
               title="{{ .LastRefreshed.Format "2 Jan 2006, 3:04pm" }}">
                <i class="bi bi-arrow-repeat"></i>
                Balances current as of {{ .LastRefreshed | fmtRelative }}
            </p>
        {{ end }}
    </div>

    {{ if or .Groups .AssetTotals.HasAsset }}

        <!-- Portfolio position -->
        <div class="row g-2 g-md-3 mb-3">
            <div class="col-12 col-md-4">
                <div class="b-stat b-accent-slate">
                    <div class="b-stat-label"><span>Net Worth</span><i class="bi bi-bank2"></i></div>
                    <div class="b-stat-value {{ if lt .Portfolio.NetWorth 0.0 }}text-danger{{ end }}">
                        {{ .Portfolio.NetWorth | fmtCurrency }}
                    </div>
                    <div class="b-delta-note">
                        Across {{ .Portfolio.Accounts }} account{{ if ne .Portfolio.Accounts 1 }}s{{ end }}{{ if gt .Portfolio.AssetCount 0 }}
                            and {{ .Portfolio.AssetCount }} asset{{ if ne .Portfolio.AssetCount 1 }}s{{ end }}{{ end }}
                    </div>
                </div>
            </div>

            <div class="col-6 col-md-4">
                <div class="b-stat b-accent-sage">
                    <div class="b-stat-label"><span>Assets</span><i class="bi bi-graph-up"></i></div>
                    <div class="b-stat-value text-success">{{ .Portfolio.Assets | fmtCurrency }}</div>
                    <div class="b-delta-note">
                        {{ if gt .Portfolio.Property 0.0 }}
                            Includes {{ .Portfolio.Property | fmtCurrency }} of assets
                        {{ else }}
                            What you hold
                        {{ end }}
                    </div>
                </div>
            </div>

            <div class="col-6 col-md-4">
                <div class="b-stat b-accent-brick">
                    <div class="b-stat-label"><span>Liabilities</span><i class="bi bi-graph-down"></i></div>
                    <div class="b-stat-value {{ if lt .Portfolio.Liabilities 0.0 }}text-danger{{ end }}">
                        {{ .Portfolio.Liabilities | fmtCurrency }}
                    </div>
                    <div class="b-delta-note">What you owe</div>
                </div>
            </div>
        </div>

        <!-- Accounts, grouped by the connection that provides them -->
        {{ range .Groups }}
            <div class="b-card mb-3">
                <div class="b-conn">
                    <img class="b-conn-logo" width="30" height="30"
                         src="{{ .Logo }}" alt="{{ .Connection }}"/>
                    <h3 class="b-conn-name">{{ .Connection }}</h3>
                    <div class="b-conn-total {{ if lt .Total 0.0 }}text-danger{{ end }}">
                        {{ .Total | fmtCurrency }}
                    </div>
                </div>

                <ul class="b-acct-list">
                    {{ range .Accounts }}
                        <li>
                            <!-- Without transactions the detail page has nothing to
                                 chart, so the row reports its balance and stops there
                                 rather than leading to an empty screen. -->
                            {{ if .HasTransactions }}
                            <a class="b-acct" href="/accounts/{{ .Account.Id }}"
                               hx-boost="true" hx-target="#main">
                            {{ else }}
                            <div class="b-acct b-acct-static">
                            {{ end }}

                                <span class="b-chip {{ if lt .Account.Balance.Current 0.0 }}b-accent-brick{{ else }}b-accent-slate{{ end }}">
                                    <i class="bi {{ .Icon }}"></i>
                                </span>

                                <div class="b-acct-body">
                                    <div class="b-acct-name">{{ .Account.Name }}</div>

                                    <div class="b-acct-meta">
                                        <span class="badge-category">{{ .TypeLabel }}</span>
                                        {{ if .Account.FormattedAccount }}
                                            <span class="font-monospace">{{ .Account.FormattedAccount }}</span>
                                        {{ end }}
                                        {{ if not .IsActive }}
                                            <span class="badge-error rounded-pill px-2">
                                                <i class="bi bi-exclamation-triangle"></i> {{ .Account.Status }}
                                            </span>
                                        {{ end }}
                                        {{ if .Account.Balance.Overdrawn }}
                                            <span class="badge-error rounded-pill px-2">Overdrawn</span>
                                        {{ end }}
                                    </div>

                                    {{ if .IsLoan }}
                                        <div class="b-acct-meta">
                                            {{ with .Account.Meta.LoanDetails.Interest }}
                                                {{ if gt .Rate 0.0 }}
                                                    <span>
                                                        <i class="bi bi-percent"></i>{{ printf "%.2f%%" .Rate }}
                                                        {{ if .Type }}{{ .Type | fmtTitle }}{{ end }}
                                                    </span>
                                                {{ end }}
                                            {{ end }}
                                            {{ with .Account.Meta.LoanDetails.Repayment }}
                                                {{ if gt .NextAmount 0.0 }}
                                                    <span>
                                                        <i class="bi bi-calendar-event"></i>
                                                        Next {{ .NextAmount | fmtCurrency }}
                                                        {{ if not .NextDate.IsZero }}on {{ .NextDate.Format "2 Jan" }}{{ end }}
                                                    </span>
                                                {{ end }}
                                            {{ end }}
                                        </div>
                                    {{ end }}
                                </div>

                                <div class="b-acct-figures">
                                    <div class="b-acct-balance {{ if lt .Account.Balance.Current 0.0 }}text-danger{{ end }}">
                                        {{ .Account.Balance.Current | fmtCurrency }}
                                    </div>
                                    {{ if .HasHistory }}
                                        <span class="b-delta {{ if gt .Change 0.0 }}b-delta-good{{ else if lt .Change 0.0 }}b-delta-bad{{ else }}b-delta-flat{{ end }}"
                                              data-bs-toggle="tooltip" data-bs-placement="left"
                                              title="{{ .Change | fmtCurrency }} over the last 30 days, from {{ .PreviousBalance | fmtCurrency }}">
                                            <i class="bi {{ if gt .Change 0.0 }}bi-arrow-up-short{{ else if lt .Change 0.0 }}bi-arrow-down-short{{ else }}bi-dash{{ end }}"></i>{{ .Delta | fmtPercent }}
                                        </span>
                                    {{ else }}
                                        <span class="b-delta b-delta-flat">No activity</span>
                                    {{ end }}
                                </div>

                                {{ if .HasTransactions }}
                                    <i class="bi bi-chevron-right b-rank-go d-none d-sm-block"></i>
                                </a>
                                {{ else }}
                                    <i class="bi bi-dash b-rank-go d-none d-sm-block"
                                       title="No transaction history to show"></i>
                                </div>
                                {{ end }}
                        </li>
                    {{ end }}
                </ul>
            </div>
        {{ end }}


        <!-- Assets. Tracked by hand rather than synced, but part of the same
             position, so they sit with the accounts rather than on a page of
             their own. -->
        {{ if .AssetTotals.HasAsset }}
            <div class="b-card mb-3">
                <div class="b-conn">
                    <span class="b-chip b-chip-sm b-accent-sage"><i class="bi bi-houses"></i></span>
                    <h3 class="b-conn-name">Assets</h3>
                    <div class="b-conn-total">{{ .AssetTotals.Total | fmtCurrency }}</div>
                </div>

                <ul class="b-acct-list">
                    {{ range .Assets }}
                        <li>
                            <a class="b-acct" href="/assets/{{ .Asset.Id }}"
                               hx-boost="true" hx-target="#main">
                                <span class="b-chip {{ if lt .Change 0.0 }}b-accent-brick{{ else }}b-accent-sage{{ end }}">
                                    <i class="bi {{ .Icon }}"></i>
                                </span>

                                <div class="b-acct-body">
                                    <div class="b-acct-name">{{ .Asset.Name }}</div>
                                    <div class="b-acct-meta">
                                        <span class="badge-category">{{ .TypeLabel }}</span>
                                        {{ if .Asset.Description }}<span>{{ .Asset.Description }}</span>{{ end }}
                                        {{ if .Valued }}
                                            <span><i class="bi bi-clock-history"></i> Valued {{ .LastDate | fmtRelative }}</span>
                                        {{ else }}
                                            <span><i class="bi bi-exclamation-circle"></i> Not valued since purchase</span>
                                        {{ end }}
                                    </div>
                                </div>

                                <div class="b-acct-figures">
                                    <div class="b-acct-balance">{{ .Current | fmtCurrency }}</div>
                                    {{ if .Valued }}
                                        <span class="b-delta {{ if gt .Change 0.0 }}b-delta-good{{ else if lt .Change 0.0 }}b-delta-bad{{ else }}b-delta-flat{{ end }}"
                                              data-bs-toggle="tooltip" data-bs-placement="left"
                                              title="{{ .Change | fmtCurrency }} against the {{ .Asset.PurchasePrice | fmtCurrency }} paid">
                                            <i class="bi {{ if gt .Change 0.0 }}bi-arrow-up-short{{ else if lt .Change 0.0 }}bi-arrow-down-short{{ else }}bi-dash{{ end }}"></i>{{ .Delta | fmtPercent }}
                                        </span>
                                    {{ else }}
                                        <span class="b-delta b-delta-flat">At cost</span>
                                    {{ end }}
                                </div>

                                <i class="bi bi-chevron-right b-rank-go d-none d-sm-block"></i>
                            </a>
                        </li>
                    {{ end }}
                </ul>
            </div>
        {{ end }}

    {{ else }}
        <div class="b-empty">
            <i class="bi bi-bank2"></i>
            <h4>Nothing here yet</h4>
            <p>Connect a provider to see your balances, or add an asset below.</p>
            <div class="mt-3">
                <a href="/settings" class="btn btn-outline-secondary" hx-boost="true" hx-target="#main">
                    Go to settings
                </a>
            </div>
        </div>
    {{ end }}

    {{ template "assets.form" . }}


{{ end }}
