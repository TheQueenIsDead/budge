{{define "settings"}}

    <div class="b-page-head">
        <h2>Settings</h2>
        <p class="b-page-sub">Connections, what runs by itself, and the buttons to be careful with.</p>
    </div>

    <!-- Akahu -->
    <div class="b-card b-card-pad mb-3 b-accent-slate">
        <div class="b-card-head">
            <div class="d-flex align-items-center gap-2">
                <span class="b-chip"><img src="{{ asset "/static/akahu.svg" }}" alt=""></span>
                <div>
                    <h3 class="b-card-title">Akahu</h3>
                    <p class="b-card-sub">
                        New Zealand's open finance platform, and where transaction data comes
                        from. <a href="https://www.akahu.nz/consumer">More about Akahu</a>.
                    </p>
                </div>
            </div>
        </div>

        <form>
            <div class="row g-2">
                <div class="col-12 col-md-6">
                    <label class="b-field-label" for="akahuAppToken">App token</label>
                    <div class="input-group input-group-sm" x-data="{ shown: false }">
                        <input class="form-control" id="akahuAppToken" name="akahuAppToken"
                               {{ if .akahuAppTokenSaved }}placeholder="Saved — leave blank to keep"{{ end }} type="password" autocomplete="off" :type="shown ? 'text' : 'password'">
                        <button type="button" class="btn btn-outline-secondary" id="toggleAppToken" @click="shown = !shown"
                                :aria-pressed="shown" aria-label="Show the app token">
                            <i class="bi bi-eye-fill" :class="{ 'bi-eye-fill': !shown, 'bi-eye-slash-fill': shown }"></i>
                        </button>
                    </div>
                </div>

                <div class="col-12 col-md-6">
                    <label class="b-field-label" for="akahuUserToken">User token</label>
                    <div class="input-group input-group-sm" x-data="{ shown: false }">
                        <input class="form-control" id="akahuUserToken" name="akahuUserToken"
                               {{ if .akahuUserTokenSaved }}placeholder="Saved — leave blank to keep"{{ end }} type="password" autocomplete="off" :type="shown ? 'text' : 'password'">
                        <button type="button" class="btn btn-outline-secondary" id="toggleUserToken" @click="shown = !shown"
                                :aria-pressed="shown" aria-label="Show the user token">
                            <i class="bi bi-eye-fill" :class="{ 'bi-eye-fill': !shown, 'bi-eye-slash-fill': shown }"></i>
                        </button>
                    </div>
                </div>

                <div class="col-12 d-flex align-items-center flex-wrap gap-2 mt-2">
                    <button class="btn btn-outline-secondary btn-sm" hx-post="/integrations/akahu/save"
                            hx-disabled-elt="this" hx-swap="none">
                        Save tokens
                    </button>

                    {{ template "settings.integrations.sync" .sync }}
                </div>
            </div>
        </form>
    </div>

    <!-- What runs by itself -->
    <div id="schedule">{{ template "settings.schedule" .schedule }}</div>

    <!-- Categories, and the rules that file transactions under them -->
    {{ template "settings.categories" .categories }}

    <!-- Connected accounts -->
    <div class="b-card mb-3" id="accounts">
        <div class="b-conn">
            <span class="b-chip b-chip-sm b-accent-slate"><i class="bi bi-bank2"></i></span>
            <h3 class="b-conn-name">Connected accounts</h3>
            <div class="b-conn-total">{{ len .accounts }}</div>
        </div>

        {{ if .accounts }}
            <ul class="b-acct-list">
                {{ range .accounts }}
                    <li>
                        <div class="b-acct b-acct-static">
                            <img class="b-conn-logo" width="30" height="30"
                                 src="{{ .Connection.Logo }}" alt="{{ .Connection.Name }}"/>
                            <div class="b-acct-body">
                                <div class="b-acct-name">{{ .Name }}</div>
                                <div class="b-acct-meta">
                                    <span class="badge-category">{{ .Connection.Name }}</span>
                                    {{ if .FormattedAccount }}
                                        <span class="font-monospace">{{ .FormattedAccount }}</span>
                                    {{ end }}
                                    {{ with .Meta.LoanDetails.Interest }}
                                        {{ if gt .Rate 0.0 }}
                                            <span><i class="bi bi-percent"></i>{{ printf "%.2f%%" .Rate }}
                                                {{ if .Type }}{{ .Type | fmtTitle }}{{ end }}</span>
                                        {{ end }}
                                    {{ end }}
                                </div>
                            </div>
                            <div class="b-acct-figures">
                                <div class="b-acct-balance {{ if lt .Balance.Current 0.0 }}text-danger{{ end }}">
                                    {{ .Balance.Current | fmtCurrency }}
                                </div>
                                <span class="b-delta b-delta-flat">{{ .Type | fmtTitle }}</span>
                            </div>
                        </div>
                    </li>
                {{ end }}
            </ul>
        {{ else }}
            <div class="b-card-pad">
                <div class="b-empty">
                    <i class="bi bi-bank2"></i>
                    <h4>Nothing connected</h4>
                    <p>Save your Akahu tokens above, then sync.</p>
                </div>
            </div>
        {{ end }}
    </div>

    <!-- Backup. Moving to another instance takes what was set up by hand;
         synced data comes back from Akahu on the first sync there. -->
    <div class="b-card b-card-pad mb-3 b-accent-sage" id="backup">
        <div class="b-card-head">
            <div class="d-flex align-items-center gap-2">
                <span class="b-chip"><i class="bi bi-box-arrow-down"></i></span>
                <div>
                    <h3 class="b-card-title">Backup</h3>
                    <p class="b-card-sub">
                        Memories, hidden purchases, assets, budget, category rules and schedule, for moving to
                        another instance. Accounts and transactions come back from Akahu.
                    </p>
                </div>
            </div>
        </div>

        <!-- Side by side once there is room, the way the schedule's options sit. -->
        <div class="row g-3">
            <div class="col-12 col-md-6">
                <div class="b-sched">
                    <div class="fw-semibold">Export</div>
                    <!-- A plain form: the response is a file to save, not a page to swap. -->
                    <p class="b-card-sub mb-2">
                        Akahu tokens are not included, so the file is safe to keep. Enter them again on
                        the new instance, then sync.
                    </p>
                    <form action="/settings/backup" method="get">
                        <button class="btn btn-outline-secondary btn-sm"><i class="bi bi-download"></i>Download</button>
                    </form>
                </div>
            </div>
            <div class="col-12 col-md-6">
                <div class="b-sched">
                    <div class="fw-semibold">Import</div>
                    <p class="b-card-sub mb-2">
                        Adds a backup to what is here. Anything in both is replaced by the backup's
                        copy; nothing else is removed.
                    </p>
                    <form hx-post="/settings/backup" hx-encoding="multipart/form-data" hx-target="#main"
                          hx-confirm="Import this backup into this instance?"
                          class="d-flex flex-wrap align-items-center gap-2">
                        <input class="form-control form-control-sm w-auto" type="file" name="backup"
                               accept="application/json,.json" required aria-label="Backup file">
                        <button class="btn btn-outline-secondary btn-sm"><i class="bi bi-upload"></i>Import</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Admin, when telemetry is running to fill it -->
    {{ if .admin }}
    <a class="b-card b-card-pad mb-3 b-accent-plum d-block text-reset text-decoration-none" id="admin"
       href="/admin" hx-boost="true" hx-target="#main">
        <div class="b-card-head mb-0">
            <div class="d-flex align-items-center gap-2">
                <span class="b-chip"><i class="bi bi-activity"></i></span>
                <div>
                    <h3 class="b-card-title">Admin</h3>
                    <p class="b-card-sub">
                        Uptime, CPU and memory, request and query timings, logs and errors, as
                        budge has recorded them since it started.
                    </p>
                </div>
            </div>
            <i class="bi bi-chevron-right text-muted"></i>
        </div>
    </a>
    {{ end }}

    <!-- Danger -->
    <div class="b-card b-card-pad mb-3 b-accent-brick" id="danger">
        <div class="b-card-head">
            <div class="d-flex align-items-center gap-2">
                <span class="b-chip"><i class="bi bi-exclamation-octagon"></i></span>
                <div>
                    <h3 class="b-card-title">Danger</h3>
                    <p class="b-card-sub">These cannot be undone once performed.</p>
                </div>
            </div>
        </div>

        <div class="b-sched">
            <div class="fw-semibold">Remove all synced data</div>
            <p class="b-card-sub mb-2">
                Drops every transaction, merchant and account. Assets and budget targets are
                left alone, and a sync repopulates the rest.
            </p>
            <button class="btn btn-outline-danger btn-sm"
                    hx-post="/settings/danger/remove/synced"
                    hx-confirm="Remove all synced data?">
                Remove all synced data
            </button>
        </div>
    </div>

{{ end }}

{{/* The sync button and what it is doing. While a sync runs in the background
     this polls itself once a second; the finished view leaves the trigger out,
     which is what stops the polling. display: contents keeps the button and
     the status in the row around them. */}}
{{ define "settings.integrations.sync" }}
<div id="akahu-sync" class="b-contents"
     {{ if .Running }}hx-get="/integrations/akahu/sync?started={{ .StartedKey }}"
     hx-trigger="every 1s" hx-swap="outerHTML" hx-target="this"{{ end }}>
    {{ if .Running }}
        <button type="button" class="btn btn-primary btn-sm htmx-request" disabled>
            <i class="bi bi-arrow-repeat"></i> Syncing&hellip;
        </button>
        <span class="b-delta-note ms-auto">
            {{ if .Fetched }}Fetched {{ .Fetched }} transactions&hellip;{{ else }}Contacting Akahu&hellip;{{ end }}
        </span>
    {{ else }}
        <button type="button" class="btn btn-primary btn-sm" hx-post="/integrations/akahu/sync"
                hx-target="#akahu-sync" hx-swap="outerHTML" hx-disabled-elt="this">
            <i class="bi bi-arrow-repeat"></i> Sync now
        </button>
        <span class="b-delta-note ms-auto">
            {{ if .Error }}<span class="text-danger">Last sync failed.</span>{{ end }}
            {{ if .LastSync.IsZero }}Never synced{{ else }}Last sync {{ .LastSync | fmtRelative }}{{ end }}
            {{ if not .LastSync.IsZero }}
                &middot;
                <button type="button" class="btn btn-link btn-sm p-0 align-baseline b-delta-note"
                        hx-post="/integrations/akahu/resync" hx-target="#akahu-sync" hx-swap="outerHTML"
                        title="Download every transaction again, correcting how older ones were classified">
                    Re-read full history
                </button>
            {{ end }}
        </span>
    {{ end }}
</div>
{{ end }}

{{ define "settings.categories" }}
{{/* One swap target for every category and rule, so a rule's counts and the
     category it lands in are always current after a change. It is morphed
     rather than replaced: only what changed is touched, so the page stays
     put, the button pressed keeps its focus, and categories opened by hand
     stay open. Repeated items carry a key, so morphing matches them up. */}}
<div id="categories">
{{ if .Error }}
<div class="alert alert-warning py-2 small mb-3" role="alert">{{ .Error }}</div>
{{ end }}

<div class="b-card b-card-pad mb-3 b-accent-clay">
    <div class="b-card-head">
        <div class="d-flex align-items-center gap-2">
            <span class="b-chip"><i class="bi bi-tags"></i></span>
            <div>
                <h3 class="b-card-title">Categories</h3>
                <p class="b-card-sub">
                    Every transaction is filed under one of these. Akahu's categories file most of
                    it automatically, and rules catch what they miss: the first rule that matches
                    wins. Open a category to see its rules, or to add one.
                </p>
            </div>
        </div>
    </div>

    <datalist id="rule-suggestions">
        {{ range .Suggestions }}<option value="{{ . }}"></option>{{ end }}
    </datalist>

    {{ $types := .Types }}
    {{ $root := . }}
    {{ range .Groups }}
        <div class="b-field-label mt-3">{{ .Label }}</div>
        <div class="b-pv-list">
            {{ range .Categories }}
                {{ $key := .Key }}
                {{/* The heading follows the fields below as they change, before the
                     change is saved, so an edit shows the moment it is made. The
                     colour is swapped rather than added to: the accent classes
                     all set the same variables, so two at once left whichever
                     came later in the stylesheet, and muted, a new category's
                     colour, comes last. */}}
                <details class="b-pv-cat b-accent-{{ .Accent }}" id="category-{{ .Key }}"{{ if .Open }} open{{ end }} key="{{ .Key }}"
                         x-data='{{ .State | toJSON }}'
                         x-effect="[...$el.classList].filter(c => c.startsWith('b-accent-')).forEach(c => $el.classList.remove(c)); $el.classList.add('b-accent-' + accent)">
                    <summary class="b-pv-row">
                        <span class="b-chip b-chip-sm"><i class="bi {{ .Icon }}" x-effect="$el.className = 'bi ' + icon"></i></span>
                        <div class="b-pv-body">
                            <div class="fw-semibold" x-text="label">{{ .Label }}</div>
                            {{ if .Subs }}
                                <div class="b-delta-note text-truncate">{{ range $i, $sub := .Subs }}{{ if $i }} · {{ end }}{{ $sub.Label }}{{ end }}</div>
                            {{ else }}
                                <div class="b-delta-note text-truncate" x-text="blurb">{{ .Blurb }}</div>
                            {{ end }}
                        </div>
                        <div class="b-pv-figures b-delta-note">
                            {{ if .Rules }}<div>{{ len .Rules }} rule{{ if ne (len .Rules) 1 }}s{{ end }}</div>{{ end }}
                            <div>{{ .Count }} transaction{{ if ne .Count 1 }}s{{ end }}</div>
                        </div>
                        <i class="bi bi-chevron-down b-target-chev"></i>
                    </summary>

                    <div class="b-cat-body">
                        {{ template "settings.category.details" (dict "Category" . "Root" $root) }}
                        {{ template "settings.category.subs" . }}

                        <div class="b-cat-section">
                        <div class="b-cat-section-title">Rules</div>
                        {{ if .Rules }}
                            <ol class="list-unstyled mb-3">
                                {{ range .Rules }}
                                <li class="d-flex align-items-start justify-content-between gap-2 py-2 border-bottom" key="{{ .ID }}">
                                    <div class="min-width-0">
                                        <div>
                                            Contains <span class="font-monospace">“{{ .Contains }}”</span>
                                            {{ if .Type }}<span class="text-muted">and type is</span> <span class="badge-category">{{ .Type }}</span>{{ end }}
                                            {{ if or .AtLeast .AtMost }}<span class="text-muted">and is</span> <span class="badge-category">
                                                {{- if and .AtLeast .AtMost }}{{ .AtLeast | fmtCurrency }} to {{ .AtMost | fmtCurrency }}
                                                {{- else if .AtLeast }}{{ .AtLeast | fmtCurrency }} or more
                                                {{- else }}up to {{ .AtMost | fmtCurrency }}{{ end -}}
                                            </span>{{ end }}
                                            {{ if .IncludeTransfers }}<span class="badge-category" title="Counts money leaving by transfer as spending">incl. transfers</span>{{ end }}
                                        </div>
                                        <div class="small">
                                            {{ if .Into }}<i class="bi bi-arrow-return-right text-muted" aria-hidden="true"></i> {{ .Into }}{{ end }}
                                            <span class="{{ if .Matches }}text-muted{{ else }}text-warning{{ end }}{{ if .Into }} ms-1{{ end }}">
                                                {{ if .Into }}· {{ end }}{{ .Matches }} transaction{{ if ne .Matches 1 }}s{{ end }}
                                            </span>
                                        </div>
                                    </div>
                                    <button type="button" class="btn btn-link btn-sm p-0 text-danger flex-shrink-0"
                                            hx-delete="/settings/rules/{{ .ID }}"
                                            hx-target="#categories" hx-swap="morph"
                                            title="Delete rule" aria-label="Delete the rule for {{ .Contains }}">
                                        <i class="bi bi-x-circle" aria-hidden="true"></i>
                                    </button>
                                </li>
                                {{ end }}
                            </ol>
                        {{ end }}

                        {{ if eq .Key "uncategorised" }}
                            <p class="b-card-sub mb-0">
                                Anything nothing else files lands here.
                                <a href="/transactions?uncategorised=1" hx-boost="true" hx-target="#main">File the recent ones</a>,
                                or add a rule to the category they belong in.
                            </p>
                        {{ else }}
                            <form hx-post="/settings/rules" hx-target="#categories" hx-swap="morph" class="row g-2 align-items-end"
                                  key="add-rule-{{ .Key }}" hx-on::after-request="if (event.detail.successful) this.reset()">
                                <div class="col-12 col-md-5">
                                    <label class="b-field-label" for="rule-contains-{{ .Key }}">Description or merchant contains</label>
                                    <input class="form-control form-control-sm" id="rule-contains-{{ .Key }}" name="contains"
                                           list="rule-suggestions" autocomplete="off"
                                           placeholder="e.g. LOAN INTEREST" required>
                                </div>
                                <div class="col-6 col-md-3">
                                    <label class="b-field-label" for="rule-type-{{ .Key }}">Type</label>
                                    <select class="form-select form-select-sm" id="rule-type-{{ .Key }}" name="type">
                                        <option value="">Any</option>
                                        {{ range $types }}<option value="{{ . }}">{{ . | fmtTitle }}</option>{{ end }}
                                    </select>
                                </div>
                                <div class="col-6 col-md-4">
                                    {{ if gt (len .Options) 1 }}
                                        <label class="b-field-label" for="rule-category-{{ .Key }}">File under</label>
                                        <select class="form-select form-select-sm" id="rule-category-{{ .Key }}" name="category">
                                            {{ range .Options }}<option value="{{ .Key }}">{{ .Label }}</option>{{ end }}
                                        </select>
                                    {{ else }}
                                        {{/* One place to file: the category, or its only
                                             subcategory, said rather than picked. */}}
                                        {{ $only := index .Options 0 }}
                                        <input type="hidden" name="category" value="{{ $only.Key }}">
                                        {{ if ne $only.Key .Key }}<div class="b-delta-note pb-1">Files under {{ $only.Label }}</div>{{ end }}
                                    {{ end }}
                                </div>
                                {{/* For payments the text cannot tell apart, such as two
                                     policies paid to the same insurer. */}}
                                <div class="col-6 col-md-3">
                                    <label class="b-field-label" for="rule-atleast-{{ .Key }}">Amount at least</label>
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text">$</span>
                                        <input class="form-control" type="number" id="rule-atleast-{{ .Key }}" name="at_least"
                                               min="0" step="0.01" inputmode="decimal" placeholder="Any">
                                    </div>
                                </div>
                                <div class="col-6 col-md-3">
                                    <label class="b-field-label" for="rule-atmost-{{ .Key }}">Amount at most</label>
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text">$</span>
                                        <input class="form-control" type="number" id="rule-atmost-{{ .Key }}" name="at_most"
                                               min="0" step="0.01" inputmode="decimal" placeholder="Any">
                                    </div>
                                </div>
                                {{/* Re-rendered with the card, so its "from:" listeners always
                                     bind to the current inputs. hx-target is set here because it
                                     would otherwise inherit the form's, and replace the card. */}}
                                <div class="col-12" aria-live="polite"
                                     hx-get="/settings/rules/preview"
                                     hx-trigger="input changed delay:300ms from:#rule-contains-{{ .Key }}, change from:#rule-type-{{ .Key }}, change from:#rule-transfers-{{ .Key }}, input changed delay:300ms from:#rule-atleast-{{ .Key }}, input changed delay:300ms from:#rule-atmost-{{ .Key }}"
                                     hx-include="#rule-contains-{{ .Key }}, #rule-type-{{ .Key }}, #rule-transfers-{{ .Key }}, #rule-atleast-{{ .Key }}, #rule-atmost-{{ .Key }}"
                                     hx-target="this"
                                     hx-swap="innerHTML"></div>
                                <div class="col-12">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="rule-transfers-{{ .Key }}" name="include_transfers" value="1">
                                        <label class="form-check-label" for="rule-transfers-{{ .Key }}">
                                            Include transfers between your accounts
                                            <span class="d-block b-card-sub">
                                                For payments like a mortgage repayment into a loan account. Only the money
                                                leaving is counted as spending; where it arrives stays a transfer.
                                            </span>
                                        </label>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <button class="btn btn-outline-secondary btn-sm"><i class="bi bi-plus-lg"></i>Add rule</button>
                                </div>
                            </form>
                        {{ end }}
                        </div>

                        {{ template "settings.category.delete" . }}
                    </div>
                </details>
            {{ end }}
        </div>
    {{ end }}

    {{/* A new category starts on budget under a placeholder name, and opens
         ready to be named and dressed, just above the button. The page is
         left where it is: scrolling to the new category threw the reader to
         the bottom of the page. */}}
    <button type="button" class="btn btn-outline-secondary btn-sm mt-3"
            hx-post="/settings/budget-categories" hx-vals='{"label": "New category"}'
            hx-target="#categories" hx-swap="morph">
        <i class="bi bi-plus-lg"></i>New category
    </button>
</div>
</div>
{{ end }}

{{/* A category's name and look, each saved as it is changed: a field when it
     is left, a colour or icon when it is picked. Colour and icon are rows of
     choices, the chosen one ringed. */}}
{{ define "settings.category.details" }}
{{ $c := .Category }}
{{ $root := .Root }}
<form class="b-cat-section b-cat-details" hx-post="/settings/budget-categories/{{ $c.Key }}" hx-trigger="change" hx-swap="none">
    <div class="b-cat-section-title">Details</div>
    <div class="row g-2">
        <div class="col-12 col-md-4">
            <label class="b-field-label" for="cat-label-{{ $c.Key }}">Name</label>
            {{/* A name left blank goes back to the saved one. htmx won't post a
                 form with a required field empty, so without this the box and
                 heading stayed blank though nothing was saved. Saving doesn't
                 redraw the box, so each name saved becomes the one to go back to. */}}
            <input class="form-control form-control-sm" id="cat-label-{{ $c.Key }}" name="label" value="{{ $c.Label }}" x-model="label" required
                   @change="if ($el.value.trim()) $el.defaultValue = $el.value; else { $el.value = $el.defaultValue; label = $el.value }">
        </div>
        <div class="col-12 {{ if $c.Fixed }}col-md-8{{ else }}col-md-5{{ end }}">
            <label class="b-field-label" for="cat-blurb-{{ $c.Key }}">Description</label>
            <input class="form-control form-control-sm" id="cat-blurb-{{ $c.Key }}" name="blurb" value="{{ $c.Blurb }}" x-model="blurb">
        </div>
        {{ if not $c.Fixed }}
        {{/* Moving on or off budget moves the category to the other list, so
             this redraws the card. Each button posts its own value. */}}
        <div class="col-12 col-md-3">
            <span class="b-field-label">Budget</span>
            <div class="btn-group btn-group-sm w-100" role="group" aria-label="Whether {{ $c.Label }} is on budget">
                <button type="button" class="btn btn-outline-secondary{{ if $c.Budgeted }} active{{ end }}"
                        aria-pressed="{{ if $c.Budgeted }}true{{ else }}false{{ end }}"
                        hx-post="/settings/budget-categories/{{ $c.Key }}" hx-include="closest form"
                        hx-vals='{"budget": "on", "render": "card"}' hx-target="#categories" hx-swap="morph">On</button>
                <button type="button" class="btn btn-outline-secondary{{ if not $c.Budgeted }} active{{ end }}"
                        aria-pressed="{{ if $c.Budgeted }}false{{ else }}true{{ end }}"
                        hx-post="/settings/budget-categories/{{ $c.Key }}" hx-include="closest form"
                        hx-vals='{"budget": "off", "render": "card"}' hx-target="#categories" hx-swap="morph">Off</button>
            </div>
        </div>
        {{ end }}
        <div class="col-12 col-md-auto">
            <span class="b-field-label">Colour</span>
            <div class="b-pick-row">
                {{ range $root.Accents }}
                <label class="b-accent-pick b-accent-{{ . }}" title="{{ . }}">
                    <input type="radio" class="visually-hidden" name="accent" value="{{ . }}"{{ if eq . $c.Accent }} checked{{ end }} x-model="accent">
                    <span class="b-swatch"></span><span class="visually-hidden">{{ . }}</span>
                </label>
                {{ end }}
            </div>
        </div>
        <div class="col-12 col-md">
            <span class="b-field-label">Icon</span>
            <div class="b-pick-row">
                {{ range $root.Icons }}
                <label class="b-icon-pick" title="{{ . }}">
                    <input type="radio" class="visually-hidden" name="icon" value="{{ . }}"{{ if eq . $c.Icon }} checked{{ end }} x-model="icon">
                    <span class="b-chip b-chip-sm"><i class="bi {{ . }}"></i></span><span class="visually-hidden">{{ . }}</span>
                </label>
                {{ end }}
            </div>
        </div>
    </div>
</form>
{{ end }}

{{/* Subcategories, each renamed as it is typed or deleted in place, and a
     new one added. */}}
{{ define "settings.category.subs" }}
{{ $c := . }}
<div class="b-cat-section">
    <div class="b-cat-section-title">Subcategories</div>
    <div class="b-cat-subs">
        {{ range $c.Subs }}
        {{/* A rename redraws the card, so the category's heading names it. A
             name left blank goes back to the saved one, as the category's does. */}}
        <form class="input-group input-group-sm" hx-post="/settings/budget-categories/{{ .Key }}" hx-trigger="change"
              hx-vals='{"render": "card"}' hx-target="#categories" hx-swap="morph" key="{{ .Key }}">
            <input class="form-control" name="label" value="{{ .Label }}" aria-label="Name of {{ .Label }}" required
                   @change="if (!$el.value.trim()) $el.value = $el.defaultValue">
            <input type="hidden" name="blurb" value="{{ .Blurb }}">
            <button type="button" class="btn btn-outline-secondary text-danger"
                    hx-delete="/settings/budget-categories/{{ .Key }}" hx-target="#categories" hx-swap="morph"
                    hx-confirm="Delete {{ .Label }}? Anything filed under it moves to {{ $c.Label }}."
                    title="Delete {{ .Label }}" aria-label="Delete {{ .Label }}">
                <i class="bi bi-trash" aria-hidden="true"></i>
            </button>
        </form>
        {{ end }}
        {{/* Morphing keeps this form, typing and all, so it is cleared once sent. */}}
        <form class="input-group input-group-sm" hx-post="/settings/budget-categories" hx-target="#categories" hx-swap="morph"
              key="add-sub-{{ $c.Key }}" hx-on::after-request="if (event.detail.successful) this.reset()">
            <input type="hidden" name="parent" value="{{ $c.Key }}">
            <input class="form-control" name="label" placeholder="New subcategory" aria-label="Name of a new subcategory of {{ $c.Label }}" required>
            <button class="btn btn-outline-secondary"><i class="bi bi-plus-lg"></i>Add</button>
        </form>
    </div>
</div>
{{ end }}

{{/* Deleting a category, last and set apart, naming where its transactions
     go. */}}
{{ define "settings.category.delete" }}
{{ $c := . }}
{{ if not $c.Fixed }}
<form class="b-cat-section b-cat-danger d-flex flex-wrap align-items-center gap-2" hx-delete="/settings/budget-categories/{{ $c.Key }}"
      hx-target="#categories" hx-swap="morph"
      hx-confirm="Delete {{ $c.Label }} and its subcategories? Its rules, and everything filed under it, move to the category you picked.">
    <label class="b-field-label mb-0" for="cat-into-{{ $c.Key }}">Delete {{ $c.Label }}, moving everything to</label>
    <select class="form-select form-select-sm w-auto" id="cat-into-{{ $c.Key }}" name="into">
        {{ range $c.MoveTo }}<option value="{{ .Key }}"{{ if eq .Key "uncategorised" }} selected{{ end }}>{{ .Label }}</option>{{ end }}
    </select>
    <button class="btn btn-outline-danger btn-sm"><i class="bi bi-trash"></i>Delete</button>
</form>
{{ end }}
{{ end }}

{{ define "settings.rules.preview" }}
{{ if .Contains }}
<div class="b-sched small">
    {{ if .Matches }}
    <div class="mb-1">
        Would file <span class="fw-semibold">{{ .Matches }} transaction{{ if ne .Matches 1 }}s{{ end }}</span>{{ if gt .Matches (len .Samples) }}, most recent:{{ else }}:{{ end }}
    </div>
    <ul class="list-unstyled mb-0">
        {{ range .Samples }}
        <li class="d-flex justify-content-between gap-2">
            <span class="min-width-0 text-truncate">
                <span class="text-muted me-1">{{ .Date.Format "2 Jan 2006" }}</span>{{ .Title }}
                <span class="text-muted">· {{ if .Category }}{{ .Category }}{{ else }}uncategorised{{ end }}</span>
            </span>
            <span class="text-nowrap">{{ .Amount | fmtCurrency }}</span>
        </li>
        {{ end }}
    </ul>
    {{ else }}
    <span class="text-warning">Matches nothing yet.</span>
    {{ end }}
    {{ if .Transfers }}
    <div class="text-warning mt-1">
        {{ .Transfers }} transfer{{ if ne .Transfers 1 }}s{{ end }} between your accounts also match{{ if eq .Transfers 1 }}es{{ end }}.
        Tick “Include transfers” to count {{ if eq .Transfers 1 }}it{{ else }}them{{ end }} as spending.
    </div>
    {{ end }}
    {{ if .OutOfRange }}
    <div class="text-muted mt-1">{{ .OutOfRange }} more transaction{{ if ne .OutOfRange 1 }}s{{ end }} match{{ if eq .OutOfRange 1 }}es{{ end }} the text, but {{ if eq .OutOfRange 1 }}its amount is{{ else }}their amounts are{{ end }} outside the rule's.</div>
    {{ end }}
    {{ if .Taken }}
    <div class="text-muted mt-1">{{ .Taken }} more transaction{{ if ne .Taken 1 }}s{{ end }} match{{ if eq .Taken 1 }}es{{ end }}, but an earlier rule already files {{ if eq .Taken 1 }}it{{ else }}them{{ end }}.</div>
    {{ end }}
</div>
{{ end }}
{{ end }}

{{ define "settings.schedule" }}
<div class="b-card b-card-pad mb-3 b-accent-plum" id="schedule">
    <div class="b-card-head">
        <div class="d-flex align-items-center gap-2">
            <span class="b-chip"><i class="bi bi-clock-history"></i></span>
            <div>
                <h3 class="b-card-title">Run on a schedule</h3>
                <p class="b-card-sub">
                Anything that fails while this is running is reported under the bell,
                since there is nobody watching a background job.
                </p>
            </div>
        </div>
    </div>

    <form hx-post="/settings/schedule" hx-target="#schedule" hx-swap="outerHTML">
        <div class="row g-3">

            <div class="col-12 col-md-6">
                <div class="b-sched">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch"
                               id="akahu-enabled" name="akahu_enabled" value="1"
                               {{ if .Settings.AkahuEnabled }}checked{{ end }}>
                        <label class="form-check-label fw-semibold" for="akahu-enabled">Sync accounts</label>
                    </div>
                    <p class="b-card-sub mb-2">Pull balances and transactions from Akahu.</p>

                    <label class="b-field-label" for="akahu-interval">How often</label>
                    <select class="form-select form-select-sm" id="akahu-interval" name="akahu_interval">
                        {{ $current := .Settings.AkahuEvery.Key }}
                        {{ range .AkahuIntervals }}
                            <option value="{{ .Key }}" {{ if eq .Key $current }}selected{{ end }}>{{ .Label }}</option>
                        {{ end }}
                    </select>

                    <div class="b-delta-note mt-2">
                        {{ if not .Settings.AkahuEnabled }}
                            Off.
                        {{ else if .AkahuNext.IsZero }}
                            Runs within the minute.
                        {{ else }}
                            Next {{ .AkahuNext | fmtUntil }}.
                        {{ end }}
                        {{ if not .Settings.AkahuLastRun.IsZero }}
                            Last ran {{ .Settings.AkahuLastRun | fmtRelative }}.
                        {{ end }}
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-6">
                <div class="b-sched">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch"
                               id="assets-enabled" name="assets_enabled" value="1"
                               {{ if .Settings.AssetsEnabled }}checked{{ end }}>
                        <label class="form-check-label fw-semibold" for="assets-enabled">Refresh property estimates</label>
                    </div>
                    <p class="b-card-sub mb-2">
                        Re-fetch every asset that has a valuation source, and report the ones that moved.
                    </p>

                    <label class="b-field-label" for="assets-interval">How often</label>
                    <select class="form-select form-select-sm" id="assets-interval" name="assets_interval">
                        {{ $current := .Settings.AssetsEvery.Key }}
                        {{ range .AssetIntervals }}
                            <option value="{{ .Key }}" {{ if eq .Key $current }}selected{{ end }}>{{ .Label }}</option>
                        {{ end }}
                    </select>

                    <div class="b-delta-note mt-2">
                        {{ if not .Settings.AssetsEnabled }}
                            Off.
                        {{ else if .AssetsNext.IsZero }}
                            Runs within the minute.
                        {{ else }}
                            Next {{ .AssetsNext | fmtUntil }}.
                        {{ end }}
                        {{ if not .Settings.AssetsLastRun.IsZero }}
                            Last ran {{ .Settings.AssetsLastRun | fmtRelative }}.
                        {{ end }}
                    </div>
                </div>
            </div>

            <div class="col-12">
                <button type="submit" class="btn btn-primary btn-sm">Save schedule</button>
            </div>
        </div>
    </form>
</div>
{{ end }}
