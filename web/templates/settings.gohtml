{{define "settings"}}

    <div class="b-page-head">
        <h2>Settings</h2>
        <p class="b-page-sub">Connections, what runs by itself, and the buttons to be careful with.</p>
    </div>

    <!-- Akahu -->
    <div class="b-card b-card-pad mb-3">
        <div class="b-card-head">
            <div>
                <h3 class="b-card-title">
                    <img src="/static/akahu.svg" class="rounded-circle me-1" alt=""
                         style="height: 1em; margin-top: -0.2em">
                    Akahu
                </h3>
                <p class="b-card-sub">
                    New Zealand's open finance platform, and where transaction data comes
                    from. <a href="https://www.akahu.nz/consumer">More about Akahu</a>.
                </p>
            </div>
        </div>

        <form>
            <div class="row g-2">
                <div class="col-12 col-md-6">
                    <label class="b-field-label" for="akahuAppToken">App token</label>
                    <div class="input-group">
                        <input class="form-control" id="akahuAppToken" name="akahuAppToken"
                               value="{{ .akahuAppToken }}" type="password" autocomplete="off">
                        <span class="input-group-text">
                            <i class="bi bi-eye-fill" id="toggleAppToken" style="cursor: pointer"
                               _="on click if #akahuAppToken.type is 'password' set #akahuAppToken.type to 'text' else set #akahuAppToken.type to 'password'"></i>
                        </span>
                    </div>
                </div>

                <div class="col-12 col-md-6">
                    <label class="b-field-label" for="akahuUserToken">User token</label>
                    <div class="input-group">
                        <input class="form-control" id="akahuUserToken" name="akahuUserToken"
                               value="{{ .akahuUserToken }}" type="password" autocomplete="off">
                        <span class="input-group-text">
                            <i class="bi bi-eye-fill" id="toggleUserToken" style="cursor: pointer"
                               _="on click if #akahuUserToken.type is 'password' set #akahuUserToken.type to 'text' else set #akahuUserToken.type to 'password'"></i>
                        </span>
                    </div>
                </div>

                <div class="col-12 d-flex align-items-center flex-wrap gap-2 mt-2">
                    <button class="btn btn-primary" hx-post="/integrations/akahu/sync"
                            hx-disabled-elt="this"
                            hx-swap="outerHTML" hx-target="#last-sync">
                        <i class="bi bi-arrow-repeat"></i> Sync now
                    </button>
                    <button class="btn btn-outline-secondary" hx-post="/integrations/akahu/save"
                            hx-disabled-elt="this" hx-swap="none">
                        Save tokens
                    </button>

                    <span class="b-delta-note ms-auto">{{ template "settings.integrations.last-sync" . }}</span>
                </div>
            </div>
        </form>
    </div>

    <!-- What runs by itself -->
    <div id="schedule">{{ template "settings.schedule" .schedule }}</div>

    <!-- Connected accounts -->
    <div class="b-card mb-3" id="accounts">
        <div class="b-conn">
            <span class="b-chip b-chip-sm b-accent-slate"><i class="bi bi-bank2"></i></span>
            <h3 class="b-conn-name">Connected accounts</h3>
            <div class="b-conn-total">{{ len .accounts }}</div>
        </div>

        {{ if .accounts }}
            <ul class="b-acct-list">
                {{ range .accounts }}
                    <li>
                        <div class="b-acct b-acct-static">
                            <img class="b-conn-logo" width="30" height="30"
                                 src="{{ .Connection.Logo }}" alt="{{ .Connection.Name }}"/>
                            <div class="b-acct-body">
                                <div class="b-acct-name">{{ .Name }}</div>
                                <div class="b-acct-meta">
                                    <span class="badge-category">{{ .Connection.Name }}</span>
                                    {{ if .FormattedAccount }}
                                        <span class="font-monospace">{{ .FormattedAccount }}</span>
                                    {{ end }}
                                    {{ with .Meta.LoanDetails.Interest }}
                                        {{ if gt .Rate 0.0 }}
                                            <span><i class="bi bi-percent"></i>{{ printf "%.2f%%" .Rate }}
                                                {{ if .Type }}{{ .Type | fmtTitle }}{{ end }}</span>
                                        {{ end }}
                                    {{ end }}
                                </div>
                            </div>
                            <div class="b-acct-figures">
                                <div class="b-acct-balance {{ if lt .Balance.Current 0.0 }}text-danger{{ end }}">
                                    {{ .Balance.Current | fmtCurrency }}
                                </div>
                                <span class="b-delta b-delta-flat">{{ .Type | fmtTitle }}</span>
                            </div>
                        </div>
                    </li>
                {{ end }}
            </ul>
        {{ else }}
            <div class="b-card-pad">
                <div class="b-empty">
                    <i class="bi bi-bank2"></i>
                    <h4>Nothing connected</h4>
                    <p>Save your Akahu tokens above, then sync.</p>
                </div>
            </div>
        {{ end }}
    </div>

    <!-- Danger -->
    <div class="b-card b-card-pad mb-3 b-accent-brick" id="danger">
        <div class="b-card-head">
            <div class="d-flex align-items-center gap-2">
                <span class="b-chip"><i class="bi bi-exclamation-octagon"></i></span>
                <div>
                    <h3 class="b-card-title">Danger</h3>
                    <p class="b-card-sub">These cannot be undone once performed.</p>
                </div>
            </div>
        </div>

        <div class="b-sched">
            <div class="fw-semibold">Remove all synced data</div>
            <p class="b-card-sub mb-2">
                Drops every transaction, merchant and account. Assets and budget targets are
                left alone, and a sync repopulates the rest.
            </p>
            <button class="btn btn-outline-danger btn-sm"
                    hx-post="/settings/danger/remove/synced"
                    hx-confirm="Remove all synced data?">
                Remove all synced data
            </button>
        </div>
    </div>

{{ end }}

{{ define "settings.integrations.last-sync" }}
<span id="last-sync">
    {{ if .akahuLastSync.IsZero }}Never synced{{ else }}Last sync {{ .akahuLastSync | fmtRelative }}{{ end }}
</span>
{{ end }}

{{ define "settings.schedule" }}
<div class="b-card b-card-pad mb-3" id="schedule">
    <div class="b-card-head">
        <div>
            <h3 class="b-card-title"><i class="bi bi-clock-history me-2"></i>Run on a schedule</h3>
            <p class="b-card-sub">
                Anything that fails while this is running is reported under the bell,
                since there is nobody watching a background job.
            </p>
        </div>
    </div>

    <form hx-post="/settings/schedule" hx-target="#schedule" hx-swap="outerHTML">
        <div class="row g-3">

            <div class="col-12 col-md-6">
                <div class="b-sched">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch"
                               id="akahu-enabled" name="akahu_enabled" value="1"
                               {{ if .Settings.AkahuEnabled }}checked{{ end }}>
                        <label class="form-check-label fw-semibold" for="akahu-enabled">Sync accounts</label>
                    </div>
                    <p class="b-card-sub mb-2">Pull balances and transactions from Akahu.</p>

                    <label class="b-field-label" for="akahu-interval">How often</label>
                    <select class="form-select" id="akahu-interval" name="akahu_interval">
                        {{ $current := .Settings.AkahuEvery.Key }}
                        {{ range .AkahuIntervals }}
                            <option value="{{ .Key }}" {{ if eq .Key $current }}selected{{ end }}>{{ .Label }}</option>
                        {{ end }}
                    </select>

                    <div class="b-delta-note mt-2">
                        {{ if not .Settings.AkahuEnabled }}
                            Off.
                        {{ else if .AkahuNext.IsZero }}
                            Runs within the minute.
                        {{ else }}
                            Next {{ .AkahuNext | fmtUntil }}.
                        {{ end }}
                        {{ if not .Settings.AkahuLastRun.IsZero }}
                            Last ran {{ .Settings.AkahuLastRun | fmtRelative }}.
                        {{ end }}
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-6">
                <div class="b-sched">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch"
                               id="assets-enabled" name="assets_enabled" value="1"
                               {{ if .Settings.AssetsEnabled }}checked{{ end }}>
                        <label class="form-check-label fw-semibold" for="assets-enabled">Refresh property estimates</label>
                    </div>
                    <p class="b-card-sub mb-2">
                        Re-fetch every asset that has a valuation source, and report the ones that moved.
                    </p>

                    <label class="b-field-label" for="assets-interval">How often</label>
                    <select class="form-select" id="assets-interval" name="assets_interval">
                        {{ $current := .Settings.AssetsEvery.Key }}
                        {{ range .AssetIntervals }}
                            <option value="{{ .Key }}" {{ if eq .Key $current }}selected{{ end }}>{{ .Label }}</option>
                        {{ end }}
                    </select>

                    <div class="b-delta-note mt-2">
                        {{ if not .Settings.AssetsEnabled }}
                            Off.
                        {{ else if .AssetsNext.IsZero }}
                            Runs within the minute.
                        {{ else }}
                            Next {{ .AssetsNext | fmtUntil }}.
                        {{ end }}
                        {{ if not .Settings.AssetsLastRun.IsZero }}
                            Last ran {{ .Settings.AssetsLastRun | fmtRelative }}.
                        {{ end }}
                    </div>
                </div>
            </div>

            <div class="col-12">
                <button type="submit" class="btn btn-primary">Save schedule</button>
            </div>
        </div>
    </form>
</div>
{{ end }}
