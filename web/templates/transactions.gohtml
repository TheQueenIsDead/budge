{{ define "transactions" }}

    {{ template "pageHead" (dict "Title" "Transactions" "Sub" "Everything that moved, newest first.") }}

    <!-- Filters. Sticky, so search stays reachable well down a long list. -->
    <div class="b-filters">
        {{/* The listeners name the filters by id. A bare "from:select" would
             match every select on the page, so picking a memory or a category
             further down would reload the list underneath it. */}}
        <form hx-get="/transactions"
              hx-trigger="input delay:400ms from:#search, change from:#account, change from:#uncategorised"
              hx-target="#main"
              hx-push-url="true">
            <input type="hidden" id="filter-from" name="from" value="{{ .from }}">
            <input type="hidden" id="filter-to" name="to" value="{{ .to }}">
            {{ range .groups }}
                <input type="hidden" name="group" value="{{ .Key }}">
            {{ end }}

            <div class="row g-2">
                <div class="col-12 col-sm-6">
                    <div class="position-relative">
                        <i class="bi bi-search b-search-icon" aria-hidden="true"></i>
                        <input id="search" type="search" name="search"
                               class="form-control ps-5"
                               placeholder="Search merchants, categories&hellip;"
                               autocomplete="off"
                               value="{{ .search }}">
                    </div>
                </div>
                <div class="col-7 col-sm-4">
                    <select id="account" name="account" class="form-select">
                        <option value="">All accounts</option>
                        {{ range .accounts }}
                            <option value="{{ .Id }}" {{ if eq $.account .Id }}selected{{ end }}>{{ .Name }}</option>
                        {{ end }}
                    </select>
                </div>
                {{/* Only what nothing has filed yet, however old, alongside the
                     other filters. */}}
                <div class="col-5 col-sm-2">
                    <input type="checkbox" class="btn-check" id="uncategorised" name="uncategorised" value="1"
                           autocomplete="off"{{ if .uncategorisedOnly }} checked{{ end }}>
                    <label class="btn btn-outline-secondary w-100 b-filter-toggle" for="uncategorised"
                           title="Show only transactions with no category">
                        <i class="bi bi-question-circle"></i>Uncategorised
                    </label>
                </div>
            </div>
        </form>

        <div class="b-summary-bar mt-2">
            {{ if .dated }}
                <a class="badge-category badge-link" href="/transactions?search={{ .search }}&account={{ .account }}{{ range .groups }}&group={{ .Key }}{{ end }}"
                   hx-boost="true" hx-target="#main" title="Show every date">
                    <i class="bi bi-calendar-range"></i> {{ .dateRange }} <i class="bi bi-x"></i>
                </a>
            {{ end }}
            {{ if .groups }}
                <a class="badge-category badge-link" href="/transactions?search={{ .search }}&account={{ .account }}&from={{ .from }}&to={{ .to }}"
                   hx-boost="true" hx-target="#main" title="Show every category">
                    <i class="bi bi-tags"></i> {{ range $i, $g := .groups }}{{ if $i }}, {{ end }}{{ $g.Label }}{{ end }} <i class="bi bi-x"></i>
                </a>
            {{ end }}
            <span class="b-summary-item fw-semibold">
                {{ .showing }}{{ if .hasMore }} of {{ .total }}{{ end }}
                result{{ if ne .total 1 }}s{{ end }}
            </span>
            <span class="b-summary-item text-success">
                <i class="bi bi-arrow-down-left"></i>{{ .in | fmtCurrency }}
            </span>
            <span class="b-summary-item text-danger">
                <i class="bi bi-arrow-up-right"></i>{{ .out | fmtCurrencyAbs }}
            </span>
            <span class="b-summary-item text-muted ms-auto d-none d-sm-inline-flex">{{ .took }}</span>
        </div>
    </div>

    {{/* Uncategorised spending all counts as unbudgeted, so it is called out
         until it is filed, with a way straight to it. */}}
    {{ if .uncategorisedOnly }}
        <div class="alert alert-warning d-flex align-items-start gap-2 mb-3" role="status">
            <i class="bi bi-funnel" aria-hidden="true"></i>
            <div class="flex-grow-1">
                Showing only spending with no category.
                Tap the icons of several to file them together, or use
                <i class="bi bi-tag" aria-hidden="true"></i><span class="visually-hidden">the tag button</span>
                on one to file everything like it with a rule.
            </div>
            <a class="text-nowrap" href="/transactions" hx-boost="true" hx-target="#main">Show everything</a>
        </div>
    {{ else if .uncategorisedCount }}
        <div class="alert alert-warning d-flex align-items-start gap-2 mb-3" role="status">
            <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
            <div class="flex-grow-1">
                <span class="fw-semibold">{{ .uncategorisedCount }} payment{{ if ne .uncategorisedCount 1 }}s{{ end }} in the last {{ .uncategorisedWeeks }} weeks
                {{ if eq .uncategorisedCount 1 }}has{{ else }}have{{ end }} no category</span>, {{ .uncategorisedTotal | fmtWhole }} in all.
                Until they are filed, the budget can only lump them together under Uncategorised.
            </div>
            <a class="text-nowrap" href="/transactions?uncategorised=1" hx-boost="true" hx-target="#main">Show them</a>
        </div>
    {{ end }}

    <!-- Spend behind the results. Stacked by the same categories that colour the
         rows, so a band and a row chip of the same colour mean the same thing. -->
    {{ if .series.HasData }}
        <div class="b-card b-card-pad mb-3">
            <div class="b-card-head mb-1">
                {{ $split := "" }}
                {{ if .series.Split }}{{ $split = " by category" }}{{ end }}
                {{ template "cardTitle" (dict "Title" "Spend over time"
                    "Sub" (printf "Last 12 months of these results%s. Transfers, money in and savings are left out." $split)) }}
                <div class="text-end flex-shrink-0">
                    <div class="fw-bold b-num">{{ .series.Total | fmtCurrency }}</div>
                    <div class="b-delta-note">total spend</div>
                </div>
            </div>
            <div class="b-chart b-chart-short">
                <canvas id="txSeriesChart" hx-preserve="true"></canvas>
            </div>
        </div>
    {{ end }}

    {{ if .days }}

        <!-- Ticking rows brings up a bar to add them all to one memory, or take
             them out of theirs, as on the timeline. -->
        <div class="b-tx-feed">

        <!-- Phone: a card per transaction, grouped under the day it happened. -->
        <div class="d-md-none">
            {{ range .days }}
                <div class="b-tx-day">
                    <span>{{ .Date.Format "Mon 2 Jan 2006" }}</span>
                    <span class="{{ if gt .Net 0.0 }}text-success{{ else }}text-danger{{ end }}">
                        {{ .Net | fmtCurrency }}
                    </span>
                </div>
                <div class="b-tx-list mb-2">
                    {{ range .Rows }}
                        <div class="b-tx{{ if .Accent }} b-accent-{{ .Accent }}{{ end }}">
                            {{ template "transactions.pick" (dict "Row" . "Size" "") }}
                            <div class="b-tx-body">
                                <div class="b-tx-name">{{ .Title }}</div>
                                <div class="b-tx-meta" id="txcats-m-{{ .Id }}">
                                    {{ template "transactions.tags" .CategoryTags }}
                                </div>
                            </div>
                            <div class="b-tx-amount {{ if gt .Amount 0.0 }}text-success{{ else }}text-danger{{ end }}">
                                {{ .Amount | fmtCurrency }}
                            </div>
                            {{ template "transactions.category" (dict "ID" .Id "Layout" "m") }}
                            {{ template "transactions.memory" (dict "ID" .Id "MemoryID" .MemoryID "MemoryTitle" .MemoryTitle "Layout" "m" "Options" $.memories) }}
                        </div>
                    {{ end }}
                </div>
            {{ end }}
        </div>

        <!-- Desktop: the table, which has the room to carry more columns. -->
        <div class="table-container d-none d-md-block">
            <table class="table">
                <thead>
                <tr>
                    <th>Merchant</th>
                    <th>Category</th>
                    <th>Date</th>
                    <th class="text-end">Amount</th>
                    <th><span class="visually-hidden">Category and memory</span></th>
                </tr>
                </thead>
                <tbody>
                {{ range .days }}
                    {{ $date := .Date }}
                    {{ range .Rows }}
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2{{ if .Accent }} b-accent-{{ .Accent }}{{ end }}">
                                    {{ template "transactions.pick" (dict "Row" . "Size" "b-chip-sm") }}
                                    <span class="fw-semibold">{{ .Title }}</span>
                                </div>
                            </td>
                            <td>
                                <span id="txcats-d-{{ .Id }}">
                                    {{ template "transactions.tags" .CategoryTags }}
                                </span>
                            </td>
                            <td class="text-muted">{{ $date.Format "2 Jan 2006" }}</td>
                            <td class="text-end fw-semibold b-num {{ if gt .Amount 0.0 }}text-success{{ else }}text-danger{{ end }}">
                                {{ .Amount | fmtCurrency }}
                            </td>
                            <td class="b-txmem-cell">
                                <div class="d-flex justify-content-end gap-1">
                                    {{ template "transactions.category" (dict "ID" .Id "Layout" "d") }}
                                    {{ template "transactions.memory" (dict "ID" .Id "MemoryID" .MemoryID "MemoryTitle" .MemoryTitle "Layout" "d" "Options" $.memories) }}
                                </div>
                            </td>
                        </tr>
                    {{ end }}
                {{ end }}
                </tbody>
            </table>
        </div>

        {{ if .hasMore }}
            <div class="text-center my-3">
                <a class="btn btn-outline-secondary"
                   href="/transactions?search={{ .search }}&account={{ .account }}&from={{ .from }}&to={{ .to }}&limit={{ .nextLimit }}{{ if .uncategorisedOnly }}&uncategorised=1{{ end }}{{ range .groups }}&group={{ .Key }}{{ end }}"
                   hx-boost="true" hx-target="#main">
                    Load more
                    <span class="text-muted">({{ .total }} in total)</span>
                </a>
            </div>
        {{ end }}

        {{/* Picking a memory saves at once. Unticks everything once saved,
             which also hides the bar again. */}}
        <form id="tx-group" class="b-tl-form b-tl-groupbar" hx-post="/transactions/memory" hx-trigger="change" hx-swap="none"
              hx-on::after-request="if (event.detail.successful) document.querySelectorAll('[form=tx-group]:checked').forEach(b => b.checked = false)">
            <span class="b-tl-count"></span>
            {{ template "transactions.groupbar" (dict "Options" .memories "Categories" .categories) }}
        </form>

        </div>

    {{ else }}
        {{ $why := "Sync an account from settings to see your transactions here." }}
        {{ if or .search .account .dated }}{{ $why = "Nothing matches those filters. Try a broader search." }}{{ end }}
        {{ template "empty" (dict "Icon" "bi-search" "Title" "No transactions found" "Text" $why) }}
    {{ end }}

    <script nonce="{{ nonce }}">
        window.budge.afterSwap(function () {
            const canvas = document.getElementById("txSeriesChart");
            if (!canvas || typeof Chart === "undefined" || !window.budge) {
                return;
            }

            const labels = {{ .series.Labels }};
            const bands = {{ .series.Groups }};
            const split = {{ .series.Split }};

            const datasets = (bands || []).map(function (band) {
                return {
                    label: band.Label,
                    data: band.Data,
                    backgroundColor: window.budge.colour(band.Accent),
                    borderRadius: 3,
                    maxBarThickness: 34
                };
            });

            // The canvas survives the swap, so a new search updates the chart in
            // place. Rebuilding it would blank the card for a frame on every
            // keystroke, which reads as flicker while typing.
            const existing = Chart.getChart(canvas);
            if (existing) {
                existing.data.labels = labels;
                existing.data.datasets = datasets;
                // Options are not part of the data, so anything that varies with
                // the search has to be reapplied. Searching turns the split on,
                // and a preserved chart would otherwise keep the legend hidden
                // from whichever state it was first drawn in.
                existing.options.plugins.legend.display = split;
                existing.update("none");
                return;
            }

            new Chart(canvas, {
                type: "bar",
                data: {labels: labels, datasets: datasets},
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    animation: false,
                    scales: {
                        // Stacking is what lets a month read as a total and as
                        // its parts at the same time.
                        x: {
                            stacked: true,
                            border: {display: false},
                            grid: {display: false},
                            ticks: {color: window.budge.ink, maxRotation: 0, autoSkipPadding: 6}
                        },
                        y: {
                            stacked: true,
                            beginAtZero: true,
                            border: {display: false},
                            grid: {color: window.budge.grid},
                            ticks: {
                                color: window.budge.ink,
                                maxTicksLimit: 4,
                                callback: v => "$" + v.toLocaleString()
                            }
                        }
                    },
                    plugins: {
                        legend: {
                            // One band needs no legend to explain itself.
                            display: split,
                            position: "bottom",
                            labels: {
                                color: window.budge.ink,
                                boxWidth: 10,
                                boxHeight: 10,
                                usePointStyle: true,
                                pointStyle: "circle",
                                padding: 12
                            }
                        },
                        tooltip: {
                            callbacks: {
                                label: ctx => ctx.dataset.label + ": $" +
                                    ctx.parsed.y.toLocaleString(undefined, {minimumFractionDigits: 2})
                            }
                        }
                    }
                }
            });
        });
    </script>

{{ end }}

{{/* Adding one transaction to a memory, in the same words the timeline uses.
     A transaction already in a memory shows which, and can be moved to
     another. Every transaction is drawn twice, as a phone card and a table
     row, so the id carries the layout to keep the two copies apart. */}}
{{ define "transactions.memory" }}
{{ if .MemoryID }}
    {{/* Already in a memory: it opens the memory's page, which comes back to
         this list. Taking it out is done there, with the rest of the memory. */}}
    <a class="b-txmem b-txmem-toggle b-txmem-in" id="txmem-{{ .Layout }}-{{ .ID }}"{{ if .OOB }} hx-swap-oob="true"{{ end }}
       href="/memories/{{ .MemoryID }}/edit" hx-get="/memories/{{ .MemoryID }}/edit"
       hx-vals='js:{"return": location.pathname + location.search}'
       hx-target="#main" hx-swap="innerHTML show:window:top" hx-push-url="true"
       title="In “{{ .MemoryTitle }}”" aria-label="Open the memory “{{ .MemoryTitle }}”">
        <i class="bi bi-bookmark-check-fill"></i>
    </a>
{{ else }}
    {{/* Picking a memory saves straight away. New memories are made on the
         timeline, so this stays one small dropdown. */}}
    <details class="b-txmem" id="txmem-{{ .Layout }}-{{ .ID }}"{{ if .OOB }} hx-swap-oob="true"{{ end }}>
        <summary class="b-txmem-toggle" title="Add to memory" aria-label="Add to memory">
            <i class="bi bi-bookmark-plus"></i>
        </summary>
        <form class="b-tl-form b-txmem-form" hx-post="/transactions/{{ .ID }}/memory" hx-trigger="change"
              hx-target="#txmem-{{ .Layout }}-{{ .ID }}" hx-swap="outerHTML">
            <input type="hidden" name="layout" value="{{ .Layout }}">
            {{ template "transactions.memory.pick" . }}
        </form>
    </details>
{{ end }}
{{ end }}

{{ define "transactions.memory.pick" }}
{{ if .Options }}
    <select class="form-select form-select-sm" name="memory" aria-label="Add to memory">
        <option value="" selected disabled>Add to memory&hellip;</option>
        {{ range .Options }}<option value="{{ .Id }}">{{ .Label }}</option>{{ end }}
    </select>
{{ else }}
    <span class="small text-muted">No memories yet. <a href="/timeline">Start one on the timeline</a>.</span>
{{ end }}
{{ end }}

{{/* A row's icon doubles as its tick box, so selecting needs no extra
     column. Once anything is ticked every icon turns into a box, so it is
     plain which rows are in and which are not. */}}
{{ define "transactions.pick" }}
<label class="b-tx-pick" title="Select">
    <input type="checkbox" class="b-tl-select visually-hidden" name="tx" value="{{ .Row.Id }}"
           form="tx-group" aria-label="Select {{ .Row.Title }}">
    <span class="b-chip {{ .Size }}">
        <i class="bi {{ .Row.Icon }} b-tx-pick-icon"></i>
        <i class="bi bi-check-lg b-tx-pick-tick"></i>
    </span>
</label>
{{ end }}

{{ define "transactions.category" }}
{{/* The form is fetched when the popover first opens, so a long list does not
     carry the whole category picker on every row. */}}
<details class="b-txmem b-txcat" id="txcat-{{ .Layout }}-{{ .ID }}"{{ if .OOB }} hx-swap-oob="true"{{ end }}
         hx-get="/transactions/{{ .ID }}/category?layout={{ .Layout }}" hx-trigger="toggle once"
         hx-target="find .b-txcat-body" hx-swap="innerHTML">
    <summary class="b-txmem-toggle" title="Categorise" aria-label="Categorise this transaction">
        <i class="bi bi-tag"></i>
    </summary>
    <div class="b-tl-form b-txmem-form b-txcat-body"><span class="text-muted small">Loading…</span></div>
</details>
{{ end }}

{{ define "transactions.category.form" }}
<form class="b-actions" hx-post="/transactions/{{ .ID }}/category" hx-target="this" hx-swap="none">
    <div class="b-txmem-head">
        {{ .Current }}{{ if .Source }}<span class="fw-normal text-muted"> · from {{ .Source }}</span>{{ end }}
    </div>
    <select class="form-select form-select-sm" name="category" aria-label="File under">
        <option value="">File under…</option>
        {{ range .Groups }}
            {{ if .Options }}
            <optgroup label="{{ .Label }}">
                {{ range .Options }}<option value="{{ .Key }}">{{ .Label }}</option>{{ end }}
            </optgroup>
            {{ else }}
            <option value="{{ .Key }}">{{ .Label }}</option>
            {{ end }}
        {{ end }}
    </select>
    {{ if .RuleText }}
    <div class="form-check small mb-0">
        <input class="form-check-input" type="checkbox" id="txcat-like-{{ .Layout }}-{{ .ID }}" name="scope" value="like">
        <label class="form-check-label" for="txcat-like-{{ .Layout }}-{{ .ID }}">
            All transactions containing “{{ .RuleText }}”, as a rule
        </label>
    </div>
    {{ end }}
    {{/* The way to the rules on the left, then Save last, on the right. */}}
    <a class="small b-actions-status" href="/settings#categories">Categories &amp; rules</a>
    {{ if .Overridden }}
    <button class="btn btn-sm btn-outline-secondary" name="clear" value="1">Undo my change</button>
    {{ end }}
    <button class="btn btn-sm btn-primary">Save</button>
</form>
{{ end }}

{{/* A transaction's category badges. Each narrows the list to its category,
     keeping the search, account and dates, so a tag on a drill-down narrows
     that drill-down. The href alone opens the category on its own. */}}
{{ define "transactions.tags" }}
    {{ range . }}<a class="badge-category badge-link" href="/transactions?group={{ .Key }}"
        hx-get="/transactions?group={{ .Key }}" hx-include="#search, #account, #filter-from, #filter-to"
        hx-target="#main" hx-push-url="true" title="Show only {{ .Label }}">{{ .Label }}</a>{{ end }}
{{ end }}

{{ define "transactions.category.updated" }}
<div class="b-tx-meta" id="txcats-m-{{ .ID }}" hx-swap-oob="true">
    {{ template "transactions.tags" .Categories }}
</div>
<span id="txcats-d-{{ .ID }}" hx-swap-oob="true">
    {{ template "transactions.tags" .Categories }}
</span>
{{ range .Popovers }}{{ template "transactions.category" . }}{{ end }}
{{ end }}

{{ define "transactions.memory.swap" }}
{{ range .Controls }}{{ template "transactions.memory" . }}{{ end }}
{{ if .Bar }}{{ template "transactions.groupbar" (dict "Options" .Options "Categories" .Categories "OOB" true) }}{{ end }}
{{ end }}

{{/* The selection bar's fields, redrawn after it is used so the memory just
     made can be picked next time. The form itself stays put, so the ticks
     that belong to it are not orphaned. */}}
{{ define "transactions.groupbar" }}
<span id="tx-group-fields" class="b-tl-new-wrap"{{ if .OOB }} hx-swap-oob="true"{{ end }}>
    {{/* Filing every ticked transaction at once, as if each were filed by
         hand. It posts on its own: "consume" keeps the bar's memory form from
         taking the change too. */}}
    <select class="form-select form-select-sm" name="category" aria-label="File the ticked transactions under"
            hx-post="/transactions/category" hx-trigger="change consume" hx-include="closest form" hx-swap="none">
        <option value="" selected disabled>File under&hellip;</option>
        {{ range .Categories }}
            {{ if .Options }}
            <optgroup label="{{ .Label }}">
                {{ range .Options }}<option value="{{ .Key }}">{{ .Label }}</option>{{ end }}
            </optgroup>
            {{ else }}
            <option value="{{ .Key }}">{{ .Label }}</option>
            {{ end }}
        {{ end }}
    </select>
    {{ if .Options }}{{ template "transactions.memory.pick" . }}{{ end }}
    {{/* A new memory has a page of its own, opened with the ticked
         transactions and what was bought around them, which comes back to
         this list once it is made. It swaps the page in, where the bar's
         own form swaps nothing. */}}
    <button type="button" class="btn btn-sm btn-outline-secondary" hx-get="/memories/new"
            hx-include="[form=tx-group]:checked" hx-vals='js:{"return": location.pathname + location.search}'
            hx-target="#main" hx-swap="innerHTML show:window:top" hx-push-url="true">
        <i class="bi bi-bookmark-plus"></i> New memory
    </button>
</span>
{{ end }}
