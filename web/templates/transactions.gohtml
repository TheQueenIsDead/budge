{{ define "transactions" }}

    <div class="b-page-head">
        <h2>Transactions</h2>
        <p class="b-page-sub">Everything that moved, newest first.</p>
    </div>

    <!-- Filters. Sticky, so search stays reachable well down a long list. -->
    <div class="b-filters">
        <form hx-get="/transactions"
              hx-trigger="input delay:400ms from:input[name='search'], change from:select"
              hx-target="#main"
              hx-push-url="true">
            <input type="hidden" name="from" value="{{ .from }}">
            <input type="hidden" name="to" value="{{ .to }}">

            <div class="row g-2">
                <div class="col-12 col-sm-7">
                    <div class="position-relative">
                        <i class="bi bi-search position-absolute text-muted"
                           style="left: 0.75rem; top: 50%; transform: translateY(-50%);"></i>
                        <input id="search" type="search" name="search"
                               class="form-control ps-5"
                               placeholder="Search merchants, categories&hellip;"
                               autocomplete="off"
                               value="{{ .search }}">
                    </div>
                </div>
                <div class="col-12 col-sm-5">
                    <select id="account" name="account" class="form-select">
                        <option value="">All accounts</option>
                        {{ range .accounts }}
                            <option value="{{ .Id }}" {{ if eq $.account .Id }}selected{{ end }}>{{ .Name }}</option>
                        {{ end }}
                    </select>
                </div>
            </div>
        </form>

        <div class="b-summary-bar mt-2">
            {{ if .dated }}
                <a class="badge-category badge-link" href="/transactions?search={{ .search }}&account={{ .account }}"
                   hx-boost="true" hx-target="#main" title="Show every date">
                    <i class="bi bi-calendar-range"></i> {{ .dateRange }} <i class="bi bi-x"></i>
                </a>
            {{ end }}
            <span class="b-summary-item fw-semibold">
                {{ .showing }}{{ if .hasMore }} of {{ .total }}{{ end }}
                result{{ if ne .total 1 }}s{{ end }}
            </span>
            <span class="b-summary-item text-success">
                <i class="bi bi-arrow-down-left"></i>{{ .in | fmtCurrency }}
            </span>
            <span class="b-summary-item text-danger">
                <i class="bi bi-arrow-up-right"></i>{{ .out | fmtCurrencyAbs }}
            </span>
            <span class="b-summary-item text-muted ms-auto d-none d-sm-inline-flex">{{ .took }}</span>
        </div>
    </div>

    <!-- Spend behind the results. Stacked by the same categories that colour the
         rows, so a band and a row chip of the same colour mean the same thing. -->
    {{ if .series.HasData }}
        <div class="b-card b-card-pad mb-3">
            <div class="b-card-head mb-1">
                <div>
                    <h3 class="b-card-title">Spend over time</h3>
                    <p class="b-card-sub">
                        Last 12 months of these results{{ if .series.Split }} by category{{ end }}.
                        Transfers and money in are left out.
                    </p>
                </div>
                <div class="text-end flex-shrink-0">
                    <div class="fw-bold b-num">{{ .series.Total | fmtCurrency }}</div>
                    <div class="b-delta-note">total spend</div>
                </div>
            </div>
            <div class="b-chart b-chart-short">
                <canvas id="txSeriesChart" hx-preserve="true"></canvas>
            </div>
        </div>
    {{ end }}

    {{ if .days }}

        <!-- Phone: a card per transaction, grouped under the day it happened. -->
        <div class="d-md-none">
            {{ range .days }}
                <div class="b-tx-day">
                    <span>{{ .Date.Format "Mon 2 Jan 2006" }}</span>
                    <span class="{{ if gt .Net 0.0 }}text-success{{ else }}text-danger{{ end }}">
                        {{ .Net | fmtCurrency }}
                    </span>
                </div>
                <div class="b-tx-list mb-2">
                    {{ range .Rows }}
                        <div class="b-tx{{ if .Accent }} b-accent-{{ .Accent }}{{ end }}">
                            <span class="b-chip"><i class="bi {{ .Icon }}"></i></span>
                            <div class="b-tx-body">
                                <div class="b-tx-name">{{ .Title }}</div>
                                <div class="b-tx-meta" id="txcats-m-{{ .Id }}">
                                    {{ range .Categories }}
                                        <span class="badge-category">{{ . }}</span>
                                    {{ end }}
                                </div>
                            </div>
                            <div class="b-tx-amount {{ if gt .Amount 0.0 }}text-success{{ else }}text-danger{{ end }}">
                                {{ .Amount | fmtCurrency }}
                            </div>
                            {{ template "transactions.category" (dict "ID" .Id "Layout" "m") }}
                            {{ template "transactions.memory" (dict "ID" .Id "MemoryID" .MemoryID "MemoryTitle" .MemoryTitle "Layout" "m" "Options" $.memories "Kinds" $.kinds) }}
                        </div>
                    {{ end }}
                </div>
            {{ end }}
        </div>

        <!-- Desktop: the table, which has the room to carry more columns. -->
        <div class="table-container d-none d-md-block">
            <table class="table">
                <thead>
                <tr>
                    <th>Merchant</th>
                    <th>Category</th>
                    <th>Date</th>
                    <th class="text-end">Amount</th>
                    <th><span class="visually-hidden">Category and memory</span></th>
                </tr>
                </thead>
                <tbody>
                {{ range .days }}
                    {{ $date := .Date }}
                    {{ range .Rows }}
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2{{ if .Accent }} b-accent-{{ .Accent }}{{ end }}">
                                    <span class="b-chip b-chip-sm"><i class="bi {{ .Icon }}"></i></span>
                                    <span class="fw-semibold">{{ .Title }}</span>
                                </div>
                            </td>
                            <td>
                                <span id="txcats-d-{{ .Id }}">
                                    {{ range .Categories }}
                                        <span class="badge-category">{{ . }}</span>
                                    {{ end }}
                                </span>
                            </td>
                            <td class="text-muted">{{ $date.Format "2 Jan 2006" }}</td>
                            <td class="text-end fw-semibold b-num {{ if gt .Amount 0.0 }}text-success{{ else }}text-danger{{ end }}">
                                {{ .Amount | fmtCurrency }}
                            </td>
                            <td class="b-txmem-cell">
                                <div class="d-flex justify-content-end gap-1">
                                    {{ template "transactions.category" (dict "ID" .Id "Layout" "d") }}
                                    {{ template "transactions.memory" (dict "ID" .Id "MemoryID" .MemoryID "MemoryTitle" .MemoryTitle "Layout" "d" "Options" $.memories "Kinds" $.kinds) }}
                                </div>
                            </td>
                        </tr>
                    {{ end }}
                {{ end }}
                </tbody>
            </table>
        </div>

        {{ if .hasMore }}
            <div class="text-center my-3">
                <a class="btn btn-outline-secondary"
                   href="/transactions?search={{ .search }}&account={{ .account }}&from={{ .from }}&to={{ .to }}&limit={{ .nextLimit }}"
                   hx-boost="true" hx-target="#main">
                    Load more
                    <span class="text-muted">({{ .total }} in total)</span>
                </a>
            </div>
        {{ end }}

    {{ else }}
        <div class="b-empty">
            <i class="bi bi-search"></i>
            <h4>No transactions found</h4>
            <p>
                {{ if or .search .account .dated }}
                    Nothing matches those filters. Try a broader search.
                {{ else }}
                    Sync an account from settings to see your transactions here.
                {{ end }}
            </p>
        </div>
    {{ end }}

    <script>
        (function () {
            const canvas = document.getElementById("txSeriesChart");
            if (!canvas || typeof Chart === "undefined" || !window.budge) {
                return;
            }

            const labels = {{ .series.Labels }};
            const bands = {{ .series.Groups }};
            const split = {{ .series.Split }};

            const datasets = (bands || []).map(function (band) {
                return {
                    label: band.Label,
                    data: band.Data,
                    backgroundColor: window.budge.colour(band.Accent),
                    borderRadius: 3,
                    maxBarThickness: 34
                };
            });

            // The canvas survives the swap, so a new search updates the chart in
            // place. Rebuilding it would blank the card for a frame on every
            // keystroke, which reads as flicker while typing.
            const existing = Chart.getChart(canvas);
            if (existing) {
                existing.data.labels = labels;
                existing.data.datasets = datasets;
                // Options are not part of the data, so anything that varies with
                // the search has to be reapplied. Searching turns the split on,
                // and a preserved chart would otherwise keep the legend hidden
                // from whichever state it was first drawn in.
                existing.options.plugins.legend.display = split;
                existing.update("none");
                return;
            }

            new Chart(canvas, {
                type: "bar",
                data: {labels: labels, datasets: datasets},
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    animation: false,
                    scales: {
                        // Stacking is what lets a month read as a total and as
                        // its parts at the same time.
                        x: {
                            stacked: true,
                            border: {display: false},
                            grid: {display: false},
                            ticks: {color: window.budge.ink, maxRotation: 0, autoSkipPadding: 6}
                        },
                        y: {
                            stacked: true,
                            beginAtZero: true,
                            border: {display: false},
                            grid: {color: window.budge.grid},
                            ticks: {
                                color: window.budge.ink,
                                maxTicksLimit: 4,
                                callback: v => "$" + v.toLocaleString()
                            }
                        }
                    },
                    plugins: {
                        legend: {
                            // One band needs no legend to explain itself.
                            display: split,
                            position: "bottom",
                            labels: {
                                color: window.budge.ink,
                                boxWidth: 10,
                                boxHeight: 10,
                                usePointStyle: true,
                                pointStyle: "circle",
                                padding: 12
                            }
                        },
                        tooltip: {
                            callbacks: {
                                label: ctx => ctx.dataset.label + ": $" +
                                    ctx.parsed.y.toLocaleString(undefined, {minimumFractionDigits: 2})
                            }
                        }
                    }
                }
            });
        })();
    </script>

{{ end }}

{{/* Adding one transaction to a memory, in the same words the timeline uses.
     A transaction already in a memory shows which, and can be moved to
     another. Every transaction is drawn twice, as a phone card and a table
     row, so the id carries the layout to keep the two copies apart. */}}
{{ define "transactions.memory" }}
<details class="b-txmem" id="txmem-{{ .Layout }}-{{ .ID }}"{{ if .OOB }} hx-swap-oob="true"{{ end }}>
    <summary class="b-txmem-toggle{{ if .MemoryID }} b-txmem-in{{ end }}"
             title="{{ if .MemoryID }}In “{{ .MemoryTitle }}”{{ else }}Add to memory{{ end }}"
             aria-label="{{ if .MemoryID }}In memory “{{ .MemoryTitle }}”, move to another{{ else }}Add to memory{{ end }}">
        <i class="bi {{ if .MemoryID }}bi-bookmark-check-fill{{ else }}bi-bookmark-plus{{ end }}"></i>
    </summary>
    <form class="b-tl-form b-txmem-form" hx-post="/transactions/{{ .ID }}/memory"
          hx-target="#txmem-{{ .Layout }}-{{ .ID }}" hx-swap="outerHTML">
        <input type="hidden" name="layout" value="{{ .Layout }}">
        <div class="b-txmem-head">
            {{ if .MemoryID }}In “{{ .MemoryTitle }}”. Move to:{{ else }}Add to memory{{ end }}
        </div>
        {{ $current := .MemoryID }}
        {{ if .Options }}
            <select class="form-select form-select-sm b-tl-target" name="memory" aria-label="Which memory">
                <option value="">New memory&hellip;</option>
                {{ range .Options }}
                    {{ if ne .Id $current }}<option value="{{ .Id }}">{{ .Label }}</option>{{ end }}
                {{ end }}
            </select>
        {{ end }}
        <span class="b-tl-new">
            <input class="form-control form-control-sm" name="title"
                   placeholder="Name this memory" aria-label="Memory name">
            <select class="form-select form-select-sm" name="kind" aria-label="What kind of memory">
                {{ range .Kinds }}<option value="{{ .Key }}">{{ .Label }}</option>{{ end }}
            </select>
            <input class="form-control form-control-sm" name="note"
                   placeholder="A note, if you like" aria-label="Note">
        </span>
        <button class="btn btn-sm btn-primary">Save</button>
    </form>
</details>
{{ end }}

{{ define "transactions.category" }}
{{/* The form is fetched when the popover first opens, so a long list does not
     carry the whole category picker on every row. */}}
<details class="b-txmem b-txcat" id="txcat-{{ .Layout }}-{{ .ID }}"{{ if .OOB }} hx-swap-oob="true"{{ end }}
         hx-get="/transactions/{{ .ID }}/category?layout={{ .Layout }}" hx-trigger="toggle once"
         hx-target="find .b-txcat-body" hx-swap="innerHTML">
    <summary class="b-txmem-toggle" title="Categorise" aria-label="Categorise this transaction">
        <i class="bi bi-tag"></i>
    </summary>
    <div class="b-tl-form b-txmem-form b-txcat-body"><span class="text-muted small">Loading…</span></div>
</details>
{{ end }}

{{ define "transactions.category.form" }}
<form class="d-flex flex-wrap gap-2" hx-post="/transactions/{{ .ID }}/category" hx-target="this" hx-swap="none">
    <div class="b-txmem-head">
        {{ if .Specific }}{{ .Broad }} / {{ .Specific }}<span class="fw-normal text-muted"> · from {{ .Source }}</span>{{ else }}Uncategorised{{ end }}
    </div>
    <select class="form-select form-select-sm" name="category" aria-label="File under">
        <option value="">File under…</option>
        {{ range .Groups }}
        <optgroup label="{{ .Broad }}">
            {{ range .Options }}<option value="{{ .Specific }}">{{ .Specific }}</option>{{ end }}
        </optgroup>
        {{ end }}
    </select>
    {{ if .RuleText }}
    <div class="form-check small mb-0" style="flex: 1 1 100%;">
        <input class="form-check-input" type="checkbox" id="txcat-like-{{ .Layout }}-{{ .ID }}" name="scope" value="like">
        <label class="form-check-label" for="txcat-like-{{ .Layout }}-{{ .ID }}">
            All transactions containing “{{ .RuleText }}”, as a rule
        </label>
    </div>
    {{ end }}
    <button class="btn btn-sm btn-primary">Save</button>
    {{ if .Overridden }}
    <button class="btn btn-sm btn-outline-secondary" name="clear" value="1">Undo my change</button>
    {{ end }}
    <a class="small ms-auto align-self-center" href="/settings#categories">Categories &amp; rules</a>
</form>
{{ end }}

{{ define "transactions.category.updated" }}
<div class="b-tx-meta" id="txcats-m-{{ .ID }}" hx-swap-oob="true">
    {{ range .Categories }}<span class="badge-category">{{ . }}</span>{{ end }}
</div>
<span id="txcats-d-{{ .ID }}" hx-swap-oob="true">
    {{ range .Categories }}<span class="badge-category">{{ . }}</span>{{ end }}
</span>
{{ range .Popovers }}{{ template "transactions.category" . }}{{ end }}
{{ end }}

{{ define "transactions.memory.swap" }}{{ range . }}{{ template "transactions.memory" . }}{{ end }}{{ end }}
