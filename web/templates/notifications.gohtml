{{ define "notifications" }}

    <!-- Opening the list is a plain GET; marking read is the POST it fires here,
         so a prefetch cannot silently clear the badge. -->
    <div hx-post="/notifications/read"
         hx-trigger="load"
         hx-swap="none"
         hx-on::after-request="htmx.trigger(document.body, 'notifications')"></div>

    <div class="b-page-head d-flex align-items-start justify-content-between gap-3">
        <div>
            <h2>Notifications</h2>
            <p class="b-page-sub">
                {{ if .Notifications }}
                    What happened while you were not looking.
                {{ else }}
                    Anything that fails in the background turns up here.
                {{ end }}
            </p>
        </div>
        {{ if .Notifications }}
            <button class="btn btn-sm btn-outline-secondary flex-shrink-0"
                    hx-delete="/notifications"
                    hx-target="#main" hx-swap="innerHTML"
                    hx-confirm="Clear every notification?"
                    hx-on::after-request="htmx.trigger(document.body, 'notifications')">
                Clear all
            </button>
        {{ end }}
    </div>

    {{ if .Notifications }}
        <div class="b-card mb-3">
            <ul class="b-acct-list">
                {{ range .Notifications }}
                    <li>
                        {{ template "listRow" (dict "Accent" .Level.Accent "Class" (and .Unread "b-note-unread")
                            "Chip" .Level.Icon "Title" .Title "Message" .Message "Badge" .Source
                            "Meta" (fmtRelative .CreatedAt) "MetaTitle" (.CreatedAt.Format "2 Jan 2006, 3:04pm") "New" .Unread
                            "Remove" (dict "URL" (printf "/notifications/%s" .Id) "Title" "Dismiss"
                                "Label" "Dismiss this notification" "Trigger" "notifications")) }}
                    </li>
                {{ end }}
            </ul>
        </div>
    {{ else }}
        {{ template "empty" (dict "Icon" "bi-bell" "Title" "Nothing to report" "Text" "Sync failures and other background problems will show up here.") }}
    {{ end }}

{{ end }}

{{ define "notifications.badge" }}{{ if gt . 0 }}<span class="b-bell-count">{{ if gt . 9 }}9+{{ else }}{{ . }}{{ end }}</span>{{ end }}{{ end }}
