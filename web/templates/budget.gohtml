{{define "budget"}}
    <div class="b-page-head">
        <h2>Budget</h2>
        <p class="b-page-sub">How spending is tracking against your targets, each measured over its own period.</p>
    </div>

    {{with .SetupData.Tracking}}
    {{/* The headline is per week across every category, but each category is
         measured over the window its frequency implies, so a fortnightly
         payment or a yearly bill does not swing it from week to week. */}}
    <div class="b-card b-card-pad mb-3 b-tracking{{if .IsOver}} b-target-over b-accent-clay{{else}} b-accent-sage{{end}}">
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <span class="b-chip"><i class="bi {{if .IsOver}}bi-exclamation-lg{{else}}bi-check-lg{{end}}"></i></span>
            <div class="min-width-0 flex-grow-1">
                <div class="b-card-title">
                    {{if .Target}}
                    {{.Actual | fmtWhole}} a week against {{.Target | fmtWhole}} of targets
                    {{else}}
                    No targets set yet
                    {{end}}
                </div>
                <div class="b-card-sub">
                    {{if .OverCount}}{{.OverCount}} categor{{if eq .OverCount 1}}y is{{else}}ies are{{end}} over target{{else if .Target}}Every category is within its target{{end}}{{if .GenerousCount}} · {{.GenerousCount}} target{{if ne .GenerousCount 1}}s{{end}} well above spending{{end}}{{if .UntargetedCount}} · {{.UntargetedWeekly | fmtWhole}} a week in {{.UntargetedCount}} categor{{if eq .UntargetedCount 1}}y{{else}}ies{{end}} with no target{{end}}
                </div>
            </div>
            {{if .Target}}
            <div class="b-target-bar b-tracking-bar flex-grow-1" aria-hidden="true">
                <span style="width:{{printf "%.0f" .BarWidth}}%"></span>
            </div>
            {{end}}
        </div>
    </div>
    {{end}}

    <div class="row g-3 mb-3">
        <div class="col-12 col-lg-5">{{template "budget.income.tile" .Income}}</div>
        <!-- Share of take-home pay the targets claim -->
        <div class="col-12 col-lg-7" id="budget-allocation"
             hx-get="/budget/allocation"
             hx-trigger="load, refreshSummary from:body"
             hx-swap="innerHTML"></div>
    </div>

    {{/* Every edit swaps just its row, and then refreshes the allocation bar. */}}
    <div id="budget-setup"
         hx-on::after-request="if (event.detail.successful) { htmx.trigger(document.body, 'refreshSummary') }">
        {{template "budget.setup" .SetupData}}
    </div>
{{end}}

{{define "budget.income"}}
    <div class="b-page-head d-flex align-items-start justify-content-between gap-3">
        <div class="min-width-0">
            <h2>Income</h2>
            <p class="b-page-sub">What you earn and what comes out of it before it reaches your account.</p>
        </div>
        <a href="/budget" class="btn btn-sm btn-outline-secondary flex-shrink-0"
           hx-boost="true" hx-target="#main" aria-label="Back to budget">
            <i class="bi bi-arrow-left"></i>
        </a>
    </div>

    <!-- Income -->
    <div class="b-card b-card-pad mb-3"
         hx-post="/budget/salary"
         hx-trigger="change"
         hx-include="this"
         hx-swap="none"
         hx-on::after-request="if (event.detail.successful) { flashSaved(this); htmx.trigger(document.body, 'refreshSummary') }">
        <h3 class="b-card-title mb-3">
            <i class="bi bi-cash-coin me-2"></i>Income
            <span class="badge-success rounded-pill px-2 ms-2 budge-flash" data-saved-flash aria-live="polite">Saved</span>
        </h3>
        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-5">
                <label class="form-label fw-semibold" for="salaryAmount">Salary</label>
                <div class="input-group">
                    <span class="input-group-text">$</span>
                    <input type="number" name="salary" id="salaryAmount" class="form-control"
                           placeholder="0.00" min="0" step="0.01"
                           {{if gt .Salary.Salary 0.0}}value="{{.Salary.Salary | printf "%.2f"}}"{{end}}>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label fw-semibold" for="salaryFrequency">Frequency</label>
                <select name="salary_frequency" id="salaryFrequency" class="form-select">
                    <option value="yearly"      {{if eq .Salary.SalaryFrequency "yearly"}}selected{{end}}>Yearly</option>
                    <option value="monthly"     {{if eq .Salary.SalaryFrequency "monthly"}}selected{{end}}>Monthly</option>
                    <option value="fortnightly" {{if eq .Salary.SalaryFrequency "fortnightly"}}selected{{end}}>Fortnightly</option>
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label fw-semibold" for="kiwiSaverRate">KiwiSaver</label>
                <select name="kiwisaver_rate" id="kiwiSaverRate" class="form-select">
                    <option value="0"   {{if eq .Salary.KiwiSaverRate 0.0}}selected{{end}}>None</option>
                    <option value="3"   {{if eq .Salary.KiwiSaverRate 3.0}}selected{{end}}>3%</option>
                    <option value="3.5" {{if eq .Salary.KiwiSaverRate 3.5}}selected{{end}}>3.5%</option>
                    <option value="4"   {{if eq .Salary.KiwiSaverRate 4.0}}selected{{end}}>4%</option>
                    <option value="6"   {{if eq .Salary.KiwiSaverRate 6.0}}selected{{end}}>6%</option>
                    <option value="8"   {{if eq .Salary.KiwiSaverRate 8.0}}selected{{end}}>8%</option>
                    <option value="10"  {{if eq .Salary.KiwiSaverRate 10.0}}selected{{end}}>10%</option>
                </select>
            </div>
            <div class="col-12 col-md-2 d-flex align-items-end gap-3 pb-1">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="include_paye" id="includePAYE"
                           {{if .Salary.IncludePAYE}}checked{{end}}>
                    <label class="form-check-label fw-semibold" for="includePAYE">PAYE &amp; ACC</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="student_loan" id="studentLoan"
                           {{if .Salary.StudentLoan}}checked{{end}}>
                    <label class="form-check-label fw-semibold" for="studentLoan">Student Loan</label>
                </div>
            </div>
        </div>
    </div>

    <!-- Income, budgeted expenses and what is left -->
    <div id="budget-cards"
         hx-get="/budget/cards"
         hx-trigger="load, refreshSummary from:body"
         hx-swap="innerHTML"></div>

    <!-- Income breakdown (PAYE / ACC / KiwiSaver detail) -->
    <div id="budget-summary"
         hx-get="/budget/summary"
         hx-trigger="load, refreshSummary from:body"
         hx-swap="innerHTML"></div>
{{end}}

{{define "budget.income.tile"}}
<a href="/budget/income" class="b-card b-card-pad h-100 d-block text-reset text-decoration-none"
   hx-boost="true" hx-target="#main" aria-label="Configure income">
    <div class="d-flex align-items-center justify-content-between gap-3 flex-wrap">
        <div class="d-flex align-items-center gap-2 min-width-0">
            <span class="b-chip b-accent-sage"><i class="bi bi-cash-coin"></i></span>
            <div class="min-width-0">
                <div class="b-card-title">Income</div>
                {{if gt .Salary.Salary 0.0}}
                <div class="b-card-sub">
                    <span class="fw-semibold text-success">{{.Summary.NetWeekly | fmtCurrency}}/wk</span> take-home
                    · {{.Summary.GrossAnnual | fmtCurrency}} gross a year
                    {{if .Deductions}}· {{range $i, $d := .Deductions}}{{if $i}}, {{end}}{{$d}}{{end}}{{end}}
                </div>
                {{else}}
                <div class="b-card-sub">No income set yet. Targets are weighed against take-home pay, so start here.</div>
                {{end}}
            </div>
        </div>
        <span class="btn btn-sm btn-outline-secondary flex-shrink-0">
            Configure <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i>
        </span>
    </div>
</a>
{{end}}

{{define "budget.summary"}}
    <!-- Income Breakdown -->
    <div class="b-card b-card-pad mb-3">
        <h3 class="b-card-title mb-3"><i class="bi bi-graph-up-arrow me-2"></i>Income Breakdown</h3>
        <div class="table-responsive">
            <table class="table table-sm table-borderless mb-0">
                <thead>
                    <tr class="text-muted border-bottom">
                        <th></th>
                        <th class="text-end">Hourly</th>
                        <th class="text-end">Weekly</th>
                        <th class="text-end">Fortnightly</th>
                        <th class="text-end">Monthly</th>
                        <th class="text-end">Annual</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-semibold">Gross Pay</td>
                        <td class="text-end">{{.GrossHourly | fmtCurrency}}</td>
                        <td class="text-end">{{.GrossWeekly | fmtCurrency}}</td>
                        <td class="text-end">{{.GrossFortnightly | fmtCurrency}}</td>
                        <td class="text-end">{{.GrossMonthly | fmtCurrency}}</td>
                        <td class="text-end">{{.GrossAnnual | fmtCurrency}}</td>
                    </tr>
                    {{if gt .PAYEAnnual 0.0}}
                    <tr class="text-danger">
                        <td>PAYE</td>
                        <td class="text-end">−{{.PAYEHourly | fmtCurrency}}</td>
                        <td class="text-end">−{{.PAYEWeekly | fmtCurrency}}</td>
                        <td class="text-end">−{{.PAYEFortnightly | fmtCurrency}}</td>
                        <td class="text-end">−{{.PAYEMonthly | fmtCurrency}}</td>
                        <td class="text-end">−{{.PAYEAnnual | fmtCurrency}}</td>
                    </tr>
                    <tr class="text-danger">
                        <td>ACC</td>
                        <td class="text-end">−{{.ACCHourly | fmtCurrency}}</td>
                        <td class="text-end">−{{.ACCWeekly | fmtCurrency}}</td>
                        <td class="text-end">−{{.ACCFortnightly | fmtCurrency}}</td>
                        <td class="text-end">−{{.ACCMonthly | fmtCurrency}}</td>
                        <td class="text-end">−{{.ACCAnnual | fmtCurrency}}</td>
                    </tr>
                    {{end}}
                    {{if gt .KiwiSaverAnnual 0.0}}
                    <tr class="text-warning">
                        <td>KiwiSaver</td>
                        <td class="text-end">−{{.KiwiSaverHourly | fmtCurrency}}</td>
                        <td class="text-end">−{{.KiwiSaverWeekly | fmtCurrency}}</td>
                        <td class="text-end">−{{.KiwiSaverFortnightly | fmtCurrency}}</td>
                        <td class="text-end">−{{.KiwiSaverMonthly | fmtCurrency}}</td>
                        <td class="text-end">−{{.KiwiSaverAnnual | fmtCurrency}}</td>
                    </tr>
                    {{end}}
                    {{if gt .StudentLoanAnnual 0.0}}
                    <tr class="text-warning">
                        <td>Student Loan</td>
                        <td class="text-end">−{{.StudentLoanHourly | fmtCurrency}}</td>
                        <td class="text-end">−{{.StudentLoanWeekly | fmtCurrency}}</td>
                        <td class="text-end">−{{.StudentLoanFortnight | fmtCurrency}}</td>
                        <td class="text-end">−{{.StudentLoanMonthly | fmtCurrency}}</td>
                        <td class="text-end">−{{.StudentLoanAnnual | fmtCurrency}}</td>
                    </tr>
                    {{end}}
                    <tr class="fw-bold border-top">
                        <td>Take Home Pay</td>
                        <td class="text-end text-success">{{.NetHourly | fmtCurrency}}</td>
                        <td class="text-end text-success">{{.NetWeekly | fmtCurrency}}</td>
                        <td class="text-end text-success">{{.NetFortnightly | fmtCurrency}}</td>
                        <td class="text-end text-success">{{.NetMonthly | fmtCurrency}}</td>
                        <td class="text-end text-success">{{.NetAnnual | fmtCurrency}}</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
{{end}}

{{define "budget.cards"}}
<div class="row g-2 g-md-3 mb-3">
    <div class="col-12 col-md-4">
        <div class="b-stat b-accent-sage">
            <div class="b-stat-label"><span>Net Income</span><i class="bi bi-wallet2"></i></div>
            <div class="b-stat-value text-success">{{.NetWeekly | fmtCurrency}}</div>
            <div class="b-delta-note">Take-home per week</div>
        </div>
    </div>
    <div class="col-6 col-md-4">
        <div class="b-stat b-accent-brick">
            <div class="b-stat-label"><span>Expenses</span><i class="bi bi-bullseye"></i></div>
            <div class="b-stat-value text-danger">{{.TotalWeeklyExpenses | fmtCurrency}}</div>
            <div class="b-delta-note">Budgeted targets</div>
        </div>
    </div>
    <div class="col-6 col-md-4">
        <div class="b-stat {{if .HasDeficit}}b-accent-brick{{else}}b-accent-slate{{end}}">
            <div class="b-stat-label">
                <span>{{if .HasDeficit}}Deficit{{else}}Savings{{end}}</span>
                <i class="bi bi-piggy-bank"></i>
            </div>
            <div class="b-stat-value {{if .HasDeficit}}text-danger{{else}}text-success{{end}}">{{.WeeklySavings | fmtCurrencyAbs}}</div>
            <div class="b-delta-note">{{if .HasDeficit}}Expenses exceed income{{else}}Available after targets{{end}}</div>
        </div>
    </div>
</div>

{{end}}

{{/* Allocation bar — the same three numbers as the cards on the income page. */}}
{{define "budget.allocation"}}
{{if .HasSalary}}
{{/* Sits beside the income tile, so it fills the row's height. */}}
<div class="b-card b-card-pad h-100 d-flex flex-column justify-content-center">
    <div class="d-flex justify-content-between align-items-center mb-1 flex-wrap gap-2">
        <span class="text-muted small">
            <span class="fw-semibold text-body">{{.TotalWeeklyExpenses | fmtCurrency}}</span>
            budgeted of
            <span class="fw-semibold text-body">{{.NetWeekly | fmtCurrency}}</span>
            /wk take-home
        </span>
        <span class="fw-semibold small {{if .IsOverAllocated}}text-danger{{else if gt .WeeklySavings 0.0}}text-success{{else}}text-muted{{end}}">
            {{if .IsOverAllocated}}
                {{.WeeklySavings | fmtCurrencyAbs}} over-allocated
            {{else if gt .WeeklySavings 0.0}}
                {{.WeeklySavings | fmtCurrencyAbs}} unallocated
            {{else}}
                Fully allocated
            {{end}}
        </span>
    </div>
    <div class="progress" style="height:5px;" role="progressbar"
         aria-label="Share of take-home pay allocated to targets"
         aria-valuenow="{{printf "%.0f" .PctAllocatedCss}}" aria-valuemin="0" aria-valuemax="100">
        <div class="progress-bar {{if .IsOverAllocated}}bg-danger{{else}}bg-success{{end}}"
             style="width:{{printf "%.1f" .PctAllocatedCss}}%"></div>
    </div>
</div>
{{end}}
{{end}}

{{define "budget.setup"}}
{{if .HasData}}
    {{range .Sections}}
    <details class="b-card mb-3 b-tsec" data-section="{{.Key}}" {{if .Open}}open{{end}}>
        <summary class="b-tsec-head">
            <span class="b-card-title">
                {{.Title}} <span class="b-tsec-count">{{len .Rows}}</span>
                {{if eq .Key "on-track"}}
                <i class="bi bi-info-circle text-muted ms-1" tabindex="0" data-bs-toggle="tooltip"
                   aria-label="How actual spend is measured"
                   title="Actual spend is averaged over a window matched to each target: the last 4 weeks for weekly targets, 8 for fortnightly, 3 months for monthly and the last 12 months for yearly."></i>
                {{end}}
            </span>
            {{template "budget.setup.section.sum" .}}
            <i class="bi bi-chevron-down b-tsec-chev" aria-hidden="true"></i>
        </summary>
        <div class="b-tsec-body">
            {{range .Rows}}{{template "budget.setup.row" .}}{{end}}
        </div>
    </details>
    {{end}}
{{else}}
    <div class="b-card b-card-pad mb-3">
        <div class="b-empty">
            <i class="bi bi-bank2"></i>
            <h4>No transactions yet</h4>
            <p>Sync your accounts from <a href="/settings">Settings</a> to start setting targets.</p>
        </div>
    </div>
{{end}}

    <!-- Savings goal -->
    <form class="b-card b-card-pad mb-3"
          hx-post="/budget/savings-goal" hx-trigger="change" hx-swap="none">
        <div class="d-flex align-items-end justify-content-between gap-3 flex-wrap">
            <div class="min-width-0">
                <div class="b-card-title"><i class="bi bi-piggy-bank me-2" aria-hidden="true"></i>Savings goal</div>
                {{template "budget.setup.savings.note" .}}
            </div>
            <div class="d-flex gap-2">
                <div class="input-group input-group-sm" style="width:9rem;">
                    <span class="input-group-text">$</span>
                    <input type="number" name="savings_goal" class="form-control text-end"
                           placeholder="Goal" min="0" step="0.01" aria-label="Savings goal amount"
                           {{if .HasSavingsGoal}}value="{{.SavingsGoal | printf "%.2f"}}"{{end}}>
                </div>
                <select name="savings_goal_frequency" class="form-select form-select-sm w-auto" aria-label="Savings goal frequency">
                    <option value="weekly"      {{if or (eq .SavingsGoalFrequency "weekly") (eq .SavingsGoalFrequency "")}}selected{{end}}>Weekly</option>
                    <option value="fortnightly" {{if eq .SavingsGoalFrequency "fortnightly"}}selected{{end}}>Fortnightly</option>
                    <option value="monthly"     {{if eq .SavingsGoalFrequency "monthly"}}selected{{end}}>Monthly</option>
                    <option value="yearly"      {{if eq .SavingsGoalFrequency "yearly"}}selected{{end}}>Yearly</option>
                </select>
            </div>
        </div>
    </form>
{{end}}

{{define "budget.setup.section.sum"}}
<span class="b-card-sub" id="tsec-sum-{{.Key}}"{{if .OOB}} hx-swap-oob="true"{{end}}>
    {{if eq .Key "attention"}}{{.Actual | fmtWhole}} a week{{if .Target}} against {{.Target | fmtWhole}} of targets{{end}}
    {{else if eq .Key "generous"}}{{.Actual | fmtWhole}} a week spent against {{.Target | fmtWhole}} of targets; lowering them frees the rest
    {{else if eq .Key "on-track"}}{{.Actual | fmtWhole}} of {{.Target | fmtWhole}} a week
    {{else if eq .Key "small"}}{{.Actual | fmtWhole}} a week between them, too little to need a target
    {{else}}{{.Actual | fmtWhole}} a week, left out of the budget{{end}}
</span>
{{end}}

{{define "budget.setup.savings.note"}}
<div id="budget-savings-note"{{if .OOB}} hx-swap-oob="true"{{end}}>
    {{/* Income may not be set yet; tracked savings still mean something. */}}
    {{if gt .NetWeekly 0.0}}
    <div class="b-card-sub {{if and .HasSavingsGoal (not .MeetsSavingsGoal)}}text-danger{{end}}">
        {{if lt .Remaining 0.0}}Targets exceed take-home pay by {{.Remaining | fmtWholeAbs}} a week{{else}}{{.Remaining | fmtWhole}} a week left after targets{{end}}{{if and .HasSavingsGoal .MeetsSavingsGoal}}, which meets the goal{{end}}
    </div>
    {{end}}
    {{if gt .TrackedSavingsWeekly 0.0}}
    <div class="b-card-sub">{{.TrackedSavingsWeekly | fmtWhole}} a week already going to savings categories</div>
    {{end}}
</div>
{{end}}

{{define "budget.setup.row.update"}}
{{template "budget.setup.row" .Row}}
{{range .Setup.Sections}}{{template "budget.setup.section.sum" .}}{{end}}
{{template "budget.setup.savings.note" .Setup}}
{{end}}

{{define "budget.setup.row"}}
{{/* Read-only by default: a name, a bar and one figure. Opening the row
     reveals everything that can be changed, so a settled category costs one
     line. Every form here swaps the whole list and names this row to keep
     open, since an edit can move it to another section. */}}
<div class="b-target{{if .IsOver}} b-target-over{{end}}" id="{{.RowID}}">
    <details {{if .Open}}open{{end}}>
        <summary class="b-target-line">
            <span class="b-target-name">
                <span class="fw-semibold">{{.SubCategory}}</span>
                <span class="b-card-sub">{{.BroadCategory}}</span>
            </span>
            {{if .HasTarget}}
            <span class="b-target-bar" aria-hidden="true"><span style="width:{{printf "%.0f" .BarWidth}}%"></span></span>
            <span class="b-target-amount">
                <span class="fw-semibold">{{.ActualDisplay | fmtWhole}}</span> of {{.TargetDisplay | fmtWhole}} {{.Per}}
            </span>
            {{else if .IsSpending}}
            <span class="b-target-amount text-muted">No target · {{.ActualWeekly | fmtWhole}} a week</span>
            {{else}}
            <span class="b-target-amount text-muted">{{.ActualWeekly | fmtWhole}} a week · {{if eq .Kind "savings"}}to savings{{else}}ignored{{end}}</span>
            {{end}}
            <i class="bi bi-chevron-down b-target-chev" aria-hidden="true"></i>
        </summary>

        <div class="b-target-editor">
            {{if .IsSpending}}
            <form class="row g-2 align-items-end mb-3"
                  hx-post="/budget/targets" hx-trigger="change"
                  hx-target="#{{.RowID}}" hx-swap="outerHTML">
                <input type="hidden" name="section" value="{{.Section}}">
                <input type="hidden" name="broad_category" value="{{.BroadCategory}}">
                <input type="hidden" name="sub_category" value="{{.SubCategory}}">
                <div class="col-6 col-md-3">
                    <label class="b-field-label" for="target-{{.RowID}}">Target</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text">$</span>
                        <input type="number" id="target-{{.RowID}}" name="target_amount" class="form-control text-end"
                               placeholder="—" min="0" step="0.01"
                               {{if gt .Target 0.0}}value="{{.Target | printf "%.2f"}}"{{end}}>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <label class="b-field-label" for="frequency-{{.RowID}}">Per</label>
                    <select id="frequency-{{.RowID}}" name="target_frequency" class="form-select form-select-sm"
                            data-prev="{{if .Frequency}}{{.Frequency}}{{else}}weekly{{end}}"
                            title="Changing the frequency converts the amount"
                            onchange="convertTargetFrequency(this)">
                        <option value="weekly"      {{if or (eq .Frequency "weekly") (eq .Frequency "")}}selected{{end}}>Week</option>
                        <option value="fortnightly" {{if eq .Frequency "fortnightly"}}selected{{end}}>Fortnight</option>
                        <option value="monthly"     {{if eq .Frequency "monthly"}}selected{{end}}>Month</option>
                        <option value="yearly"      {{if eq .Frequency "yearly"}}selected{{end}}>Year</option>
                    </select>
                </div>
            </form>
            {{end}}

            <form class="d-flex align-items-center gap-2 flex-wrap mb-2"
                  hx-post="/budget/kind" hx-target="#{{.RowID}}" hx-swap="outerHTML">
                <input type="hidden" name="section" value="{{.Section}}">
                <input type="hidden" name="broad_category" value="{{.BroadCategory}}">
                <input type="hidden" name="sub_category" value="{{.SubCategory}}">
                <span class="b-field-label mb-0">Counts as</span>
                <div class="btn-group btn-group-sm" role="group" aria-label="How {{.SubCategory}} counts">
                    {{$kind := .Kind}}
                    {{range budgetKinds}}
                    <button type="submit" name="kind" value="{{.Value}}"
                            class="btn btn-outline-secondary{{if eq .Value $kind}} active{{end}}"
                            {{if eq .Value $kind}}aria-pressed="true"{{end}}>{{.Label}}</button>
                    {{end}}
                </div>
            </form>

            <div class="b-card-sub">
                Averaged over the last {{.WindowWeeks}} weeks{{if gt .PctOfIncome 0.0}} · target is {{.PctOfIncome | fmtPercent}} of take-home pay{{end}}.
            </div>
            {{if .Merchants}}
            {{/* Each merchant leads to its transactions, where one payment or
                 every one like it can be filed under another category. */}}
            <div class="d-flex flex-wrap gap-1 mt-2">
                {{range .Merchants}}
                <span class="b-merchant">
                    <a href="/transactions?search={{.}}" title="See these transactions, to categorise them">{{.}}</a>
                </span>
                {{end}}
            </div>
            {{end}}
        </div>
    </details>

    {{if .Generous}}
    {{/* A target far above what is spent overstates the budget, so the usual
         answer is one click away. */}}
    <div class="b-target-quick">
        <form hx-post="/budget/targets" hx-target="#{{.RowID}}" hx-swap="outerHTML">
            <input type="hidden" name="section" value="{{.Section}}">
            <input type="hidden" name="broad_category" value="{{.BroadCategory}}">
            <input type="hidden" name="sub_category" value="{{.SubCategory}}">
            <input type="hidden" name="target_amount" value="{{printf "%.0f" .LoweredTarget}}">
            <input type="hidden" name="target_frequency" value="{{if .Frequency}}{{.Frequency}}{{else}}weekly{{end}}">
            <button type="submit" class="btn btn-outline-secondary btn-sm"
                    title="What it has spent, judged over the longer of its own period and the last 13 weeks, plus 10% headroom">
                {{if .LoweredTarget}}Lower to {{.LoweredTarget | fmtWhole}} {{.Per}}{{else}}Remove target, nothing spent{{end}}
            </button>
        </form>
    </div>
    {{end}}

    {{if and .NeedsTarget .SuggestedMonthly}}
    {{/* One click for the usual answers, so clearing unbudgeted spend does
         not mean typing a figure for each category. */}}
    <div class="b-target-quick">
        <form hx-post="/budget/targets" hx-target="#{{.RowID}}" hx-swap="outerHTML">
            <input type="hidden" name="section" value="{{.Section}}">
            <input type="hidden" name="broad_category" value="{{.BroadCategory}}">
            <input type="hidden" name="sub_category" value="{{.SubCategory}}">
            <input type="hidden" name="target_amount" value="{{printf "%.0f" .SuggestedMonthly}}">
            <input type="hidden" name="target_frequency" value="monthly">
            <button type="submit" class="btn btn-outline-secondary btn-sm"
                    title="What it has averaged over the last 13 weeks, rounded up">Use {{.SuggestedMonthly | fmtWhole}} a month</button>
        </form>
        <form class="d-flex gap-2" hx-post="/budget/kind" hx-target="#{{.RowID}}" hx-swap="outerHTML">
            <input type="hidden" name="section" value="{{.Section}}">
            <input type="hidden" name="broad_category" value="{{.BroadCategory}}">
            <input type="hidden" name="sub_category" value="{{.SubCategory}}">
            <button type="submit" name="kind" value="savings" class="btn btn-outline-secondary btn-sm">Savings</button>
            <button type="submit" name="kind" value="ignore" class="btn btn-outline-secondary btn-sm">Ignore</button>
        </form>
    </div>
    {{end}}
</div>
{{end}}
