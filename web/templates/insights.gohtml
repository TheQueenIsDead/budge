{{ define "insights" }}

    <!-- Every link here swaps only #insights-panel. The header and the utilities
         card do not depend on the selected category, so replacing them reflows
         the whole page and moves the viewport out from under whatever was just
         tapped. show:none stops HTMX scrolling after the swap on top of that. -->
    <div hx-boost="true"
         hx-target="#insights-panel"
         hx-select="#insights-panel"
         hx-swap="outerHTML show:none">

        {{ template "pageHead" (dict "Title" "Insights" "Sub" "What the regular things cost, and whether that is moving.") }}

        <div id="insights-panel">

            <!-- Category selector, and the recurring payments after them. -->
            <div class="b-pills">
                {{ range .Groups }}
                    {{ template "pill" (dict "Href" (printf "/insights?group=%s&cadence=%s" .Key .Cadence)
                        "Label" .Label "Icon" .Icon "Accent" .Accent "Active" (eq .Key $.Selected.Key)) }}
                {{ end }}
                {{ template "pill" (dict "Href" "/insights?view=recurring" "Label" "Recurring" "Icon" "bi-arrow-repeat"
                    "Active" (eq .View "recurring")) }}
            </div>

            {{ if eq .View "recurring" }}
                {{ template "insights.recurring" .Recurring }}
            {{ else }}

            <!-- Selected category -->
            <div class="b-card b-card-pad mb-3 b-accent-{{ .Selected.Accent }}">

                <div class="b-card-head flex-wrap">
                    {{ template "cardTitle" (dict "Title" .Selected.Label "Sub" .Selected.Blurb "Chip" .Selected.Icon) }}

                    {{ template "segment" (dict "Items" (list
                        (dict "Href" (printf "/insights?group=%s&cadence=weekly" .Selected.Key) "Label" "Weekly" "Active" (eq .Cadence "weekly"))
                        (dict "Href" (printf "/insights?group=%s&cadence=monthly" .Selected.Key) "Label" "Monthly" "Active" (eq .Cadence "monthly")))) }}
                </div>

                <!-- The three numbers worth knowing: now, last, and typical. -->
                <div class="row g-2 mb-3">
                    <!-- This period and the last open the transactions behind
                         them, as the bars do. -->
                    {{/* The pill under last period's figure is this period against it,
                         so far, which is why it waits while this period is empty. */}}
                    {{ $change := dict "Note" "No history" }}
                    {{ if .Summary.Awaiting }}
                        {{ $change = dict "Note" .Summary.AwaitingLabel "Icon" "bi-hourglass" }}
                    {{ else if .Summary.HasPrevious }}
                        {{ $change = dict "Value" .Summary.Delta "Title" (printf "This %s so far, against the last" .Cadence.Label) }}
                    {{ end }}
                    <div class="col-4">
                        {{ template "stat" (dict "Label" (printf "This %s" .Cadence.Label) "Value" (fmtCurrency .Summary.Current)
                            "Note" (or (and .Summary.Awaiting "nothing yet") "so far")
                            "Href" .CurrentLink "LinkTitle" "See these transactions") }}
                    </div>
                    <div class="col-4">
                        {{ template "stat" (dict "Label" (printf "Last %s" .Cadence.Label) "Value" (fmtCurrency .Summary.Previous)
                            "Delta" $change "Href" .PreviousLink "LinkTitle" "See these transactions") }}
                    </div>
                    <div class="col-4">
                        {{ template "stat" (dict "Label" "Typical" "Value" (fmtCurrency .Summary.Average)
                            "Note" (printf "per %s" .Cadence.Label)) }}
                    </div>
                </div>

                <!-- Fixed height, so the card does not resize while Chart.js sizes
                     its canvas and shove the rest of the page around. -->
                <div class="b-chart">
                    <canvas id="insightsChart" hx-preserve="true"></canvas>
                </div>
                <p class="b-card-sub mt-2 mb-0">
                    {{ .WindowStart.Format "2 Jan 2006" }} to today. The final bar is the
                    {{ .Cadence.Label }} still in progress.
                </p>
            </div>

            <!-- Merchant breakdown. This is what turns "power costs $180" into
                 "power is Mercury", without any manual tagging. Each row opens the
                 transactions behind the number. -->
            <div class="b-card b-card-pad mb-3 b-accent-{{ .Selected.Accent }}">
                {{ template "cardHead" (dict "Title" (printf "%s merchants" .Selected.Label)
                    "Sub" (printf "Who you paid, since %s" (.WindowStart.Format "2 Jan 2006"))) }}

                {{ if .Merchants }}
                    {{ $top := (index .Merchants 0).Total }}
                    <ul class="b-rank">
                        {{ range .Merchants }}
                            <li>
                                <a class="b-rank-item b-rank-link" href="{{ $.MerchantLink .Merchant }}"
                                   hx-boost="false">
                                    <span class="b-chip b-chip-sm fw-bold">{{ slice .Merchant 0 1 }}</span>
                                    <div class="b-rank-body">
                                        <div class="d-flex align-items-baseline justify-content-between gap-2">
                                            <span class="b-rank-name">{{ .Merchant }}</span>
                                            <span class="b-rank-value">{{ .Total | fmtCurrency }}</span>
                                        </div>
                                        <div class="b-rank-track">
                                            <span class="b-rank-fill" style="width: {{ printf "%.1f" (pctOf .Total $top) }}%"></span>
                                        </div>
                                    </div>
                                    <i class="bi bi-chevron-right b-rank-go"></i>
                                </a>
                            </li>
                        {{ end }}
                    </ul>
                {{ else }}
                    {{ template "empty" (dict "Icon" .Selected.Icon "Title" "Nothing here yet"
                        "Text" (printf "No %s spending in this window." .Selected.Label)) }}
                {{ end }}
            </div>

            <script nonce="{{ nonce }}">
                window.budge.afterSwap(function () {
                    const canvas = document.getElementById("insightsChart");
                    if (!canvas || typeof Chart === "undefined") {
                        return;
                    }

                    if (!window.budge) {
                        return;
                    }
                    const key = {{ .Selected.Accent }};
                    const accent = window.budge.colour(key);
                    // The soft token is too pale against a white card, so the
                    // in-progress bar sits between the two.
                    const soft = window.budge.mix(key, 0.45);

                    const labels = {{ .Summary.Labels }};
                    const links = {{ .Links }};
                    const totals = {{ .Summary.Totals }};
                    const label = {{ .Selected.Label }};

                    // The last bucket is still filling up, so it is drawn in the lighter
                    // tint rather than read as a finished period.
                    const colours = totals.map((_, i) => i === totals.length - 1 ? soft : accent);

                    // hx-preserve keeps this canvas across the swap, so the chart
                    // already on it is updated in place. Destroying and rebuilding
                    // blanks the card for a frame, which reads as a flash.
                    const existing = Chart.getChart(canvas);
                    if (existing) {
                        existing.data.labels = labels;
                        existing.data.datasets[0].data = totals;
                        existing.data.datasets[0].backgroundColor = colours;
                        existing.data.datasets[0].label = label;
                        existing.$links = links;
                        existing.update("none");
                        return;
                    }

                    const ink = window.budge.ink;

                    const chart = new Chart(canvas, {
                        type: "bar",
                        data: {
                            labels: labels,
                            datasets: [{
                                label: label,
                                data: totals,
                                backgroundColor: colours,
                                borderRadius: 6,
                                maxBarThickness: 44
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            animation: false,
                            // A bar opens the transactions behind it. The links
                            // are read off the chart, as the canvas is kept
                            // across swaps to another category.
                            onClick: (event, elements) => {
                                if (elements.length) {
                                    window.location.href = chart.$links[elements[0].index];
                                }
                            },
                            onHover: (event, elements) => {
                                event.native.target.style.cursor = elements.length ? "pointer" : "default";
                            },
                            scales: {
                                y: {
                                    beginAtZero: true,
                                    border: {display: false},
                                    grid: {color: window.budge.grid},
                                    ticks: {color: ink, callback: v => "$" + v.toLocaleString()}
                                },
                                x: {
                                    border: {display: false},
                                    grid: {display: false},
                                    ticks: {color: ink, maxRotation: 0, autoSkipPadding: 8}
                                }
                            },
                            plugins: {
                                legend: {display: false},
                                tooltip: {
                                    callbacks: {
                                        // Read the length off the dataset rather than a
                                        // captured array, so this stays correct after an
                                        // in place update swaps the data underneath it.
                                        label: ctx => "$" + ctx.parsed.y.toLocaleString(undefined, {minimumFractionDigits: 2})
                                            + (ctx.dataIndex === ctx.dataset.data.length - 1 ? " so far" : "")
                                    }
                                }
                            }
                        }
                    });
                    chart.$links = links;
                });
            </script>
            {{ end }}
        </div>
    </div>

{{ end }}

{{/* The recurring payments: what they come to, what is due soon, each one
     still going by how often it comes round, and those that have stopped or
     were hidden. Marking one posts from inside the panel, so the panel comes
     back with it moved. */}}
{{ define "insights.recurring" }}
    {{ if .Empty }}
        <div class="b-card b-card-pad mb-3">
            {{ template "empty" (dict "Icon" "bi-arrow-repeat" "Title" "Nothing recurring yet"
                "Text" "Subscriptions and bills turn up here once they have been paid on a regular cadence a few times.") }}
        </div>
    {{ else }}
        <div class="b-card b-card-pad mb-3">
            {{ template "cardHead" (dict "Title" "Recurring payments" "Chip" "bi-arrow-repeat"
                "Sub" "Subscriptions and bills, found by how evenly they are paid.") }}
            <div class="row g-2">
                <div class="col-4">
                    {{ template "stat" (dict "Label" "A year" "Value" (fmtWhole .Yearly) "Note" "estimated") }}
                </div>
                <div class="col-4">
                    {{ template "stat" (dict "Label" "A month" "Value" (fmtWhole .Monthly) "Note" "on average") }}
                </div>
                <div class="col-4">
                    {{ template "stat" (dict "Label" "Active" "Value" .Count "Note" (or (and (eq .Count 1) "payment") "payments")) }}
                </div>
            </div>
        </div>

        {{ if .ComingUp }}
            <!-- A large payment due within the week has a rail, as it is the
                 one worth moving money for. -->
            <div class="b-card mb-3" id="recurring-coming-up">
                {{ template "listHead" (dict "Title" "Coming up" "Chip" "bi-calendar-event" "Total" (fmtCurrency .ComingUpTotal)) }}
                <ul class="b-acct-list">
                    {{ range .ComingUp }}
                        <li>
                            {{ template "listRow" (dict "Accent" .Accent "Class" (and .DueSoon "b-rail")
                                "Chip" .Icon "ChipSm" true "Title" .Name "Link" .Link "LinkTitle" "See these payments"
                                "Meta" (printf "Due %s" .When) "MetaIcon" "bi-calendar"
                                "Figure" (fmtCurrency .Usual) "FigureNote" (and (not .Fixed) "varies")) }}
                        </li>
                    {{ end }}
                </ul>
            </div>
        {{ end }}

        {{ range .Groups }}
            <div class="b-card mb-3" id="recurring-{{ .Cadence.Key }}">
                {{ template "listHead" (dict "Title" .Cadence.Label "Total" (printf "%s a %s" (fmtCurrency .PerPeriod) .Cadence.Noun)) }}
                <ul class="b-acct-list">
                    {{ range .Payments }}
                        <li>
                            {{ $change := "" }}
                            {{ if .PriceChanged }}
                                {{ $change = dict "Value" .Change "Text" (printf "from %s" (fmtCurrency .Previous))
                                    "Title" "Its price changed at the last payment" "Placement" "left" }}
                            {{ end }}
                            {{ template "listRow" (dict "Accent" .Accent "Chip" .Icon "ChipSm" true
                                "Title" .Name "Link" .Link "LinkTitle" "See these payments" "Meta" .Detail "New" .New
                                "Figure" (fmtWhole .Yearly) "FigureNote" "a year" "Delta" $change
                                "Actions" (list
                                    (dict "Post" "/insights/recurring/mark" "Vals" (dict "merchant" .Key "mark" "cancelled")
                                        "Icon" "bi-calendar-x" "Title" "Cancelled: stop expecting it"
                                        "Label" (printf "Mark %s cancelled" .Name))
                                    (dict "Post" "/insights/recurring/mark" "Vals" (dict "merchant" .Key "mark" "not-recurring")
                                        "Icon" "bi-x-lg" "Title" "Not recurring: hide it"
                                        "Label" (printf "Mark %s not recurring" .Name)))) }}
                        </li>
                    {{ end }}
                </ul>
            </div>
        {{ end }}

        {{ template "insights.recurring.folded" (dict "ID" "recurring-stopped" "Title" "Stopped" "Payments" .Stopped
            "Sub" "Gone quiet, or marked cancelled. Not counted.") }}
        {{ template "insights.recurring.folded" (dict "ID" "recurring-hidden" "Title" "Hidden" "Payments" .Hidden
            "Sub" "Marked not recurring. Not counted.") }}
    {{ end }}
{{ end }}

{{/* A folded list of recurring payments set aside, quieter than those
     still going, each with an Undo where the owner set it aside. */}}
{{ define "insights.recurring.folded" }}
    {{ if .Payments }}
        <details class="b-card mb-3 b-tsec" id="{{ .ID }}">
            <summary class="b-tsec-head">
                <span class="b-card-title">{{ .Title }} <span class="b-tsec-count">{{ len .Payments }}</span></span>
                <span class="b-card-sub">{{ .Sub }}</span>
                <i class="bi bi-chevron-down b-tsec-chev" aria-hidden="true"></i>
            </summary>
            <ul class="b-acct-list b-tsec-body">
                {{ range .Payments }}
                    <li>
                        {{ template "listRow" (dict "Chip" .Icon "ChipSm" true "ChipAccent" "muted"
                            "Title" .Name "Link" .Link "LinkTitle" "See these payments" "Meta" .Detail
                            "Figure" (fmtCurrency .Usual) "FigureTone" "text-muted"
                            "Action" (and .Mark (dict "Post" "/insights/recurring/undo" "Vals" (dict "merchant" .Key)
                                "Icon" "bi-arrow-counterclockwise" "Label" "Undo"))) }}
                    </li>
                {{ end }}
            </ul>
        </details>
    {{ end }}
{{ end }}
